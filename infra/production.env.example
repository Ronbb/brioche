# Copy to the repository-root .env only when preparing deployment.
# Set a fresh random alphanumeric secret; URL-encode it if using other characters.
POSTGRES_PASSWORD=replace-with-a-random-secret
# The address users actually visit; external HTTPS also controls Secure cookies.
PUBLIC_APP_URL=http://localhost:30075
# Traefik exposes HTTP on host port 30075. HTTPS is handled outside this stack.

# Initial resource budgets; validate against actual content, load and host capacity.
# Limits apply to running containers, not Docker image builds.
POSTGRES_CPUS=1.0
POSTGRES_MEMORY_LIMIT=512m
POSTGRES_PIDS_LIMIT=128
MIGRATE_CPUS=1.0
MIGRATE_MEMORY_LIMIT=256m
MIGRATE_PIDS_LIMIT=128
API_CPUS=1.0
API_MEMORY_LIMIT=512m
API_PIDS_LIMIT=256
WEB_CPUS=1.0
WEB_MEMORY_LIMIT=384m
WEB_PIDS_LIMIT=128
TRAEFIK_CPUS=0.5
TRAEFIK_MEMORY_LIMIT=256m
TRAEFIK_PIDS_LIMIT=128
