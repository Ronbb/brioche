# Copy to the repository-root .env only when preparing deployment.
# Set a fresh random alphanumeric secret; URL-encode it if using other characters.
POSTGRES_PASSWORD=replace-with-a-random-secret
# The address users actually visit; external HTTPS also controls Secure cookies.
PUBLIC_APP_URL=http://localhost:30075
# Traefik exposes HTTP on host port 30075. HTTPS is handled outside this stack.
