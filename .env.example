# Development without a database uses explicit, unreviewed fixture content.
APP_ENV=development
CONTENT_MODE=fixture
API_BIND=0.0.0.0:3001
INTERNAL_API_URL=http://127.0.0.1:3001
PUBLIC_APP_URL=http://localhost:5173
# Content-addressed visual objects; database mode and publication CLI share this root.
MEDIA_ROOT=.local/media
# Additional explicit LAN browser origins in database mode, comma-separated.
# ADDITIONAL_APP_ORIGINS=http://your-lan-host:5173
# Database mode / migrations: copy your dedicated local connection here.
# DATABASE_URL=postgres://brioche:replace-me@127.0.0.1:5432/brioche
