{
  "schemaVersion": "1.0",
  "id": "a2-travel-tell-weekend",
  "revision": 1,
  "levelId": "a2",
  "unitId": "a2-weekend-travel",
  "title": {
    "fr": "Hier, un petit voyage",
    "zh": "讲述一次周末出行"
  },
  "summaryZh": "Camille 用简短消息回顾旅行，区分做过与没做的事。",
  "estimatedMinutes": 16,
  "objectivesZh": [
    "识别已经完成的旅行活动",
    "用 avoir 加过去分词叙述经历",
    "把复合过去时改成否定"
  ],
  "knowledge": {
    "vocabulary": [
      {
        "id": "word-passer-sejour",
        "lemma": "passer",
        "partOfSpeech": "verb",
        "meaningZh": "度过",
        "noteZh": "本课 passer un week-end 是带直接宾语的用法，复合过去时用 avoir：j’ai passé。"
      },
      {
        "id": "word-visiter",
        "lemma": "visiter",
        "partOfSpeech": "verb",
        "meaningZh": "参观",
        "noteZh": "本单元表示参观城市或场所，不用于直接表达拜访朋友。"
      },
      {
        "id": "word-regarder",
        "lemma": "regarder",
        "partOfSpeech": "verb",
        "meaningZh": "看；观看",
        "noteZh": "nous avons regardé 是复合过去时。"
      },
      {
        "id": "word-prendre-voyage",
        "lemma": "prendre",
        "partOfSpeech": "verb",
        "meaningZh": "乘坐；拿取",
        "noteZh": "本课 j’ai pris le train 表示乘火车，pris 是过去分词。"
      },
      {
        "id": "word-photo",
        "lemma": "photo",
        "partOfSpeech": "noun",
        "meaningZh": "照片",
        "noteZh": "搭配冠词学习 photo。",
        "gender": "feminine"
      },
      {
        "id": "word-souvenir",
        "lemma": "souvenir",
        "partOfSpeech": "noun",
        "meaningZh": "纪念品；回忆",
        "noteZh": "本课 acheter des souvenirs 表示购买纪念品。",
        "gender": "masculine"
      },
      {
        "id": "word-hier",
        "lemma": "hier",
        "partOfSpeech": "adverb",
        "meaningZh": "昨天",
        "noteZh": "以说话日为参照。"
      },
      {
        "id": "word-finalement",
        "lemma": "finalement",
        "partOfSpeech": "adverb",
        "meaningZh": "最后；最终",
        "noteZh": "本课总结实际完成的旅行体验。"
      }
    ],
    "grammar": [
      {
        "id": "grammar-a2-passe-compose-avoir",
        "titleZh": "复合过去时入门：avoir + 过去分词",
        "bodyZh": "本课 j’ai visité、nous avons regardé 用 avoir 的现在时加过去分词，讲述已经完成的活动。第一组动词如 visiter 的过去分词常以 -é 结尾；prendre → pris、faire → fait 需另记。复合过去时也可用 être 作助动词，不能把所有动词都套用 avoir。",
        "examples": [
          {
            "fr": "J’ai visité un musée.",
            "zh": "我参观了一家博物馆。"
          }
        ]
      },
      {
        "id": "grammar-a2-past-negation",
        "titleZh": "ne…pas 围住助动词",
        "bodyZh": "复合过去时的否定把 ne…pas 放在助动词两边：nous n’avons pas acheté。元音前 ne 省音为 n’；过去分词 acheté 留在 pas 后。本课用完整书面形式。",
        "examples": [
          {
            "fr": "Nous n’avons pas acheté de souvenirs.",
            "zh": "我们没有买纪念品。"
          }
        ]
      }
    ]
  },
  "blocks": [
    {
      "id": "scene-main",
      "type": "scene",
      "placeZh": "旅行后写给朋友的消息",
      "situationZh": "Camille 用简短消息回顾旅行，区分做过与没做的事。",
      "illustrationId": "art-city-morning"
    },
    {
      "id": "article-main",
      "type": "article",
      "titleZh": "讲述一次周末出行",
      "narratorId": "character-camille",
      "paragraphs": [
        {
          "id": "entry-1",
          "segments": [
            {
              "id": "segment-1-1",
              "text": "Hier",
              "vocabularyId": "word-hier"
            },
            {
              "id": "segment-1-2",
              "text": ", j’ai "
            },
            {
              "id": "segment-1-3",
              "text": "passé",
              "vocabularyId": "word-passer-sejour"
            },
            {
              "id": "segment-1-4",
              "text": " une journée à Lyon avec Léa. J’ai "
            },
            {
              "id": "segment-1-5",
              "text": "pris",
              "vocabularyId": "word-prendre-voyage"
            },
            {
              "id": "segment-1-6",
              "text": " le train le matin et j’ai retrouvé mon amie devant la gare."
            }
          ],
          "translationZh": "昨天，我和 Léa 在里昂度过了一天。我早晨乘火车，在车站前见到了朋友。"
        },
        {
          "id": "entry-2",
          "segments": [
            {
              "id": "segment-2-1",
              "text": "D’abord, nous "
            },
            {
              "id": "segment-2-2",
              "text": "avons visité",
              "vocabularyId": "word-visiter",
              "grammarId": "grammar-a2-passe-compose-avoir"
            },
            {
              "id": "segment-2-3",
              "text": " un petit musée près du centre. Nous avons "
            },
            {
              "id": "segment-2-4",
              "text": "regardé",
              "vocabularyId": "word-regarder"
            },
            {
              "id": "segment-2-5",
              "text": " des peintures et parlé de nos tableaux préférés dans une salle calme."
            }
          ],
          "translationZh": "首先，我们参观了市中心附近的一家小博物馆。我们看了绘画作品，并在一间安静的展厅谈论各自最喜欢的画。"
        },
        {
          "id": "entry-3",
          "segments": [
            {
              "id": "segment-3-1",
              "text": "Ensuite, nous avons déjeuné dans un café. J’ai choisi une soupe et Léa a commandé une salade. Nous avons pris le temps de discuter."
            }
          ],
          "translationZh": "然后，我们在一家咖啡馆吃午饭。我选了汤，Léa 点了沙拉。我们慢慢聊了聊。"
        },
        {
          "id": "entry-4",
          "segments": [
            {
              "id": "segment-4-1",
              "text": "L’après-midi, nous avons fait une promenade dans un parc. J’ai pris quelques "
            },
            {
              "id": "segment-4-2",
              "text": "photos",
              "vocabularyId": "word-photo"
            },
            {
              "id": "segment-4-3",
              "text": " des arbres et Léa a envoyé une photo à Luc."
            }
          ],
          "translationZh": "下午，我们在公园散了步。我拍了几张树木的照片，Léa 给 Luc 发了一张照片。"
        },
        {
          "id": "entry-5",
          "segments": [
            {
              "id": "segment-5-1",
              "text": "Nous "
            },
            {
              "id": "segment-5-2",
              "text": "n’avons pas acheté",
              "grammarId": "grammar-a2-past-negation"
            },
            {
              "id": "segment-5-3",
              "text": " de "
            },
            {
              "id": "segment-5-4",
              "text": "souvenirs",
              "vocabularyId": "word-souvenir"
            },
            {
              "id": "segment-5-5",
              "text": ", parce que nous avons préféré garder du temps pour marcher. Nous avons simplement regardé les vitrines sur le chemin."
            }
          ],
          "translationZh": "我们没有买纪念品，因为更愿意把时间留给步行。我们只是在路上看了看橱窗。"
        },
        {
          "id": "entry-6",
          "segments": [
            {
              "id": "segment-6-1",
              "text": "Avant le retour, nous avons vérifié les horaires sur l’écran de la gare. Nous avons trouvé notre quai et attendu le train ensemble, avec nos sacs."
            }
          ],
          "translationZh": "返程前，我们核对了车站屏幕上的时刻。我们找到了站台，带着包一起等车。"
        },
        {
          "id": "entry-7",
          "segments": [
            {
              "id": "segment-7-1",
              "text": "Finalement",
              "vocabularyId": "word-finalement"
            },
            {
              "id": "segment-7-2",
              "text": ", j’ai passé une journée agréable sans programme compliqué. Aujourd’hui, je vais envoyer mes photos à Léa et écrire quelques mots pour raconter cette sortie."
            }
          ],
          "translationZh": "最后，我度过了没有复杂安排的愉快一天。今天，我打算把照片发给 Léa，再写几句话讲述这次出游。"
        }
      ]
    },
    {
      "id": "explanation-main",
      "type": "explanation",
      "titleZh": "这句话如何使用",
      "bodyZh": "j’ai passé une journée 中 passer 带宾语，使用 avoir；不能由此推断它所有用法都用 avoir。avons visité、avons regardé 是已完成活动，pris、fait 是不规则过去分词。nous n’avons pas acheté 把否定放在助动词周围；正文 de souvenirs 也体现一般数量宾语否定后的 de，后续再系统练习。结尾 je vais envoyer 是今天的计划，与昨天的经历区分。",
      "targets": [
        {
          "blockId": "article-main",
          "entryId": "entry-2",
          "segmentId": "segment-2-2"
        },
        {
          "blockId": "article-main",
          "entryId": "entry-5",
          "segmentId": "segment-5-2"
        }
      ]
    },
    {
      "id": "culture-context",
      "type": "culture",
      "titleZh": "场景中的细节",
      "bodyZh": "本课只讲述虚构人物的一次体验，不概括里昂景点、博物馆规则或旅行方式；日程、地点和选择不是旅游建议。",
      "scopeZh": "本课虚构场景，不概括所有法语地区或个人的行为。"
    },
