  "unitId": "a2-weekend-travel",
  "title": {
    "fr": "Un week-end à Lyon",
    "zh": "安排一个周末"
  },
  "summaryZh": "读 Camille 写给朋友的周末计划，整理活动顺序和准备事项。",
  "estimatedMinutes": 16,
  "objectivesZh": [
    "识别周末计划与行程顺序",
    "用近期将来表达打算",
    "区分活动安排和准备事项"
  ],
  "knowledge": {
    "vocabulary": [
      {
