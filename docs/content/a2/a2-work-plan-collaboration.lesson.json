    {
      "id": "exercise-comprehension",
      "type": "exercise",
      "exerciseType": "single-choice",
      "promptZh": "谁负责准备文字？",
      "options": [
        {
          "id": "distractor-a",
          "text": "Luc"
        },
        {
          "id": "correct",
          "text": "Camille"
        },
        {
          "id": "distractor-b",
          "text": "还没有分配"
        }
      ]
    },
    {
      "id": "exercise-fill",
      "type": "exercise",
      "exerciseType": "fill-blank",
      "promptZh": "根据提示补全句子。",
      "templateFr": "Si tu ___ les images, nous pouvons les vérifier.",
      "hintZh": "terminer 搭配 tu 的现在时为 termines；条件从句使用现在时。"
    },
    {
      "id": "exercise-order",
      "type": "exercise",
      "exerciseType": "order",
      "promptZh": "把语块排成一句日常表达。",
      "tokens": [
        {
          "id": "token-3",
          "text": "le relire ensemble."
        },
        {
          "id": "token-1",
          "text": "Si tu termines le texte,"
        },
        {
          "id": "token-2",
          "text": "nous pouvons"
        }
      ]
    },
    {
      "id": "habit-main",
      "type": "habit",
      "taskZh": "给两个虚构成员分配任务，再写一句 si 引出的协作条件。",
      "alternativeZh": "也可以只在心里构思或写一句虚构信息，不需要提供现实行为证明。"
    },
    {
      "id": "summary-main",
      "type": "summary",
      "takeawaysZh": [
        "我能商量任务分工。",
        "我能用 si 表达一个可能条件。",
        "我能用近期将来说明计划。"
      ]
    }
  ],
