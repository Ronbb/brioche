{
  "schemaVersion": "1.0",
  "id": "a2-travel-book-room",
  "revision": 1,
  "levelId": "a2",
  "unitId": "a2-weekend-travel",
  "title": {
    "fr": "Une chambre pour deux nuits",
    "zh": "询问两晚住宿"
  },
  "summaryZh": "确认入住日期、晚数、早餐和总价，再请求书面确认。",
  "estimatedMinutes": 16,
  "objectivesZh": [
    "说明入住和离店日期",
    "询问早餐是否包含",
    "核对晚数与总价"
  ],
  "knowledge": {
    "vocabulary": [
      {
        "id": "word-reserver",
        "lemma": "réserver",
        "partOfSpeech": "verb",
        "meaningZh": "预订",
        "noteZh": "本单元 réserver une chambre 表示预订客房。"
      },
      {
        "id": "word-chambre",
        "lemma": "chambre",
        "partOfSpeech": "noun",
        "meaningZh": "卧室；房间",
        "noteZh": "chambre 的单数形式；搭配冠词学习。",
        "gender": "feminine"
      },
      {
        "id": "word-nuit",
        "lemma": "nuit",
        "partOfSpeech": "noun",
        "meaningZh": "夜晚；一晚住宿",
        "noteZh": "搭配冠词学习 nuit。",
        "gender": "feminine"
      },
      {
        "id": "word-petit-dejeuner",
        "lemma": "petit-déjeuner",
        "partOfSpeech": "noun",
        "meaningZh": "早餐",
        "noteZh": "搭配冠词学习 petit-déjeuner。",
        "gender": "masculine"
      },
      {
        "id": "word-compris",
        "lemma": "compris",
        "partOfSpeech": "adjective",
        "meaningZh": "包含在内的",
        "noteZh": "在 le petit-déjeuner est compris 中与阳性单数主语配合。"
      },
      {
        "id": "word-confirmation",
        "lemma": "confirmation",
        "partOfSpeech": "noun",
        "meaningZh": "确认信息",
        "noteZh": "搭配冠词学习 confirmation。",
        "gender": "feminine"
      },
      {
        "id": "word-juin",
        "lemma": "juin",
        "partOfSpeech": "noun",
        "meaningZh": "六月",
        "noteZh": "月份名称通常小写；本课日期没有指定年份。",
        "gender": "masculine"
      },
      {
        "id": "expr-par-nuit",
        "lemma": "par nuit",
        "partOfSpeech": "phrase",
        "meaningZh": "每晚",
        "noteZh": "住宿价格的计费单位，最终费用需结合具体预订条件确认。"
      }
    ],
    "grammar": [
      {
        "id": "grammar-a2-stay-dates",
        "titleZh": "du…au…：说明日期区间",
        "bodyZh": "du 是 de + le 的缩合，au 是 à + le 的缩合。du 12 au 14 juin 在本课表示 6 月 12 日入住、14 日离店；住宿晚数要结合入住和离店日期确认。",
        "examples": [
          {
            "fr": "Une chambre du 12 au 14 juin.",
            "zh": "6 月 12 日至 14 日的一间客房。"
          }
        ]
      },
      {
        "id": "grammar-a2-est-ce-que",
        "titleZh": "Est-ce que：询问信息",
        "bodyZh": "est-ce que 放在陈述语序前构成一般疑问句；元音前 que 省音为 qu’。它不表示否定，也不改变后面动词的时态。",
        "examples": [
          {
            "fr": "Est-ce que le petit-déjeuner est compris ?",
            "zh": "早餐包含在内吗？"
          }
        ]
      }
    ]
  },
  "blocks": [
    {
      "id": "scene-main",
      "type": "scene",
      "placeZh": "虚构酒店的预订电话",
      "situationZh": "确认入住日期、晚数、早餐和总价，再请求书面确认。",
      "illustrationId": "art-city-morning"
    },
    {
      "id": "dialogue-main",
      "type": "dialogue",
      "titleZh": "询问两晚住宿",
      "speakers": [
        {
          "id": "speaker-1",
          "labelZh": "预订住宿的旅客",
          "characterId": "character-camille",
          "displayName": "Camille",
          "avatarId": "avatar-camille-v1"
        },
        {
          "id": "speaker-2",
          "labelZh": "酒店接待员",
          "characterId": "character-luc",
          "displayName": "Luc",
          "avatarId": "avatar-luc-v1"
        }
      ],
      "turns": [
        {
          "id": "entry-1",
          "speakerId": "speaker-1",
          "segments": [
            {
              "id": "segment-1-1",
              "text": "Bonjour, je voudrais "
            },
            {
              "id": "segment-1-2",
              "text": "réserver",
              "vocabularyId": "word-reserver"
            },
            {
              "id": "segment-1-3",
              "text": " une chambre pour deux personnes, "
            },
            {
              "id": "segment-1-4",
              "text": "du 12 au 14 juin",
              "grammarId": "grammar-a2-stay-dates"
            },
            {
              "id": "segment-1-5",
              "text": ". Avez-vous encore une chambre disponible ?"
            }
          ],
          "translationZh": "您好，我想预订一间两人客房，6 月 12 日至 14 日。还有空房吗？"
        },
        {
          "id": "entry-2",
          "speakerId": "speaker-2",
          "segments": [
            {
              "id": "segment-2-1",
              "text": "Bonjour. Oui, nous avons une "
            },
            {
              "id": "segment-2-2",
              "text": "chambre",
              "vocabularyId": "word-chambre"
            },
            {
              "id": "segment-2-3",
              "text": " avec deux lits. Vous arrivez le vendredi 12 et vous partez le dimanche 14, c’est bien cela ?"
            }
          ],
          "translationZh": "您好。是的，我们有一间双床房。您星期五 12 日入住、星期日 14 日离店，对吗？"
        },
        {
          "id": "entry-3",
          "speakerId": "speaker-1",
          "segments": [
            {
              "id": "segment-3-1",
              "text": "Oui, c’est cela. Nous allons passer deux "
            },
            {
              "id": "segment-3-2",
              "text": "nuits",
              "vocabularyId": "word-nuit"
            },
            {
              "id": "segment-3-3",
              "text": " chez vous. "
            },
            {
              "id": "segment-3-4",
              "text": "Est-ce que",
              "grammarId": "grammar-a2-est-ce-que"
            },
            {
              "id": "segment-3-5",
              "text": " le "
            },
            {
              "id": "segment-3-6",
              "text": "petit-déjeuner",
              "vocabularyId": "word-petit-dejeuner"
            },
            {
              "id": "segment-3-7",
              "text": " est "
            },
            {
              "id": "segment-3-8",
              "text": "compris",
              "vocabularyId": "word-compris"
            },
            {
              "id": "segment-3-9",
              "text": " dans le prix ?"
            }
          ],
          "translationZh": "是的。我们会在贵酒店住两晚。价格包含早餐吗？"
        },
        {
          "id": "entry-4",
          "speakerId": "speaker-2",
          "segments": [
            {
              "id": "segment-4-1",
              "text": "Le petit-déjeuner est compris. La chambre coûte quatre-vingts euros "
            },
            {
              "id": "segment-4-2",
              "text": "par nuit",
              "vocabularyId": "expr-par-nuit"
            },
            {
              "id": "segment-4-3",
              "text": ", soit cent soixante euros pour les deux nuits."
            }
          ],
          "translationZh": "早餐包含在内。客房每晚八十欧元，两晚共一百六十欧元。"
        },
        {
          "id": "entry-5",
          "speakerId": "speaker-1",
          "segments": [
            {
              "id": "segment-5-1",
              "text": "Très bien. Nous allons arriver vers dix-huit heures. Est-ce que la réception est ouverte à cette heure-là ?"
            }
          ],
          "translationZh": "很好。我们预计十八点左右到达。接待处那时候营业吗？"
        },
        {
          "id": "entry-6",
          "speakerId": "speaker-2",
          "segments": [
            {
              "id": "segment-6-1",
              "text": "Oui, la réception est ouverte. Pour terminer la réservation, pouvez-vous me donner votre nom et une adresse électronique ?"
            }
          ],
          "translationZh": "是的，接待处营业。为了完成预订，可以告诉我您的姓名和电子邮箱地址吗？"
        },
        {
          "id": "entry-7",
          "speakerId": "speaker-1",
          "segments": [
            {
              "id": "segment-7-1",
              "text": "Je m’appelle Camille. Je vais vous envoyer mon adresse par message. Pouvez-vous envoyer une "
            },
            {
              "id": "segment-7-2",
              "text": "confirmation",
              "vocabularyId": "word-confirmation"
            },
            {
              "id": "segment-7-3",
              "text": " avec les dates et le prix ?"
            }
          ],
          "translationZh": "我叫 Camille。我会用消息把邮箱地址发给您。您能发送包含日期和价格的确认信息吗？"
        },
        {
          "id": "entry-8",
          "speakerId": "speaker-2",
          "segments": [
            {
              "id": "segment-8-1",
              "text": "Bien sûr. Vous allez recevoir la confirmation aujourd’hui. Vérifiez les informations dans le message et contactez-nous si quelque chose ne correspond pas."
            }
          ],
          "translationZh": "当然。您今天会收到确认信息。请核对消息里的信息，如有不一致请联系我们。"
        }
      ]
    },
    {
      "id": "explanation-main",
      "type": "explanation",
      "titleZh": "这句话如何使用",
      "bodyZh": "du 12 au 14 juin 本场景明确为 12 日入住、14 日离店，因此是两晚。Est-ce que 引出是否包含早餐、接待处是否营业的问句。日期未指定年份，正文星期五至星期日是虚构日历设定，不能套用某个真实年份。",
      "targets": [
        {
          "blockId": "dialogue-main",
          "entryId": "entry-1",
          "segmentId": "segment-1-4"
        },
        {
          "blockId": "dialogue-main",
          "entryId": "entry-3",
          "segmentId": "segment-3-4"
        }
      ]
    },
    {
      "id": "culture-context",
      "type": "culture",
      "titleZh": "场景中的细节",
      "bodyZh": "每晚八十欧元和早餐包含是虚构酒店对本次询问的报价，不代表市场价格、税费规则、取消政策或所有酒店服务。真实预订须核对完整条款。",
      "scopeZh": "本课虚构场景，不概括所有法语地区或个人的行为。"
    },
    {
      "id": "vocabulary-targets",
      "type": "vocabulary",
      "entryIds": [
        "word-reserver",
        "word-chambre",
        "word-nuit",
        "word-petit-dejeuner",
        "word-compris",
        "word-confirmation",
        "word-juin",
        "expr-par-nuit"
      ]
    },
    {
      "id": "grammar-targets",
      "type": "grammar",
      "entryIds": [
        "grammar-a2-stay-dates",
        "grammar-a2-est-ce-que"
      ]
    },
    {
      "id": "exercise-comprehension",
      "type": "exercise",
      "exerciseType": "single-choice",
      "promptZh": "接待员给出的两晚总价是多少？",
      "options": [
        {
          "id": "distractor-a",
          "text": "八十欧元"
        },
        {
          "id": "correct",
          "text": "一百六十欧元"
        },
        {
          "id": "distractor-b",
          "text": "二百四十欧元"
        }
      ]
    },
    {
      "id": "exercise-fill",
      "type": "exercise",
      "exerciseType": "fill-blank",
      "promptZh": "根据提示补全句子。",
      "templateFr": "Est-ce ___ le petit-déjeuner est compris ?",
      "hintZh": "est-ce que 后接陈述语序；这里 petit-déjeuner 是阳性单数。"
    },
    {
      "id": "exercise-order",
      "type": "exercise",
      "exerciseType": "order",
      "promptZh": "把语块排成一句日常表达。",
      "tokens": [
        {
          "id": "token-3",
          "text": "pour deux nuits."
        },
        {
          "id": "token-1",
          "text": "Je voudrais réserver"
        },
        {
          "id": "token-2",
          "text": "une chambre"
        }
      ]
    },
    {
      "id": "habit-main",
      "type": "habit",
      "taskZh": "给虚构酒店写一句预订请求，再问一个需要确认的问题。",
      "alternativeZh": "也可以只在心里构思或写一句虚构信息，不需要提供现实行为证明。"
    },
    {
      "id": "summary-main",
      "type": "summary",
      "takeawaysZh": [
        "我能说明入住和离店日期。",
        "我能询问早餐是否包含。",
        "我能核对晚数与总价。"
      ]
    }
  ],
