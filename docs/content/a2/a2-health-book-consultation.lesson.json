{
  "schemaVersion": "1.0",
  "id": "a2-health-book-consultation",
  "revision": 1,
  "levelId": "a2",
  "unitId": "a2-body-wellbeing",
  "title": {
    "fr": "Un rendez-vous pour une consultation",
    "zh": "预约就诊并确认信息"
  },
  "summaryZh": "用礼貌问句确认预约时刻、地点和接收确认的方式。",
  "estimatedMinutes": 16,
  "objectivesZh": [
    "表达预约就诊的请求",
    "询问可用时刻",
    "核对地点和预约确认"
  ],
  "knowledge": {
    "vocabulary": [
      {
        "id": "word-rendez-vous",
        "lemma": "rendez-vous",
        "partOfSpeech": "noun",
        "meaningZh": "约见；预约",
        "noteZh": "le rendez-vous；本课表示朋友约好的见面。",
        "gender": "masculine"
      },
      {
        "id": "word-medecin",
        "lemma": "médecin",
        "partOfSpeech": "noun",
        "meaningZh": "医生",
        "noteZh": "本课 un médecin 为男性医生；实际称谓与个人情况另行确认。",
        "gender": "masculine"
      },
      {
        "id": "word-consultation",
        "lemma": "consultation",
        "partOfSpeech": "noun",
        "meaningZh": "就诊；咨询",
        "noteZh": "搭配冠词学习 consultation。",
        "gender": "feminine"
      },
      {
        "id": "word-disponible",
        "lemma": "disponible",
        "partOfSpeech": "adjective",
        "meaningZh": "可用的；有空的",
        "noteZh": "本课指可安排的时间。"
      },
      {
        "id": "word-date",
        "lemma": "date",
        "partOfSpeech": "noun",
        "meaningZh": "日期",
        "noteZh": "搭配冠词学习 date。",
        "gender": "feminine"
      },
      {
        "id": "word-annuler",
        "lemma": "annuler",
        "partOfSpeech": "verb",
        "meaningZh": "取消",
        "noteZh": "annuler un rendez-vous 表示取消预约。"
      },
      {
        "id": "word-confirmer",
        "lemma": "confirmer",
        "partOfSpeech": "verb",
        "meaningZh": "确认",
        "noteZh": "confirmer un rendez-vous 表示确认预约。"
      },
      {
        "id": "word-heure",
        "lemma": "heure",
        "partOfSpeech": "noun",
        "meaningZh": "小时；时刻",
        "noteZh": "neuf heures dix 表示九点十分。",
        "gender": "feminine"
      }
    ],
    "grammar": [
      {
        "id": "grammar-a2-pouvoir-service-request",
        "titleZh": "Pouvez-vous + 原形：请求服务",
        "bodyZh": "vous 搭配 pouvoir 的现在时 pouvez。Pouvez-vous 接动词原形，用倒装问句礼貌请求对方做某事。pouvoir 没有命令式；本课不把 pouvez 当作命令式。",
        "examples": [
          {
            "fr": "Pouvez-vous confirmer la date ?",
            "zh": "您能确认日期吗？"
          }
        ]
      },
      {
        "id": "grammar-a2-est-ce-que",
        "titleZh": "Est-ce que：询问信息",
        "bodyZh": "est-ce que 放在陈述语序前构成一般疑问句；元音前 que 省音为 qu’。它不表示否定，也不改变后面动词的时态。",
        "examples": [
          {
            "fr": "Est-ce que le petit-déjeuner est compris ?",
            "zh": "早餐包含在内吗？"
          }
        ]
      }
    ]
  },
  "blocks": [
    {
      "id": "scene-main",
      "type": "scene",
      "placeZh": "虚构诊所的预约电话",
      "situationZh": "用礼貌问句确认预约时刻、地点和接收确认的方式。",
      "illustrationId": "art-clinic-reception"
    },
    {
      "id": "dialogue-main",
      "type": "dialogue",
      "titleZh": "预约就诊并确认信息",
      "speakers": [
        {
          "id": "speaker-1",
          "labelZh": "预约者 Camille",
          "characterId": "character-camille",
          "displayName": "Camille",
          "avatarId": "avatar-camille-v1"
        },
        {
          "id": "speaker-2",
          "labelZh": "接待员 Luc",
          "characterId": "character-luc",
          "displayName": "Luc",
          "avatarId": "avatar-luc-v1"
        }
      ],
      "turns": [
        {
          "id": "entry-1",
          "speakerId": "speaker-1",
          "segments": [
            {
              "id": "segment-1-1",
              "text": "Bonjour, je voudrais prendre un "
            },
            {
              "id": "segment-1-2",
              "text": "rendez-vous",
              "vocabularyId": "word-rendez-vous"
            },
            {
              "id": "segment-1-3",
              "text": " pour une "
            },
            {
              "id": "segment-1-4",
              "text": "consultation",
              "vocabularyId": "word-consultation"
            },
            {
              "id": "segment-1-5",
              "text": " avec un "
            },
            {
              "id": "segment-1-6",
              "text": "médecin",
              "vocabularyId": "word-medecin"
            },
            {
              "id": "segment-1-7",
              "text": ". "
            },
            {
              "id": "segment-1-8",
              "text": "Pouvez-vous",
              "grammarId": "grammar-a2-pouvoir-service-request"
            },
            {
              "id": "segment-1-9",
              "text": " me dire quels moments sont disponibles pour les rendez-vous proposés par le cabinet ?"
            }
          ],
          "translationZh": "您好，我想预约医生就诊。您能告诉我诊所提供的预约有哪些可用时段吗？"
        },
        {
          "id": "entry-2",
          "speakerId": "speaker-2",
          "segments": [
            {
              "id": "segment-2-1",
              "text": "Bonjour. Pour les rendez-vous de cet exemple, nous proposons demain à dix "
            },
            {
              "id": "segment-2-2",
              "text": "heure",
              "vocabularyId": "word-heure"
            },
            {
              "id": "segment-2-3",
              "text": "s ou à quinze heures. Quelle heure souhaitez-vous noter pour votre consultation ?"
            }
          ],
          "translationZh": "您好。这个例子的预约有明天十点或十五点。您想把哪个时刻记为就诊时间？"
        },
        {
          "id": "entry-3",
          "speakerId": "speaker-1",
          "segments": [
            {
              "id": "segment-3-1",
              "text": "Quinze heures me convient. "
            },
            {
              "id": "segment-3-2",
              "text": "Est-ce que",
              "grammarId": "grammar-a2-est-ce-que"
            },
            {
              "id": "segment-3-3",
              "text": " ce moment est encore "
            },
            {
              "id": "segment-3-4",
              "text": "disponible",
              "vocabularyId": "word-disponible"
            },
            {
              "id": "segment-3-5",
              "text": " ? Je voudrais aussi "
            },
            {
              "id": "segment-3-6",
              "text": "confirmer",
              "vocabularyId": "word-confirmer"
            },
            {
              "id": "segment-3-7",
              "text": " l’adresse, car je ne suis jamais venue dans ce cabinet."
            }
          ],
          "translationZh": "十五点适合我。这个时段还有空位吗？我还想确认地址，因为没来过这家诊所。"
        },
        {
          "id": "entry-4",
          "speakerId": "speaker-2",
          "segments": [
            {
              "id": "segment-4-1",
              "text": "Oui, le rendez-vous est disponible. Je vais vous envoyer la "
            },
            {
              "id": "segment-4-2",
              "text": "date",
              "vocabularyId": "word-date"
            },
            {
              "id": "segment-4-3",
              "text": ", l’heure et l’adresse dans un message, pour que vous puissiez vérifier les informations."
            }
          ],
          "translationZh": "是的，还有空位。我会用消息发送日期、时刻和地址，便于您核对信息。"
        },
        {
          "id": "entry-5",
          "speakerId": "speaker-1",
          "segments": [
            {
              "id": "segment-5-1",
              "text": "Merci. Est-ce que le message précise les documents à apporter ? Je préfère lire les consignes du cabinet avant de venir, plutôt que de faire une supposition."
            }
          ],
          "translationZh": "谢谢。消息会说明要带哪些文件吗？我更愿意来之前读诊所的说明，不自己猜测。"
        },
        {
          "id": "entry-6",
          "speakerId": "speaker-2",
          "segments": [
            {
              "id": "segment-6-1",
              "text": "Le message contient les informations prévues pour votre rendez-vous. Si une consigne reste peu claire, contactez l’accueil. Je m’occupe de l’organisation, pas d’un avis médical."
            }
          ],
          "translationZh": "消息包含这次预约所需的信息。如果说明仍不清楚，请联系接待处。我负责安排，不提供医学意见。"
        },
        {
          "id": "entry-7",
          "speakerId": "speaker-1",
          "segments": [
            {
              "id": "segment-7-1",
              "text": "D’accord. Si je dois "
            },
            {
              "id": "segment-7-2",
              "text": "annuler",
              "vocabularyId": "word-annuler"
            },
            {
              "id": "segment-7-3",
              "text": " ce rendez-vous, je vais appeler l’accueil. Pouvez-vous répéter l’heure une dernière fois pour que je vérifie ce que j’ai noté ?"
            }
          ],
          "translationZh": "好的。如果必须取消预约，我会打电话到接待处。您能最后重复一次时间，让我核对笔记吗？"
        },
        {
          "id": "entry-8",
          "speakerId": "speaker-2",
          "segments": [
            {
              "id": "segment-8-1",
              "text": "Votre rendez-vous est demain à quinze heures. Vous allez recevoir le message de confirmation ; vérifiez les informations écrites et contactez-nous si elles ne correspondent pas à notre échange."
            }
          ],
          "translationZh": "您的预约是明天十五点。您会收到确认消息；请核对书面信息，如与我们的交谈不一致，请联系我们。"
        }
      ]
    },
    {
      "id": "explanation-main",
      "type": "explanation",
      "titleZh": "这句话如何使用",
      "bodyZh": "Pouvez-vous 引出礼貌请求，Est-ce que 保留后面的陈述语序来提问。demain 相对于通话当天，正文没有固定真实日期。pour que vous puissiez 的虚拟式及 je ne suis jamais venue 的过去表达仅随文释义，不作为本课目标练习。预约对话只练习信息确认，不判断是否适合等待这个时刻。",
      "targets": [
        {
          "blockId": "dialogue-main",
          "entryId": "entry-1",
          "segmentId": "segment-1-8"
        },
        {
          "blockId": "dialogue-main",
          "entryId": "entry-3",
          "segmentId": "segment-3-2"
        }
      ]
    },
    {
      "id": "culture-context",
      "type": "culture",
      "titleZh": "场景中的细节",
      "bodyZh": "时段、消息和取消方式是虚构诊所的预约场景，不是就医安排、医疗分诊或真实机构要求。",
      "scopeZh": "本课虚构场景，不概括所有法语地区或个人的行为。"
    },
    {
      "id": "vocabulary-targets",
      "type": "vocabulary",
      "entryIds": [
        "word-rendez-vous",
        "word-medecin",
        "word-consultation",
