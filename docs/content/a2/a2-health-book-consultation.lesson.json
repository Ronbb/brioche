        "word-date",
        "word-annuler",
        "word-confirmer",
        "word-heure"
      ]
    },
    {
      "id": "grammar-targets",
      "type": "grammar",
      "entryIds": [
        "grammar-a2-pouvoir-service-request",
        "grammar-a2-est-ce-que"
      ]
    },
    {
      "id": "exercise-comprehension",
      "type": "exercise",
      "exerciseType": "single-choice",
      "promptZh": "双方最后确认的就诊时刻是什么？",
      "options": [
        {
          "id": "distractor-a",
          "text": "明天十点"
        },
        {
          "id": "correct",
          "text": "明天十五点"
        },
        {
          "id": "distractor-b",
          "text": "今天十五点"
        }
      ]
    },
    {
      "id": "exercise-fill",
      "type": "exercise",
      "exerciseType": "fill-blank",
      "promptZh": "根据提示补全句子。",
      "templateFr": "Est-ce ___ ce moment est disponible ?",
      "hintZh": "est-ce que 引出一般疑问句，后面保持陈述语序。"
    },
    {
      "id": "exercise-order",
      "type": "exercise",
      "exerciseType": "order",
      "promptZh": "把语块排成一句日常表达。",
      "tokens": [
        {
          "id": "token-3",
          "text": "pour une consultation."
        },
        {
          "id": "token-1",
          "text": "Je voudrais"
        },
        {
          "id": "token-2",
          "text": "prendre un rendez-vous"
        }
      ]
    },
    {
      "id": "habit-main",
      "type": "habit",
      "taskZh": "为虚构诊所写一句预约请求和一句时间确认，不提供真实健康信息。",
      "alternativeZh": "也可以只在心里构思或写一句虚构信息，不需要提供现实行为证明。"
    },
    {
      "id": "summary-main",
      "type": "summary",
      "takeawaysZh": [
        "我能表达预约就诊的请求。",
        "我能询问可用时刻。",
        "我能核对地点和预约确认。"
      ]
    }
  ],
