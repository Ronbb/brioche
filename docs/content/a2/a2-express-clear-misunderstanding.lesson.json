{
  "schemaVersion": "1.0",
  "id": "a2-express-clear-misunderstanding",
  "revision": 1,
  "levelId": "a2",
  "unitId": "a2-expression-negotiation",
  "title": {
    "fr": "Préciser le jour et le lieu",
    "zh": "澄清一次误会"
  },
  "summaryZh": "发现日期理解不同，复述并确认具体时间和入口。",
  "estimatedMinutes": 16,
  "objectivesZh": [
    "说明原本的意思",
    "分别核对日期时间地点",
    "用明确回复结束误会"
  ],
  "knowledge": {
    "vocabulary": [
      {
        "id": "word-malentendu",
        "lemma": "malentendu",
        "partOfSpeech": "noun",
        "meaningZh": "误会",
        "noteZh": "搭配冠词学习 malentendu。",
        "gender": "masculine"
      },
      {
        "id": "word-comprendre",
        "lemma": "comprendre",
        "partOfSpeech": "verb",
        "meaningZh": "理解；听懂",
        "noteZh": "Je comprends 是第一人称单数现在时；加 ne…pas 表示不理解。"
      },
      {
        "id": "word-message",
        "lemma": "message",
        "partOfSpeech": "noun",
        "meaningZh": "消息",
        "noteZh": "message 的单数形式；搭配冠词学习。",
        "gender": "masculine"
      },
      {
        "id": "word-preciser",
        "lemma": "préciser",
        "partOfSpeech": "verb",
        "meaningZh": "说清；明确",
        "noteZh": "说明具体日期、时间或地点。"
      },
      {
        "id": "word-date",
        "lemma": "date",
        "partOfSpeech": "noun",
        "meaningZh": "日期",
        "noteZh": "搭配冠词学习 date。",
        "gender": "feminine"
      },
      {
        "id": "word-reponse",
        "lemma": "réponse",
        "partOfSpeech": "noun",
        "meaningZh": "答复",
        "noteZh": "搭配冠词学习 réponse。",
        "gender": "feminine"
      },
      {
        "id": "word-confirmer",
        "lemma": "confirmer",
        "partOfSpeech": "verb",
        "meaningZh": "确认",
        "noteZh": "confirmer un rendez-vous 表示确认预约。"
      },
      {
        "id": "word-entree",
        "lemma": "entrée",
        "partOfSpeech": "noun",
        "meaningZh": "入口",
        "noteZh": "l’entrée 是阴性名词，省音形式不表示阳性。",
        "gender": "feminine"
      }
    ],
    "grammar": [
      {
        "id": "grammar-a2-vouloir-dire",
        "titleZh": "vouloir dire：澄清原来的意思",
        "bodyZh": "je voulais dire… 在本课用来说明我原本的意思；voulais 是 vouloir 的未完成过去时，后接原形 dire。作为澄清语块学习，不等于 je voudrais 的礼貌请求。",
        "examples": [
          {
            "fr": "Je voulais dire samedi matin.",
            "zh": "我原本说的是星期六上午。"
          }
        ]
      },
      {
        "id": "grammar-a2-donc-confirmation",
        "titleZh": "donc：复述并确认结果",
        "bodyZh": "donc 在本课表示那么、所以，用来复述已经澄清的时间和地点。复述不能替代对方确认；正文中另一人明确同意后，才形成共同约定。",
        "examples": [
          {
            "fr": "Donc, nous nous retrouvons samedi à dix heures.",
            "zh": "那么，我们星期六十点见面。"
          }
        ]
      }
    ]
  },
  "blocks": [
    {
      "id": "scene-main",
      "type": "scene",
      "placeZh": "Camille 与 Luc 在家通过消息确认见面",
      "situationZh": "发现日期理解不同，复述并确认具体时间和入口。",
      "illustrationId": "art-home-morning"
    },
    {
      "id": "dialogue-main",
      "type": "dialogue",
      "titleZh": "澄清一次误会",
      "speakers": [
        {
          "id": "speaker-1",
          "labelZh": "澄清原消息的朋友",
          "characterId": "character-camille",
          "displayName": "Camille",
          "avatarId": "avatar-camille-v1"
        },
        {
          "id": "speaker-2",
          "labelZh": "核对时间地点的朋友",
          "characterId": "character-luc",
          "displayName": "Luc",
          "avatarId": "avatar-luc-v1"
        }
      ],
      "turns": [
        {
          "id": "entry-1",
          "speakerId": "speaker-1",
          "segments": [
            {
              "id": "segment-1-1",
              "text": "Luc, je viens de lire ta "
            },
            {
              "id": "segment-1-2",
              "text": "réponse",
              "vocabularyId": "word-reponse"
            },
            {
              "id": "segment-1-3",
              "text": " à mon "
            },
            {
              "id": "segment-1-4",
              "text": "message",
              "vocabularyId": "word-message"
            },
            {
              "id": "segment-1-5",
              "text": ". Tu as écrit dimanche matin, mais je "
            },
            {
              "id": "segment-1-6",
              "text": "voulais dire",
              "grammarId": "grammar-a2-vouloir-dire"
            },
            {
              "id": "segment-1-7",
              "text": " samedi matin. Je crois qu’il y a un "
            },
            {
              "id": "segment-1-8",
              "text": "malentendu",
              "vocabularyId": "word-malentendu"
            },
            {
              "id": "segment-1-9",
              "text": " sur la "
            },
            {
              "id": "segment-1-10",
              "text": "date",
              "vocabularyId": "word-date"
            },
            {
              "id": "segment-1-11",
              "text": "."
            }
          ],
          "translationZh": "Luc，我刚读了你回复的消息。你写星期日早上，但我原本说星期六上午。我想我们对日期有误会。"
        },
        {
          "id": "entry-2",
          "speakerId": "speaker-2",
          "segments": [
            {
              "id": "segment-2-1",
              "text": "Merci de me le dire. J’ai "
            },
            {
              "id": "segment-2-2",
              "text": "compris",
              "vocabularyId": "word-comprendre"
            },
            {
              "id": "segment-2-3",
              "text": " dimanche parce que ton premier message disait seulement ce week-end. Peux-tu "
            },
            {
              "id": "segment-2-4",
              "text": "préciser",
              "vocabularyId": "word-preciser"
            },
            {
              "id": "segment-2-5",
              "text": " le jour et l’heure pour notre rencontre ?"
            }
          ],
          "translationZh": "谢谢你告诉我。我理解成星期日，因为你的第一条消息只写这个周末。你能明确见面的日期和时间吗？"
        },
        {
          "id": "entry-3",
          "speakerId": "speaker-1",
          "segments": [
            {
              "id": "segment-3-1",
              "text": "Oui. Je propose samedi à dix heures, devant l’"
            },
            {
              "id": "segment-3-2",
              "text": "entrée",
              "vocabularyId": "word-entree"
            },
            {
              "id": "segment-3-3",
              "text": " principale du parc. Je vais écrire ces informations dans un nouveau message pour que tout soit plus clair."
            }
          ],
          "translationZh": "可以。我提议星期六十点，在公园主入口前。我会在一条新消息里写明这些信息，让安排更清楚。"
        },
        {
          "id": "entry-4",
          "speakerId": "speaker-2",
          "segments": [
            {
              "id": "segment-4-1",
              "text": "Donc",
              "grammarId": "grammar-a2-donc-confirmation"
            },
            {
              "id": "segment-4-2",
              "text": ", nous nous retrouvons samedi à dix heures. Pour le lieu, tu parles bien de l’entrée près de la rue des Lilas, et pas de celle à côté de la rivière ?"
            }
          ],
          "translationZh": "那么，我们星期六十点见。地点方面，你说的是靠近丁香街的入口，而不是河边的那个，对吗？"
        },
        {
          "id": "entry-5",
          "speakerId": "speaker-1",
          "segments": [
            {
              "id": "segment-5-1",
              "text": "Exactement, l’entrée près de la rue des Lilas. Merci de vérifier ce détail. Nous avons maintenant le même jour, la même heure et le même lieu."
            }
          ],
          "translationZh": "正是靠近丁香街的入口。谢谢你核对这个细节。现在我们确认的是同一天、同一时间、同一地点。"
        },
        {
          "id": "entry-6",
          "speakerId": "speaker-2",
          "segments": [
            {
              "id": "segment-6-1",
              "text": "Je peux "
            },
            {
              "id": "segment-6-2",
              "text": "confirmer",
              "vocabularyId": "word-confirmer"
            },
            {
              "id": "segment-6-3",
              "text": " samedi à dix heures à cette entrée. Je vais corriger mon agenda et répondre à ton nouveau message. Le rendez-vous de dimanche n’est plus prévu."
            }
          ],
          "translationZh": "我确认星期六十点在这个入口。我会修改日程本，回复你的新消息。现在不安排星期日的见面了。"
        }
      ]
    },
    {
      "id": "explanation-main",
      "type": "explanation",
      "titleZh": "这句话如何使用",
      "bodyZh": "je voulais dire 澄清原意，区别于礼貌请求 je voudrais；donc 引出复述的结果。本课 celle 指另一处 entrée；pour que tout soit plus clair 是表示目的的支持语块，包含虚拟式 soit，暂不要求活用。最后明确确认星期六十点及丁香街入口；仅复述自己的想法不能证明对方同意。",
      "targets": [
        {
          "blockId": "dialogue-main",
          "entryId": "entry-1",
          "segmentId": "segment-1-6"
        },
        {
          "blockId": "dialogue-main",
          "entryId": "entry-4",
          "segmentId": "segment-4-1"
        }
      ]
    },
    {
      "id": "culture-context",
      "type": "culture",
      "titleZh": "场景中的细节",
      "bodyZh": "误会可以来自消息不具体，不必归咎于任何一方。公园入口和街名为虚构，不提供现实导航。",
      "scopeZh": "本课虚构场景，不概括所有法语地区或个人的行为。"
    },
    {
      "id": "vocabulary-targets",
      "type": "vocabulary",
      "entryIds": [
        "word-malentendu",
        "word-comprendre",
        "word-message",
        "word-preciser",
        "word-date",
        "word-reponse",
        "word-confirmer",
        "word-entree"
      ]
    },
    {
      "id": "grammar-targets",
      "type": "grammar",
      "entryIds": [
        "grammar-a2-vouloir-dire",
        "grammar-a2-donc-confirmation"
      ]
    },
    {
      "id": "exercise-comprehension",
      "type": "exercise",
      "exerciseType": "single-choice",
      "promptZh": "最终确认在哪个入口见面？",
      "options": [
        {
          "id": "distractor-a",
          "text": "河边入口"
        },
        {
          "id": "correct",
          "text": "丁香街附近的公园入口"
        },
        {
          "id": "distractor-b",
          "text": "咖啡馆门口"
        }
      ]
    },
    {
      "id": "exercise-fill",
      "type": "exercise",
      "exerciseType": "fill-blank",
      "promptZh": "根据提示补全句子。",
      "templateFr": "Je ___ dire samedi matin.",
      "hintZh": "澄清原意用 je voulais dire；本课不是 je voudrais 的礼貌请求。"
    },
    {
      "id": "exercise-order",
      "type": "exercise",
      "exerciseType": "order",
      "promptZh": "把语块排成一句日常表达。",
      "tokens": [
        {
          "id": "token-3",
          "text": "à dix heures."
        },
        {
          "id": "token-1",
          "text": "Donc, nous nous retrouvons"
        },
        {
          "id": "token-2",
          "text": "samedi"
        }
      ]
    },
    {
      "id": "habit-main",
      "type": "habit",
      "taskZh": "写一条虚构澄清消息，给出具体日期、时间和地点。",
      "alternativeZh": "也可以只在心里构思或写一句虚构信息，不需要提供现实行为证明。"
    },
    {
      "id": "summary-main",
      "type": "summary",
      "takeawaysZh": [
        "我能说明原本的意思。",
        "我能分别核对日期时间地点。",
        "我能用明确回复结束误会。"
      ]
    }
  ],
