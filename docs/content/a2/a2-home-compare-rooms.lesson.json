{
  "schemaVersion": "1.0",
  "id": "a2-home-compare-rooms",
  "revision": 1,
  "levelId": "a2",
  "unitId": "a2-shared-living",
  "title": {
    "fr": "Deux appartements à comparer",
    "zh": "比较住处"
  },
  "summaryZh": "比较面积、光线、位置和租金，区分更高、更低和相同的程度。",
  "estimatedMinutes": 16,
  "objectivesZh": [
    "比较两套住房的特点",
    "使用 plus 和 moins 加形容词",
    "用 aussi…que 表示程度相同"
  ],
  "knowledge": {
    "vocabulary": [
      {
        "id": "word-grand",
        "lemma": "grand",
        "partOfSpeech": "adjective",
        "meaningZh": "大的",
        "noteZh": "un appartement grand；阴性单数 grande。"
      },
      {
        "id": "word-lumineux",
        "lemma": "lumineux",
        "partOfSpeech": "adjective",
        "meaningZh": "明亮的",
        "noteZh": "阳性 lumineux，阴性 lumineuse。"
      },
      {
        "id": "word-cher",
        "lemma": "cher",
        "partOfSpeech": "adjective",
        "meaningZh": "昂贵的",
        "noteZh": "阳性 cher，阴性 chère；本课比较住房价格。"
      },
      {
        "id": "word-proche",
        "lemma": "proche",
        "partOfSpeech": "adjective",
        "meaningZh": "近的",
        "noteZh": "proche de + 地点；阴阳性单数形式相同。"
      },
      {
        "id": "word-loin",
        "lemma": "loin",
        "partOfSpeech": "adverb",
        "meaningZh": "远",
        "noteZh": "loin de + 地点；这里是位置副词。"
      },
      {
        "id": "word-loyer",
        "lemma": "loyer",
        "partOfSpeech": "noun",
        "meaningZh": "租金",
        "noteZh": "搭配冠词学习 loyer。",
        "gender": "masculine"
      },
      {
        "id": "word-balcon",
        "lemma": "balcon",
        "partOfSpeech": "noun",
        "meaningZh": "阳台",
        "noteZh": "搭配冠词学习 balcon。",
        "gender": "masculine"
      },
      {
        "id": "word-bruit",
        "lemma": "bruit",
        "partOfSpeech": "noun",
        "meaningZh": "噪声；声音",
        "noteZh": "faire du bruit 表示发出噪声。",
        "gender": "masculine"
      }
    ],
    "grammar": [
      {
        "id": "grammar-a2-adjective-comparison",
        "titleZh": "plus / moins + 形容词 + que",
        "bodyZh": "比较两者可用 plus + 形容词 + que（更……）或 moins + 形容词 + que（较不……）。形容词仍与被描述名词配合；bon 等有特殊比较形式，不能一律套用 plus。",
        "examples": [
          {
            "fr": "Le second appartement est moins cher que le premier.",
            "zh": "第二套公寓比第一套便宜。"
          }
        ]
      },
      {
        "id": "grammar-a2-aussi-adjective-que",
        "titleZh": "aussi + 形容词 + que：程度相同",
        "bodyZh": "aussi + 形容词 + que 表示两者在某一性质上程度相同。本课 chambre 为阴性单数，所以用 lumineuse；这里 aussi 是比较结构的一部分，与“也”的用法区分。",
        "examples": [
          {
            "fr": "Cette chambre est aussi lumineuse que l’autre.",
            "zh": "这间卧室和另一间一样明亮。"
          }
        ]
      }
    ]
  },
  "blocks": [
    {
      "id": "scene-main",
      "type": "scene",
      "placeZh": "参观两套虚构公寓之后",
      "situationZh": "比较面积、光线、位置和租金，区分更高、更低和相同的程度。",
      "illustrationId": "art-home-morning"
    },
    {
      "id": "dialogue-main",
      "type": "dialogue",
      "titleZh": "比较住处",
      "speakers": [
        {
          "id": "speaker-1",
          "labelZh": "看房者 Camille",
          "characterId": "character-camille",
          "displayName": "Camille",
          "avatarId": "avatar-camille-v1"
        },
        {
          "id": "speaker-2",
          "labelZh": "同行的朋友 Luc",
          "characterId": "character-luc",
          "displayName": "Luc",
          "avatarId": "avatar-luc-v1"
        }
      ],
      "turns": [
        {
          "id": "entry-1",
          "speakerId": "speaker-1",
          "segments": [
            {
              "id": "segment-1-1",
              "text": "Nous avons visité deux appartements ce matin. Le premier est plus "
            },
            {
              "id": "segment-1-2",
              "text": "grand",
              "vocabularyId": "word-grand",
              "grammarId": "grammar-a2-adjective-comparison"
            },
            {
              "id": "segment-1-3",
              "text": " que le second, avec un salon où nous pouvons mettre une table et un canapé."
            }
          ],
          "translationZh": "今天上午我们看了两套公寓。第一套比第二套大，客厅可以放桌子和沙发。"
        },
        {
          "id": "entry-2",
          "speakerId": "speaker-2",
          "segments": [
            {
              "id": "segment-2-1",
              "text": "Oui, et il a un "
            },
            {
              "id": "segment-2-2",
              "text": "balcon",
              "vocabularyId": "word-balcon"
            },
            {
              "id": "segment-2-3",
              "text": ". Mais le "
            },
            {
              "id": "segment-2-4",
              "text": "loyer",
              "vocabularyId": "word-loyer"
            },
            {
              "id": "segment-2-5",
              "text": " est de sept cents euros par mois, alors que le second coûte six cent cinquante euros."
            }
          ],
          "translationZh": "是的，而且有阳台。但它每月租金七百欧元，第二套是六百五十欧元。"
        },
        {
          "id": "entry-3",
          "speakerId": "speaker-1",
          "segments": [
            {
              "id": "segment-3-1",
              "text": "Le second est donc moins "
            },
            {
              "id": "segment-3-2",
              "text": "cher",
              "vocabularyId": "word-cher"
            },
            {
              "id": "segment-3-3",
              "text": " que le premier. Il est plus petit, mais sa chambre est aussi "
            },
            {
              "id": "segment-3-4",
              "text": "lumineuse",
              "vocabularyId": "word-lumineux",
              "grammarId": "grammar-a2-aussi-adjective-que"
            },
            {
              "id": "segment-3-5",
              "text": " que celle du premier appartement."
            }
          ],
          "translationZh": "所以第二套比第一套便宜。它较小，但卧室和第一套的一样明亮。"
        },
        {
          "id": "entry-4",
          "speakerId": "speaker-2",
          "segments": [
            {
              "id": "segment-4-1",
              "text": "Je trouve aussi le second plus calme. Il donne sur une cour, tandis que le premier est près d’une rue avec beaucoup de "
            },
            {
              "id": "segment-4-2",
              "text": "bruit",
              "vocabularyId": "word-bruit"
            },
            {
              "id": "segment-4-3",
              "text": " le matin."
            }
          ],
          "translationZh": "我也觉得第二套更安静。它朝向院子，而第一套靠近一条早晨很吵的街。"
        },
        {
          "id": "entry-5",
          "speakerId": "speaker-1",
          "segments": [
            {
              "id": "segment-5-1",
              "text": "Le premier est "
            },
            {
              "id": "segment-5-2",
              "text": "proche",
              "vocabularyId": "word-proche"
            },
            {
              "id": "segment-5-3",
              "text": " de mon bureau. Je peux y aller à pied en dix minutes, et cela me laisse plus de temps avant le travail."
            }
          ],
          "translationZh": "第一套离我的办公室近。我可以十分钟走到，这样上班前能多一些时间。"
        },
        {
          "id": "entry-6",
          "speakerId": "speaker-2",
          "segments": [
            {
              "id": "segment-6-1",
              "text": "Le second est plus "
            },
            {
              "id": "segment-6-2",
              "text": "loin",
              "vocabularyId": "word-loin"
            },
            {
              "id": "segment-6-3",
              "text": " de ton bureau, mais il y a un arrêt de bus à côté. Nous devons vérifier le trajet avant de choisir."
            }
          ],
          "translationZh": "第二套离你的办公室更远，但旁边有公交站。决定之前，我们需要核对路程。"
        },
        {
          "id": "entry-7",
          "speakerId": "speaker-1",
          "segments": [
            {
              "id": "segment-7-1",
              "text": "Je préfère payer moins et avoir une chambre tranquille. Le balcon me plaît, mais il n’est pas indispensable. Je vais noter les avantages de chaque logement."
            }
          ],
          "translationZh": "我更愿意少付一些钱，有一间安静的卧室。我喜欢阳台，但它不是必需的。我会记下每套住处的优点。"
        },
        {
          "id": "entry-8",
          "speakerId": "speaker-2",
          "segments": [
            {
              "id": "segment-8-1",
              "text": "Bonne idée. Nous pouvons comparer les informations et poser nos questions demain. Il faut aussi demander ce qui est compris dans le prix avant de prendre une décision."
            }
          ],
          "translationZh": "好主意。我们可以比较信息，明天提出问题。决定前，还需要问清价格包含什么。"
        }
      ]
    },
    {
      "id": "explanation-main",
      "type": "explanation",
      "titleZh": "这句话如何使用",
      "bodyZh": "plus grand que 和 moins cher que 比较两个对象。aussi lumineuse que 只说明卧室光线相同，不表示所有特点相同。chambre 阴性，采用 lumineuse；appartement 阳性，采用 grand、cher。celle du premier 代替第一套公寓的卧室，y 指办公室。",
      "targets": [
        {
          "blockId": "dialogue-main",
          "entryId": "entry-1",
          "segmentId": "segment-1-2"
        },
        {
          "blockId": "dialogue-main",
          "entryId": "entry-3",
          "segmentId": "segment-3-4"
        }
      ]
    },
    {
      "id": "culture-context",
      "type": "culture",
      "titleZh": "场景中的细节",
      "bodyZh": "租金、面积、光线、位置与公交为练习设定，不是市场报价或租房建议；每套真实住房的费用与条件需另行核对。",
      "scopeZh": "本课虚构场景，不概括所有法语地区或个人的行为。"
    },
    {
      "id": "vocabulary-targets",
      "type": "vocabulary",
      "entryIds": [
        "word-grand",
        "word-lumineux",
        "word-cher",
        "word-proche",
        "word-loin",
        "word-loyer",
        "word-balcon",
        "word-bruit"
      ]
    },
    {
      "id": "grammar-targets",
      "type": "grammar",
      "entryIds": [
        "grammar-a2-adjective-comparison",
        "grammar-a2-aussi-adjective-que"
      ]
    },
    {
      "id": "exercise-comprehension",
      "type": "exercise",
      "exerciseType": "single-choice",
      "promptZh": "哪套公寓的月租更低？",
      "options": [
        {
          "id": "distractor-a",
          "text": "第一套，七百欧元"
        },
        {
          "id": "correct",
          "text": "第二套，六百五十欧元"
        },
        {
          "id": "distractor-b",
          "text": "两套相同"
        }
      ]
    },
    {
      "id": "exercise-fill",
      "type": "exercise",
      "exerciseType": "fill-blank",
      "promptZh": "根据提示补全句子。",
      "templateFr": "Cette chambre est aussi ___ que l’autre.",
      "hintZh": "“明亮的”配阴性单数 chambre，要用 lumineuse。"
    },
    {
      "id": "exercise-order",
      "type": "exercise",
      "exerciseType": "order",
      "promptZh": "把语块排成一句日常表达。",
      "tokens": [
        {
          "id": "token-3",
          "text": "que le premier."
        },
        {
          "id": "token-1",
          "text": "Le second appartement"
        },
        {
          "id": "token-2",
          "text": "est moins cher"
        }
      ]
    },
    {
      "id": "habit-main",
      "type": "habit",
      "taskZh": "描述两套虚构住处，用一个比较级和一个 aussi…que 句子。",
      "alternativeZh": "也可以只在心里构思或写一句虚构信息，不需要提供现实行为证明。"
    },
    {
      "id": "summary-main",
      "type": "summary",
      "takeawaysZh": [
        "我能比较两套住房的特点。",
        "我能使用 plus 和 moins 加形容词。",
        "我能用 aussi…que 表示程度相同。"
      ]
    }
  ],
