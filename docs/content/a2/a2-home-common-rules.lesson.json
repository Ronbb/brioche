    {
      "id": "exercise-comprehension",
      "type": "exercise",
      "exerciseType": "single-choice",
      "promptZh": "邀请客人来之前，两人约定先做什么？",
      "options": [
        {
          "id": "distractor-a",
          "text": "把钥匙直接借给客人"
        },
        {
          "id": "correct",
          "text": "用消息通知对方"
        },
        {
          "id": "distractor-b",
          "text": "独自决定使用客厅"
        }
      ]
    },
    {
      "id": "exercise-fill",
      "type": "exercise",
      "exerciseType": "fill-blank",
      "promptZh": "根据提示补全句子。",
      "templateFr": "Il ne ___ pas faire du bruit.",
      "hintZh": "无人称结构 il faut，否定时 ne…pas 围住 faut。"
    },
    {
      "id": "exercise-order",
      "type": "exercise",
      "exerciseType": "order",
      "promptZh": "把语块排成一句日常表达。",
      "tokens": [
        {
          "id": "token-3",
          "text": "avant de partir."
        },
        {
          "id": "token-1",
          "text": "Il faut"
        },
        {
          "id": "token-2",
          "text": "fermer la porte"
        }
      ]
    },
    {
      "id": "habit-main",
      "type": "habit",
      "taskZh": "为虚构共同空间写一条必要动作和一条禁止事项。",
      "alternativeZh": "也可以只在心里构思或写一句虚构信息，不需要提供现实行为证明。"
    },
    {
      "id": "summary-main",
      "type": "summary",
      "takeawaysZh": [
        "我能找出共同空间的使用规则。",
        "我能用 il faut 说明必要动作。",
        "我能用 il ne faut pas 表达禁止事项。"
      ]
    }
  ],
