  "levelId": "a2",
  "unitId": "a2-work-study-experience",
  "title": {
    "fr": "Ce qui est fait, ce qui reste",
    "zh": "说明项目进度"
  },
  "summaryZh": "从进度消息中区分已完成、尚未完成、等待答复和下一步计划。",
  "estimatedMinutes": 16,
  "objectivesZh": [
    "区分 déjà 与 pas encore",
    "说明正在等待什么",
    "把已完成工作和计划分开"
  ],
  "knowledge": {
    "vocabulary": [
      {
        "id": "word-deja",
        "lemma": "déjà",
        "partOfSpeech": "adverb",
        "meaningZh": "已经",
        "noteZh": "本课说明已完成的部分。"
      },
      {
        "id": "word-encore",
        "lemma": "encore",
        "partOfSpeech": "adverb",
        "meaningZh": "仍然；还",
        "noteZh": "ne…pas encore 表示尚未，区别于 encore 的“仍然”。"
      },
      {
        "id": "word-termine",
        "lemma": "terminé",
        "partOfSpeech": "adjective",
        "meaningZh": "完成的",
        "noteZh": "la liste est terminée 中与阴性 liste 配合；正文也用作 terminer 的过去分词。"
      },
      {
        "id": "word-avancer",
        "lemma": "avancer",
        "partOfSpeech": "verb",
        "meaningZh": "推进；取得进展",
        "noteZh": "本课 le travail avance 表示工作正在推进。"
      },
      {
        "id": "word-attendre",
        "lemma": "attendre",
        "partOfSpeech": "verb",
        "meaningZh": "等待",
        "noteZh": "elle attend 是第三人称单数现在时。"
      },
      {
        "id": "word-reponse",
        "lemma": "réponse",
        "partOfSpeech": "noun",
        "meaningZh": "答复",
        "noteZh": "搭配冠词学习 réponse。",
        "gender": "feminine"
      },
      {
        "id": "word-date",
        "lemma": "date",
        "partOfSpeech": "noun",
        "meaningZh": "日期",
        "noteZh": "搭配冠词学习 date。",
        "gender": "feminine"
      },
      {
        "id": "word-relire",
        "lemma": "relire",
        "partOfSpeech": "verb",
        "meaningZh": "重读",
        "noteZh": "je vais relire 接动词原形；复合过去时 j’ai relu。"
      }
    ],
    "grammar": [
      {
        "id": "grammar-a2-deja-pas-encore",
        "titleZh": "déjà 与 ne…pas encore：说明进度",
        "bodyZh": "j’ai déjà terminé 表示已经完成；je n’ai pas encore envoyé 表示到现在尚未发送。复合过去时的 ne…pas 围住助动词，encore 放在 pas 后、过去分词前。本课不把“尚未”理解为“永远不做”。",
        "examples": [
          {
            "fr": "Je n’ai pas encore envoyé le résumé.",
            "zh": "我还没有发送摘要。"
          }
        ]
      },
      {
        "id": "grammar-futur-proche-plan",
        "titleZh": "aller + 动词原形：表达接下来的计划",
        "bodyZh": "本课用 aller 的现在时加动词原形表达计划：je vais prendre、elle va retrouver、elles vont marcher。后一个动词保留原形；这里的近期将来是语法名称，不意味着所有用法都有固定的时间上限。",
        "examples": [
          {
            "fr": "Je vais prendre le métro demain.",
            "zh": "我明天打算乘地铁。"
          }
        ]
      }
    ]
  },
  "blocks": [
    {
