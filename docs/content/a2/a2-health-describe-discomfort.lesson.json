{
  "schemaVersion": "1.0",
  "id": "a2-health-describe-discomfort",
  "revision": 1,
  "levelId": "a2",
  "unitId": "a2-body-wellbeing",
  "title": {
    "fr": "Comment je me sens",
    "zh": "描述哪里不舒服"
  },
  "summaryZh": "用身体部位和持续时间描述感觉，再整理想向医生说明的信息。",
  "estimatedMinutes": 16,
  "objectivesZh": [
    "说出感觉不适的位置",
    "用 depuis 说明持续时间",
    "区分观察到的感觉和猜测的原因"
  ],
  "knowledge": {
    "vocabulary": [
      {
        "id": "word-tete",
        "lemma": "tête",
        "partOfSpeech": "noun",
        "meaningZh": "头",
        "noteZh": "搭配冠词学习 tête。",
        "gender": "feminine"
      },
      {
        "id": "word-dos",
        "lemma": "dos",
        "partOfSpeech": "noun",
        "meaningZh": "背部",
        "noteZh": "搭配冠词学习 dos。",
        "gender": "masculine"
      },
      {
        "id": "word-gorge",
        "lemma": "gorge",
        "partOfSpeech": "noun",
        "meaningZh": "喉咙",
        "noteZh": "搭配冠词学习 gorge。",
        "gender": "feminine"
      },
      {
        "id": "word-douleur",
        "lemma": "douleur",
        "partOfSpeech": "noun",
        "meaningZh": "疼痛",
        "noteZh": "搭配冠词学习 douleur。",
        "gender": "feminine"
      },
      {
        "id": "word-fatigue-adj",
        "lemma": "fatigué",
        "partOfSpeech": "adjective",
        "meaningZh": "疲倦的",
        "noteZh": "阴性单数 fatiguée；本课 Camille 说 je suis fatiguée。"
      },
      {
        "id": "word-se-sentir",
        "lemma": "se sentir",
        "partOfSpeech": "verb",
        "meaningZh": "感觉；感到",
        "noteZh": "je me sens 表示我感觉，elle se sent 表示她感觉。"
      },
      {
        "id": "word-depuis",
        "lemma": "depuis",
        "partOfSpeech": "preposition",
        "meaningZh": "自……以来；持续……",
        "noteZh": "本课 depuis hier 指从昨天起持续到说话时。"
      },
      {
        "id": "word-aujourd-hui",
        "lemma": "aujourd’hui",
        "partOfSpeech": "adverb",
        "meaningZh": "今天",
        "noteZh": "以说话当天为参照。"
      }
    ],
    "grammar": [
      {
        "id": "grammar-a2-avoir-mal",
        "titleZh": "avoir mal à：描述哪里不舒服",
        "bodyZh": "avoir mal 后接 à 和身体部位：à la tête、au dos（à + le）、aux dents（à + les）。这描述感觉的位置，不是疾病名称，也不说明原因。",
        "examples": [
          {
            "fr": "J’ai mal à la tête.",
            "zh": "我头痛。"
          }
        ]
      },
      {
        "id": "grammar-a2-depuis-present",
        "titleZh": "现在时 + depuis：说持续到现在的状态",
        "bodyZh": "depuis 引出起点或持续时间。本课现在时 J’ai mal…depuis hier 表示从昨天开始、现在仍存在的感觉；不能据此推断病因或严重程度。",
        "examples": [
          {
            "fr": "J’ai mal à la tête depuis hier.",
            "zh": "我从昨天起一直头痛。"
          }
        ]
      }
    ]
  },
  "blocks": [
    {
      "id": "scene-main",
      "type": "scene",
      "placeZh": "两位朋友在家中交谈",
      "situationZh": "用身体部位和持续时间描述感觉，再整理想向医生说明的信息。",
      "illustrationId": "art-home-morning"
    },
    {
      "id": "dialogue-main",
      "type": "dialogue",
      "titleZh": "描述哪里不舒服",
      "speakers": [
        {
          "id": "speaker-1",
          "labelZh": "描述感受的 Camille",
          "characterId": "character-camille",
          "displayName": "Camille",
          "avatarId": "avatar-camille-v1"
        },
        {
          "id": "speaker-2",
          "labelZh": "倾听的朋友 Luc",
          "characterId": "character-luc",
          "displayName": "Luc",
          "avatarId": "avatar-luc-v1"
        }
      ],
      "turns": [
        {
          "id": "entry-1",
          "speakerId": "speaker-1",
          "segments": [
            {
              "id": "segment-1-1",
              "text": "Aujourd’hui",
              "vocabularyId": "word-aujourd-hui"
            },
            {
              "id": "segment-1-2",
              "text": ", je "
            },
            {
              "id": "segment-1-3",
              "text": "me sens",
              "vocabularyId": "word-se-sentir"
            },
            {
              "id": "segment-1-4",
              "text": " "
            },
            {
              "id": "segment-1-5",
              "text": "fatiguée",
              "vocabularyId": "word-fatigue-adj"
            },
            {
              "id": "segment-1-6",
              "text": " et j’ai mal à la "
            },
            {
              "id": "segment-1-7",
              "text": "tête",
              "vocabularyId": "word-tete",
              "grammarId": "grammar-a2-avoir-mal"
            },
            {
              "id": "segment-1-8",
              "text": ". Je voudrais trouver les mots pour expliquer ce que je ressens, sans oublier les détails."
            }
          ],
          "translationZh": "今天，我感觉疲倦，头痛。我想找到表达方式，把感受说明白，不遗漏细节。"
        },
        {
          "id": "entry-2",
          "speakerId": "speaker-2",
          "segments": [
            {
              "id": "segment-2-1",
              "text": "Tu peux commencer par dire où tu as mal et depuis quand. Est-ce que tu veux préparer quelques phrases avant de parler avec le médecin ?"
            }
          ],
          "translationZh": "你可以先说明哪里痛、从什么时候开始。你想在和医生交谈前准备几句话吗？"
        },
        {
          "id": "entry-3",
          "speakerId": "speaker-1",
          "segments": [
            {
              "id": "segment-3-1",
              "text": "Oui. J’ai mal à la tête "
            },
            {
              "id": "segment-3-2",
              "text": "depuis",
              "vocabularyId": "word-depuis",
              "grammarId": "grammar-a2-depuis-present"
            },
            {
              "id": "segment-3-3",
              "text": " hier. La "
            },
            {
              "id": "segment-3-4",
              "text": "douleur",
              "vocabularyId": "word-douleur"
            },
            {
              "id": "segment-3-5",
              "text": " revient à différents moments, mais je ne connais pas la cause. Je vais expliquer cela clairement."
            }
          ],
          "translationZh": "想。我从昨天起一直头痛。疼痛在不同时间出现，但我不知道原因。我会把这些清楚地说出来。"
        },
        {
          "id": "entry-4",
          "speakerId": "speaker-2",
          "segments": [
            {
              "id": "segment-4-1",
              "text": "D’accord. Tu peux décrire ce que tu observes, sans choisir toi-même un nom de maladie. Je peux simplement écouter les phrases que tu prépares."
            }
          ],
          "translationZh": "好的。你可以描述观察到的情况，不自己选一个疾病名称。我可以听听你准备的句子。"
        },
        {
          "id": "entry-5",
          "speakerId": "speaker-1",
          "segments": [
            {
              "id": "segment-5-1",
              "text": "Je n’ai pas mal à la "
            },
            {
              "id": "segment-5-2",
              "text": "gorge",
              "vocabularyId": "word-gorge"
            },
            {
              "id": "segment-5-3",
              "text": " ni au "
            },
            {
              "id": "segment-5-4",
              "text": "dos",
              "vocabularyId": "word-dos"
            },
            {
              "id": "segment-5-5",
              "text": ". Je vais aussi noter ce qui est différent aujourd’hui pour ne pas confondre les moments."
            }
          ],
          "translationZh": "我喉咙和背部不痛。我也会记下今天有哪些变化，避免混淆时间。"
        },
        {
          "id": "entry-6",
          "speakerId": "speaker-2",
          "segments": [
            {
              "id": "segment-6-1",
              "text": "Ces phrases indiquent les endroits et les moments. Pour les questions médicales, il faut parler avec un professionnel ; je ne peux pas interpréter ces sensations."
            }
          ],
          "translationZh": "这些句子说明了部位和时间。医学问题需要与专业人士交谈；我不能解释这些感觉的意义。"
        },
        {
          "id": "entry-7",
          "speakerId": "speaker-1",
          "segments": [
            {
              "id": "segment-7-1",
              "text": "Je comprends. Je veux surtout être précise quand je décris mon état. Si je ne comprends pas une question, je peux demander de la reformuler."
            }
          ],
          "translationZh": "明白。我主要想准确描述状态。如果不理解一个问题，我可以请对方换种说法。"
        },
        {
          "id": "entry-8",
          "speakerId": "speaker-2",
          "segments": [
            {
              "id": "segment-8-1",
              "text": "Oui. Nous pouvons relire tes phrases ensemble. Tu vas dire ce que tu ressens avec tes propres mots, et demander une explication quand un terme n’est pas clair."
            }
          ],
          "translationZh": "是的。我们可以一起重读句子。你会用自己的话说明感受，遇到不清楚的术语就请对方解释。"
        }
      ]
    },
    {
      "id": "explanation-main",
      "type": "explanation",
      "titleZh": "这句话如何使用",
      "bodyZh": "avoir mal à 后接身体部位：à la tête、à la gorge、au dos。depuis hier 表示从昨天起持续到现在，正文还说明感觉会在不同时间出现。fatiguée 与 Camille 的阴性身份配合。ni 在否定句里连接第二个被否定的部位，ressentir 在本课先理解为感受到。",
      "targets": [
        {
          "blockId": "dialogue-main",
          "entryId": "entry-1",
          "segmentId": "segment-1-7"
        },
        {
          "blockId": "dialogue-main",
          "entryId": "entry-3",
          "segmentId": "segment-3-2"
        }
      ]
    },
    {
      "id": "culture-context",
      "type": "culture",
      "titleZh": "场景中的细节",
      "bodyZh": "这是语言表达场景，不推断病因、程度或处理时间，不给出诊断、用药或治疗建议。",
      "scopeZh": "本课虚构场景，不概括所有法语地区或个人的行为。"
    },
    {
