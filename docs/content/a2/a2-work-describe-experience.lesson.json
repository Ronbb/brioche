{
  "schemaVersion": "1.0",
  "id": "a2-work-describe-experience",
  "revision": 1,
  "levelId": "a2",
  "unitId": "a2-work-study-experience",
  "title": {
    "fr": "Une première expérience en équipe",
    "zh": "简述一次学习实践经历"
  },
  "summaryZh": "读一段项目经历，找出参与时间、做过的任务和学会的事情。",
  "estimatedMinutes": 16,
  "objectivesZh": [
    "简述一段已完成的经历",
    "用复合过去时列出做过的任务",
    "用 apprendre à 说明学会的技能"
  ],
  "knowledge": {
    "vocabulary": [
      {
        "id": "word-experience",
        "lemma": "expérience",
        "partOfSpeech": "noun",
        "meaningZh": "经历；经验",
        "noteZh": "本课 une expérience 指一次参与项目的经历。",
        "gender": "feminine"
      },
      {
        "id": "word-stage",
        "lemma": "stage",
        "partOfSpeech": "noun",
        "meaningZh": "实习；培训实践",
        "noteZh": "本课指虚构的一周实践经历，不介绍法律或报酬条件。",
        "gender": "masculine"
      },
      {
        "id": "word-equipe",
        "lemma": "équipe",
        "partOfSpeech": "noun",
        "meaningZh": "团队",
        "noteZh": "搭配冠词学习 équipe。",
        "gender": "feminine"
      },
      {
        "id": "word-aider",
        "lemma": "aider",
        "partOfSpeech": "verb",
        "meaningZh": "帮助",
        "noteZh": "aider une personne 表示帮助某人。"
      },
      {
        "id": "word-accueillir",
        "lemma": "accueillir",
        "partOfSpeech": "verb",
        "meaningZh": "接待；欢迎",
        "noteZh": "j’ai accueilli 的过去分词是 accueilli。"
      },
      {
        "id": "word-apprendre",
        "lemma": "apprendre",
        "partOfSpeech": "verb",
        "meaningZh": "学习；学会",
        "noteZh": "过去分词 appris；apprendre à + 原形表示学会做某事。"
      },
      {
        "id": "word-projet",
        "lemma": "projet",
        "partOfSpeech": "noun",
        "meaningZh": "项目；计划",
        "noteZh": "搭配冠词学习 projet。",
        "gender": "masculine"
      },
      {
        "id": "word-semaine",
        "lemma": "semaine",
        "partOfSpeech": "noun",
        "meaningZh": "星期；一周",
        "noteZh": "搭配冠词学习 semaine。",
        "gender": "feminine"
      }
    ],
    "grammar": [
      {
        "id": "grammar-a2-passe-compose-avoir",
        "titleZh": "复合过去时入门：avoir + 过去分词",
        "bodyZh": "本课 j’ai visité、nous avons regardé 用 avoir 的现在时加过去分词，讲述已经完成的活动。第一组动词如 visiter 的过去分词常以 -é 结尾；prendre → pris、faire → fait 需另记。复合过去时也可用 être 作助动词，不能把所有动词都套用 avoir。",
        "examples": [
          {
            "fr": "J’ai visité un musée.",
            "zh": "我参观了一家博物馆。"
          }
        ]
      },
      {
        "id": "grammar-a2-apprendre-a",
        "titleZh": "apprendre à + 原形：学会做某事",
        "bodyZh": "apprendre à 后接动词原形，说明学会做什么。本课 j’ai appris à préparer 使用 avoir + appris；不要把 appris 按第一组动词改为 -é。",
        "examples": [
          {
            "fr": "J’ai appris à préparer une activité.",
            "zh": "我学会了准备一项活动。"
          }
        ]
      }
    ]
  },
  "blocks": [
    {
      "id": "scene-main",
      "type": "scene",
      "placeZh": "Camille 在家整理经历说明",
      "situationZh": "读一段项目经历，找出参与时间、做过的任务和学会的事情。",
      "illustrationId": "art-home-morning"
    },
    {
      "id": "article-main",
      "type": "article",
      "titleZh": "简述一次学习实践经历",
      "narratorId": "character-camille",
      "paragraphs": [
        {
          "id": "entry-1",
          "segments": [
            {
              "id": "segment-1-1",
              "text": "Le mois dernier, j’ai fait un "
            },
            {
              "id": "segment-1-2",
              "text": "stage",
              "vocabularyId": "word-stage"
            },
            {
              "id": "segment-1-3",
              "text": " d’une "
            },
            {
              "id": "segment-1-4",
              "text": "semaine",
              "vocabularyId": "word-semaine"
            },
            {
              "id": "segment-1-5",
              "text": " dans une petite bibliothèque. Cette "
            },
            {
              "id": "segment-1-6",
              "text": "expérience",
              "vocabularyId": "word-experience"
            },
            {
              "id": "segment-1-7",
              "text": " m’a permis de découvrir le travail d’une "
            },
            {
              "id": "segment-1-8",
              "text": "équipe",
              "vocabularyId": "word-equipe"
            },
            {
              "id": "segment-1-9",
              "text": " et l’organisation des activités."
            }
          ],
          "translationZh": "上个月，我在一家小图书馆参加了一周实践。这段经历让我了解团队工作和活动安排。"
        },
        {
          "id": "entry-2",
          "segments": [
            {
              "id": "segment-2-1",
              "text": "J’"
            },
            {
              "id": "segment-2-2",
              "text": "ai travaillé",
              "grammarId": "grammar-a2-passe-compose-avoir"
            },
            {
              "id": "segment-2-3",
              "text": " avec Luc sur un "
            },
            {
              "id": "segment-2-4",
              "text": "projet",
              "vocabularyId": "word-projet"
            },
            {
              "id": "segment-2-5",
              "text": " pour présenter quelques livres aux visiteurs. Nous avons choisi des titres et préparé une liste avec des descriptions simples."
            }
          ],
          "translationZh": "我和 Luc 做了一个向来访者介绍书籍的项目。我们选了书名，准备了一份带简短介绍的清单。"
        },
        {
          "id": "entry-3",
          "segments": [
            {
              "id": "segment-3-1",
              "text": "J’ai "
            },
            {
              "id": "segment-3-2",
              "text": "aidé",
              "vocabularyId": "word-aider"
            },
            {
              "id": "segment-3-3",
              "text": " à installer les tables avant une rencontre. Ensuite, j’ai "
            },
            {
              "id": "segment-3-4",
              "text": "accueilli",
              "vocabularyId": "word-accueillir"
            },
            {
              "id": "segment-3-5",
              "text": " les participants avec une autre personne et indiqué le lieu de l’activité."
            }
          ],
          "translationZh": "我帮助在一次活动前布置桌子。之后，我和另一人接待参加者，说明活动地点。"
        },
        {
          "id": "entry-4",
          "segments": [
            {
              "id": "segment-4-1",
              "text": "J’ai "
            },
            {
              "id": "segment-4-2",
              "text": "appris",
              "vocabularyId": "word-apprendre",
              "grammarId": "grammar-a2-apprendre-a"
            },
            {
              "id": "segment-4-3",
              "text": " à préparer une activité en plusieurs étapes. Luc m’a montré comment vérifier la liste, puis demander à une autre personne de relire les informations."
            }
          ],
          "translationZh": "我学会了分步骤准备活动。Luc 向我展示如何核对清单，再请别人重读信息。"
        },
        {
          "id": "entry-5",
          "segments": [
            {
              "id": "segment-5-1",
              "text": "Quand une question n’était pas claire, j’ai demandé une explication au lieu de choisir une réponse au hasard. Je ne connaissais pas encore tous les mots utilisés dans l’équipe."
            }
          ],
          "translationZh": "问题不清楚时，我请对方解释，不随意选一个答案。我还不熟悉团队使用的所有词语。"
        },
        {
          "id": "entry-6",
          "segments": [
            {
              "id": "segment-6-1",
              "text": "Aujourd’hui, je peux décrire cette expérience avec des exemples concrets : le projet, les tâches et ce que j’ai appris. Je distingue ce que j’ai réellement fait de ce que je souhaite apprendre ensuite."
            }
          ],
          "translationZh": "今天，我可以用具体例子描述这段经历：项目、任务，以及学会的事情。我区分实际做过的事和接下来想学的事。"
        }
      ]
    },
    {
      "id": "explanation-main",
      "type": "explanation",
      "titleZh": "这句话如何使用",
      "bodyZh": "j’ai travaillé、j’ai aidé、j’ai accueilli 为已完成动作。apprendre 的过去分词为 appris，后接 à + 原形说明学会的动作。m’a permis de 为“让我能够”的支持表达；n’était pas、ne connaissais pas 是过去背景的未完成过去时，本课随文理解，尚未系统练习。",
      "targets": [
        {
          "blockId": "article-main",
          "entryId": "entry-2",
          "segmentId": "segment-2-2"
        },
        {
          "blockId": "article-main",
          "entryId": "entry-4",
          "segmentId": "segment-4-2"
        }
      ]
    },
    {
