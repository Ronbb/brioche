        "grammar-a2-adjective-comparison"
      ]
    },
    {
      "id": "exercise-comprehension",
      "type": "exercise",
      "exerciseType": "single-choice",
      "promptZh": "Camille 说明的主要理由是什么？",
      "options": [
        {
          "id": "distractor-a",
          "text": "想买饮品"
        },
        {
          "id": "correct",
          "text": "想要安静"
        },
        {
          "id": "distractor-b",
          "text": "想一直步行"
        }
      ]
    },
    {
      "id": "exercise-fill",
      "type": "exercise",
      "exerciseType": "fill-blank",
      "promptZh": "根据提示补全句子。",
      "templateFr": "Je ___ lire à la maison.",
      "hintZh": "préférer 搭配 je 为 préfère，第二个 e 用重音 è。"
    },
    {
      "id": "exercise-order",
      "type": "exercise",
      "exerciseType": "order",
      "promptZh": "把语块排成一句日常表达。",
      "tokens": [
        {
          "id": "token-3",
          "text": "que le café."
        },
        {
          "id": "token-1",
          "text": "Le parc est"
        },
        {
          "id": "token-2",
          "text": "moins bruyant"
        }
      ]
    },
    {
      "id": "habit-main",
      "type": "habit",
      "taskZh": "为虚构周末写一个偏好，再说明理由；可以与另一人不同。",
      "alternativeZh": "也可以只在心里构思或写一句虚构信息，不需要提供现实行为证明。"
    },
    {
      "id": "summary-main",
      "type": "summary",
      "takeawaysZh": [
        "我能说出更愿意做的活动。",
        "我能比较两种环境。",
        "我能说明不同选择的理由。"
      ]
    }
  ],
