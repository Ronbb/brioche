{
  "schemaVersion": "1.0",
  "id": "a2-express-explain-preference",
  "revision": 1,
  "levelId": "a2",
  "unitId": "a2-expression-negotiation",
  "title": {
    "fr": "Lire ou marcher ?",
    "zh": "说明自己的偏好"
  },
  "summaryZh": "分别说明偏好与理由，再寻找两人都能接受的安排。",
  "estimatedMinutes": 16,
  "objectivesZh": [
    "说出更愿意做的活动",
    "比较两种环境",
    "说明不同选择的理由"
  ],
  "knowledge": {
    "vocabulary": [
      {
        "id": "word-preferer",
        "lemma": "préférer",
        "partOfSpeech": "verb",
        "meaningZh": "更喜欢；更愿意",
        "noteZh": "现在时 je préfère、nous préférons；后可接原形。"
      },
      {
        "id": "word-lire",
        "lemma": "lire",
        "partOfSpeech": "verb",
        "meaningZh": "阅读",
        "noteZh": "elle lit 表示她阅读。"
      },
      {
        "id": "word-calme",
        "lemma": "calme",
        "partOfSpeech": "adjective",
        "meaningZh": "安静的",
        "noteZh": "本课形容房间或安静状态，阴阳性单数形式相同。"
      },
      {
        "id": "word-bruyant",
        "lemma": "bruyant",
        "partOfSpeech": "adjective",
        "meaningZh": "吵闹的",
        "noteZh": "bruyant / bruyante 随所修饰名词配合。"
      },
      {
        "id": "word-promenade",
        "lemma": "promenade",
        "partOfSpeech": "noun",
        "meaningZh": "散步",
        "noteZh": "搭配冠词学习 promenade。",
        "gender": "feminine"
      },
      {
        "id": "word-ensemble",
        "lemma": "ensemble",
        "partOfSpeech": "adverb",
        "meaningZh": "一起",
        "noteZh": "本课用于朋友一起活动的安排。"
      },
      {
        "id": "word-choix",
        "lemma": "choix",
        "partOfSpeech": "noun",
        "meaningZh": "选择",
        "noteZh": "搭配冠词学习 choix。",
        "gender": "masculine"
      },
      {
        "id": "word-raison",
        "lemma": "raison",
        "partOfSpeech": "noun",
        "meaningZh": "理由",
        "noteZh": "搭配冠词学习 raison。",
        "gender": "feminine"
      }
    ],
    "grammar": [
      {
        "id": "grammar-a2-preferer-infinitive",
        "titleZh": "préférer + 原形：说明更想做什么",
        "bodyZh": "préférer 后可接名词或动词原形；本课 je préfère lire 说明更想读书，tu préfères marcher 说明更想散步。注意现在时 je préfère、nous préférons 的重音变化。",
        "examples": [
          {
            "fr": "Je préfère lire à la maison.",
            "zh": "我更想在家读书。"
          }
        ]
      },
      {
        "id": "grammar-a2-adjective-comparison",
        "titleZh": "plus / moins + 形容词 + que",
        "bodyZh": "比较两者可用 plus + 形容词 + que（更……）或 moins + 形容词 + que（较不……）。形容词仍与被描述名词配合；bon 等有特殊比较形式，不能一律套用 plus。",
        "examples": [
          {
            "fr": "Le second appartement est moins cher que le premier.",
            "zh": "第二套公寓比第一套便宜。"
          }
        ]
      }
    ]
  },
  "blocks": [
    {
      "id": "scene-main",
      "type": "scene",
      "placeZh": "Camille 与 Luc 在家商量下午安排",
      "situationZh": "分别说明偏好与理由，再寻找两人都能接受的安排。",
      "illustrationId": "art-home-morning"
    },
    {
      "id": "dialogue-main",
      "type": "dialogue",
      "titleZh": "说明自己的偏好",
      "speakers": [
        {
          "id": "speaker-1",
          "labelZh": "想安静阅读的朋友",
          "characterId": "character-camille",
          "displayName": "Camille",
          "avatarId": "avatar-camille-v1"
        },
        {
          "id": "speaker-2",
          "labelZh": "想散步的朋友",
          "characterId": "character-luc",
          "displayName": "Luc",
          "avatarId": "avatar-luc-v1"
        }
      ],
      "turns": [
        {
          "id": "entry-1",
          "speakerId": "speaker-1",
          "segments": [
            {
              "id": "segment-1-1",
              "text": "Pour cet après-midi, je "
            },
            {
              "id": "segment-1-2",
              "text": "préfère",
              "vocabularyId": "word-preferer",
              "grammarId": "grammar-a2-preferer-infinitive"
            },
            {
              "id": "segment-1-3",
              "text": " "
            },
            {
              "id": "segment-1-4",
              "text": "lire",
              "vocabularyId": "word-lire"
            },
            {
              "id": "segment-1-5",
              "text": " à la maison. J’ai commencé un livre et je voudrais terminer un chapitre dans un endroit "
            },
            {
              "id": "segment-1-6",
              "text": "calme",
              "vocabularyId": "word-calme"
            },
            {
              "id": "segment-1-7",
              "text": ". Qu’est-ce que tu préfères faire ?"
            }
          ],
          "translationZh": "今天下午，我更想在家读书。我开始读一本书，想在安静处读完一章。你更想做什么？"
        },
        {
          "id": "entry-2",
          "speakerId": "speaker-2",
          "segments": [
            {
              "id": "segment-2-1",
              "text": "Moi, je préfère faire une "
            },
            {
              "id": "segment-2-2",
              "text": "promenade",
              "vocabularyId": "word-promenade"
            },
            {
              "id": "segment-2-3",
              "text": ". Je suis resté à l’intérieur toute la matinée et j’ai envie de marcher un peu. Mais nous pouvons garder une partie de l’après-midi pour ton livre."
            }
          ],
          "translationZh": "我更想散步。我整个上午都待在室内，想走一走。不过，我们可以留出下午的一部分时间给你读书。"
        },
        {
          "id": "entry-3",
          "speakerId": "speaker-1",
          "segments": [
            {
              "id": "segment-3-1",
              "text": "Le parc est "
            },
            {
              "id": "segment-3-2",
              "text": "moins bruyant que",
              "grammarId": "grammar-a2-adjective-comparison"
            },
            {
              "id": "segment-3-3",
              "text": " le café près de chez nous. Je peux prendre mon livre et lire sur un banc, si le temps reste agréable."
            }
          ],
          "translationZh": "公园比我们家附近的咖啡馆安静。我可以带书，如果天气仍好，就在长椅上读。"
        },
        {
          "id": "entry-4",
          "speakerId": "speaker-2",
          "segments": [
            {
              "id": "segment-4-1",
              "text": "C’est un bon "
            },
            {
              "id": "segment-4-2",
              "text": "choix",
              "vocabularyId": "word-choix"
            },
            {
              "id": "segment-4-3",
              "text": " pour nous deux. Je peux marcher pendant que tu lis, puis nous pouvons faire un petit tour "
            },
            {
              "id": "segment-4-4",
              "text": "ensemble",
              "vocabularyId": "word-ensemble"
            },
            {
              "id": "segment-4-5",
              "text": ". Nous n’avons pas besoin de choisir exactement la même activité."
            }
          ],
          "translationZh": "这对我们俩是个不错的选择。你读书时我可以走走，然后一起散步。我们不必选择完全一样的活动。"
        },
        {
          "id": "entry-5",
          "speakerId": "speaker-1",
          "segments": [
            {
              "id": "segment-5-1",
              "text": "Ma "
            },
            {
              "id": "segment-5-2",
              "text": "raison",
              "vocabularyId": "word-raison"
            },
            {
              "id": "segment-5-3",
              "text": " principale est le calme. Je préfère un lieu moins "
            },
            {
              "id": "segment-5-4",
              "text": "bruyant",
              "vocabularyId": "word-bruyant"
            },
            {
              "id": "segment-5-5",
              "text": " pour me concentrer, mais je suis contente de sortir ensuite avec toi."
            }
          ],
          "translationZh": "我的主要理由是安静。我更喜欢不那么吵的地方，好集中注意力，但之后和你出门我也很高兴。"
        },
        {
          "id": "entry-6",
          "speakerId": "speaker-2",
          "segments": [
            {
              "id": "segment-6-1",
              "text": "D’accord. Je vais vérifier la météo avant de partir. En cas de pluie, nous pouvons rester ici et faire une promenade un autre jour."
            }
          ],
          "translationZh": "好。我出发前看看天气。如果下雨，我们可以留在这里，改天散步。"
        }
      ]
    },
    {
      "id": "explanation-main",
      "type": "explanation",
      "titleZh": "这句话如何使用",
      "bodyZh": "je préfère 后接原形 lire；moins bruyant que 比较环境，不比较谁的爱好更好。je suis resté 的 Luc 用阳性过去分词，pendant que tu lis 表示你读书期间；en cas de pluie 是如果下雨的语块。场景仍受天气条件限制，不把公园安排写成无条件承诺。",
      "targets": [
        {
          "blockId": "dialogue-main",
          "entryId": "entry-1",
          "segmentId": "segment-1-2"
        },
        {
          "blockId": "dialogue-main",
          "entryId": "entry-3",
          "segmentId": "segment-3-2"
        }
      ]
    },
    {
      "id": "culture-context",
      "type": "culture",
      "titleZh": "场景中的细节",
      "bodyZh": "两个人可以保留不同活动，不以共同选择证明关系好坏。地点和天气为虚构。",
      "scopeZh": "本课虚构场景，不概括所有法语地区或个人的行为。"
    },
    {
      "id": "vocabulary-targets",
      "type": "vocabulary",
      "entryIds": [
        "word-preferer",
        "word-lire",
        "word-calme",
        "word-bruyant",
        "word-promenade",
        "word-ensemble",
        "word-choix",
        "word-raison"
      ]
    },
    {
      "id": "grammar-targets",
