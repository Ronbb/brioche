{
  "schemaVersion": "1.0",
  "id": "a2-home-shared-routine",
  "revision": 1,
  "levelId": "a2",
  "unitId": "a2-shared-living",
  "title": {
    "fr": "Nos habitudes à la maison",
    "zh": "描述生活习惯"
  },
  "summaryZh": "比较 Camille 和 Luc 的重复安排，找到经常、偶尔和每周一次的活动。",
  "estimatedMinutes": 16,
  "objectivesZh": [
    "区分习惯频率",
    "用频率副词描述动作",
    "复习 le 加星期的重复安排"
  ],
  "knowledge": {
    "vocabulary": [
      {
        "id": "word-souvent",
        "lemma": "souvent",
        "partOfSpeech": "adverb",
        "meaningZh": "经常",
        "noteZh": "本课放在简单时态的变位动词后。"
      },
      {
        "id": "word-parfois",
        "lemma": "parfois",
        "partOfSpeech": "adverb",
        "meaningZh": "有时",
        "noteZh": "本课句首 Parfois 引出偶尔的安排。"
      },
      {
        "id": "word-rarement",
        "lemma": "rarement",
        "partOfSpeech": "adverb",
        "meaningZh": "很少",
        "noteZh": "与经常或总是区别，仍可能发生。"
      },
      {
        "id": "word-toujours",
        "lemma": "toujours",
        "partOfSpeech": "adverb",
        "meaningZh": "总是",
        "noteZh": "本课表达重复习惯。"
      },
      {
        "id": "expr-une-fois-par-semaine",
        "lemma": "une fois par semaine",
        "partOfSpeech": "phrase",
        "meaningZh": "每周一次",
        "noteZh": "fois 表示次数，par semaine 表示每周。"
      },
      {
        "id": "expr-tous-les-soirs",
        "lemma": "tous les soirs",
        "partOfSpeech": "phrase",
        "meaningZh": "每天晚上",
        "noteZh": "tous les + 时间单位表示重复发生。"
      },
      {
        "id": "word-menage",
        "lemma": "ménage",
        "partOfSpeech": "noun",
        "meaningZh": "家务；清洁",
        "noteZh": "faire le ménage 表示做清洁。",
        "gender": "masculine"
      },
      {
        "id": "word-bureau",
        "lemma": "bureau",
        "partOfSpeech": "noun",
        "meaningZh": "书桌；办公室",
        "noteZh": "un bureau 可指书桌；au bureau 在本单元的工作场景中表示在办公室。",
        "gender": "masculine"
      }
    ],
    "grammar": [
      {
        "id": "grammar-a2-frequency-adverbs",
        "titleZh": "说动作的频率",
        "bodyZh": "本课简单现在时常把 souvent、toujours、rarement 放在变位动词后；Parfois 也可置于句首。这些词表示频率，不是具体的钟点。",
        "examples": [
          {
            "fr": "Luc travaille souvent au bureau.",
            "zh": "Luc 经常在办公室工作。"
          }
        ]
      },
      {
        "id": "grammar-le-weekday-habit",
        "titleZh": "le + 星期：每周的习惯",
        "bodyZh": "本课 Le mercredi, elle travaille à la maison 表示每周三的安排。说某一次星期三可直接用 mercredi；本课练习重复的每周习惯。",
        "examples": [
          {
            "fr": "Le mercredi, elle travaille à la maison.",
            "zh": "她每周三在家工作。"
          }
        ]
      }
    ]
  },
  "blocks": [
    {
      "id": "scene-main",
      "type": "scene",
      "placeZh": "两位合住者的一周生活",
      "situationZh": "比较 Camille 和 Luc 的重复安排，找到经常、偶尔和每周一次的活动。",
      "illustrationId": "art-home-morning"
    },
    {
      "id": "article-main",
      "type": "article",
      "titleZh": "描述生活习惯",
      "narratorId": "character-camille",
      "paragraphs": [
        {
          "id": "entry-1",
          "segments": [
            {
              "id": "segment-1-1",
              "text": "Camille et Luc vivent dans le même appartement, mais ils n’ont pas exactement les mêmes habitudes. Ils parlent de leurs horaires pour organiser les moments dans les espaces communs."
            }
          ],
          "translationZh": "Camille 和 Luc 住在同一套公寓，但习惯并不完全相同。他们会聊各自的时间，安排使用共同空间的时段。"
        },
        {
          "id": "entry-2",
          "segments": [
            {
              "id": "segment-2-1",
              "text": "Luc travaille "
            },
            {
              "id": "segment-2-2",
              "text": "souvent",
              "vocabularyId": "word-souvent",
              "grammarId": "grammar-a2-frequency-adverbs"
            },
            {
              "id": "segment-2-3",
              "text": " au "
            },
            {
              "id": "segment-2-4",
              "text": "bureau",
              "vocabularyId": "word-bureau"
            },
            {
              "id": "segment-2-5",
              "text": ". Il quitte la maison à huit heures et revient avant le dîner. Il mange "
            },
            {
              "id": "segment-2-6",
              "text": "rarement",
              "vocabularyId": "word-rarement"
            },
            {
              "id": "segment-2-7",
              "text": " à la maison à midi."
            }
          ],
          "translationZh": "Luc 经常在办公室工作。他八点出门，晚饭前回来。他中午很少在家吃饭。"
        },
        {
          "id": "entry-3",
          "segments": [
            {
              "id": "segment-3-1",
              "text": "Le mercredi",
              "grammarId": "grammar-le-weekday-habit"
            },
            {
              "id": "segment-3-2",
              "text": ", Camille travaille à la maison. Elle utilise une petite table dans sa chambre et ferme la porte quand elle participe à une réunion."
            }
          ],
          "translationZh": "Camille 每周三在家工作。她在卧室用一张小桌子，参加会议时会关门。"
        },
        {
          "id": "entry-4",
          "segments": [
            {
              "id": "segment-4-1",
              "text": "Tous les soirs",
              "vocabularyId": "expr-tous-les-soirs"
            },
            {
              "id": "segment-4-2",
              "text": ", ils rangent la cuisine après le repas. Luc prépare "
            },
            {
              "id": "segment-4-3",
              "text": "toujours",
              "vocabularyId": "word-toujours"
            },
            {
              "id": "segment-4-4",
              "text": " une boisson chaude pendant que Camille regarde le programme du lendemain sur son téléphone."
            }
          ],
          "translationZh": "每天晚上，他们饭后整理厨房。Luc 总是准备一杯热饮，Camille 则在手机上查看第二天的安排。"
        },
        {
          "id": "entry-5",
          "segments": [
            {
              "id": "segment-5-1",
              "text": "Parfois",
              "vocabularyId": "word-parfois"
            },
            {
              "id": "segment-5-2",
              "text": ", ils invitent une amie à dîner le samedi. Ils préfèrent prévenir à l’avance et choisir un repas simple pour avoir le temps de discuter ensemble."
            }
          ],
          "translationZh": "有时，他们周六邀请一位女性朋友来吃晚饭。他们更愿意提前通知，并选简单的饭菜，留出聊天时间。"
        },
        {
          "id": "entry-6",
          "segments": [
            {
              "id": "segment-6-1",
              "text": "Ils font le "
            },
            {
              "id": "segment-6-2",
              "text": "ménage",
              "vocabularyId": "word-menage"
            },
            {
              "id": "segment-6-3",
              "text": " "
            },
            {
              "id": "segment-6-4",
              "text": "une fois par semaine",
              "vocabularyId": "expr-une-fois-par-semaine"
            },
            {
              "id": "segment-6-5",
              "text": ", le dimanche matin. Si Luc est absent, ils choisissent un autre moment ensemble ; cette organisation reste souple."
            }
          ],
          "translationZh": "他们每周做一次清洁，在周日上午。如果 Luc 不在，他们会一起选另一个时间；安排保持灵活。"
        }
      ]
    },
    {
      "id": "explanation-main",
      "type": "explanation",
      "titleZh": "这句话如何使用",
      "bodyZh": "souvent、rarement、toujours 分别是经常、很少、总是。Parfois 在句首表示有时；une fois par semaine 给出每周一次，tous les soirs 给出每晚。Le mercredi 表示每周三，区别于某一次星期三。avoir le temps de discuter 表示有时间聊天。",
      "targets": [
        {
          "blockId": "article-main",
          "entryId": "entry-2",
          "segmentId": "segment-2-2"
        },
        {
          "blockId": "article-main",
          "entryId": "entry-3",
          "segmentId": "segment-3-1"
        }
      ]
    },
    {
      "id": "culture-context",
      "type": "culture",
      "titleZh": "场景中的细节",
      "bodyZh": "这是个人虚构习惯；工作地点、邀请朋友和清洁频率不代表所有合住者或法语地区的习惯。",
      "scopeZh": "本课虚构场景，不概括所有法语地区或个人的行为。"
    },
    {
