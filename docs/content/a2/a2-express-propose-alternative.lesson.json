          "text": "星期六九点"
        },
        {
          "id": "correct",
          "text": "星期六十四点"
        },
        {
          "id": "distractor-b",
          "text": "星期六晚上"
        }
      ]
    },
    {
      "id": "exercise-fill",
      "type": "exercise",
      "exerciseType": "fill-blank",
      "promptZh": "根据提示补全句子。",
      "templateFr": "Nous ___ partir plus tard.",
      "hintZh": "pouvoir 的 nous 条件式为 pourrions；这里提出可能方案。"
    },
    {
      "id": "exercise-order",
      "type": "exercise",
      "exerciseType": "order",
      "promptZh": "把语块排成一句日常表达。",
      "tokens": [
