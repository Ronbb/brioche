  "title": {
    "fr": "Ma carte ne fonctionne pas",
    "zh": "解释遇到的问题"
  },
  "summaryZh": "说明借阅卡不能使用，引用屏幕消息并描述已做的尝试。",
  "estimatedMinutes": 16,
  "objectivesZh": [
    "准确描述问题和错误消息",
    "用 parce que 解释来电原因",
    "复习 ne…pas 否定动作"
  ],
  "knowledge": {
    "vocabulary": [
      {
        "id": "word-probleme",
        "lemma": "problème",
        "partOfSpeech": "noun",
        "meaningZh": "问题",
        "noteZh": "搭配冠词学习 problème。",
        "gender": "masculine"
      },
      {
        "id": "word-fonctionner",
        "lemma": "fonctionner",
        "partOfSpeech": "verb",
        "meaningZh": "运作；能正常使用",
        "noteZh": "la carte fonctionne 表示卡能使用。"
      },
      {
        "id": "word-carte-service",
        "lemma": "carte",
        "partOfSpeech": "noun",
        "meaningZh": "卡；会员卡",
        "noteZh": "本课为虚构借阅卡，不是银行卡或身份证件。",
        "gender": "feminine"
      },
      {
        "id": "word-ecran",
        "lemma": "écran",
        "partOfSpeech": "noun",
        "meaningZh": "屏幕",
        "noteZh": "搭配冠词学习 écran。",
        "gender": "masculine"
      },
      {
        "id": "word-message",
        "lemma": "message",
        "partOfSpeech": "noun",
        "meaningZh": "消息",
        "noteZh": "message 的单数形式；搭配冠词学习。",
        "gender": "masculine"
      },
      {
        "id": "word-afficher",
        "lemma": "afficher",
        "partOfSpeech": "verb",
        "meaningZh": "显示",
        "noteZh": "l’écran affiche 表示屏幕显示。"
      },
      {
        "id": "word-essayer",
        "lemma": "essayer",
        "partOfSpeech": "verb",
        "meaningZh": "尝试",
        "noteZh": "本课 j’ai essayé 表示已经尝试过。"
      },
      {
        "id": "word-expliquer",
        "lemma": "expliquer",
        "partOfSpeech": "verb",
        "meaningZh": "解释；说明",
        "noteZh": "expliquer un problème 表示说明问题。"
      }
    ],
    "grammar": [
      {
        "id": "grammar-a2-parce-que-cause",
        "titleZh": "parce que：说明原因",
        "bodyZh": "parce que 后接带变位动词的句子，解释原因；元音前 que 可省音，如 parce qu’il。与 pour + 原形的目的表达区分。",
        "examples": [
          {
            "fr": "Je vous appelle parce que ma carte ne fonctionne pas.",
            "zh": "我给您打电话，因为我的卡不能使用。"
          }
        ]
      },
      {
        "id": "grammar-negation-ne-pas",
        "titleZh": "ne…pas：否定一个动作",
        "bodyZh": "书面完整否定形式把 ne 放在变位动词前、pas 放在后：elle ne travaille pas。元音或哑音 h 前 ne 省音为 n’。",
        "examples": [
          {
            "fr": "Elle ne travaille pas le dimanche.",
            "zh": "她星期日不工作。"
          }
        ]
      }
    ]
  },
  "blocks": [
    {
      "id": "scene-main",
      "type": "scene",
      "placeZh": "虚构图书馆的服务电话",
      "situationZh": "说明借阅卡不能使用，引用屏幕消息并描述已做的尝试。",
      "illustrationId": "art-city-morning"
    },
    {
      "id": "dialogue-main",
      "type": "dialogue",
      "titleZh": "解释遇到的问题",
      "speakers": [
        {
          "id": "speaker-1",
          "labelZh": "借阅者 Camille",
          "characterId": "character-camille",
          "displayName": "Camille",
          "avatarId": "avatar-camille-v1"
        },
        {
          "id": "speaker-2",
          "labelZh": "图书馆接待员 Luc",
          "characterId": "character-luc",
          "displayName": "Luc",
          "avatarId": "avatar-luc-v1"
        }
      ],
      "turns": [
        {
          "id": "entry-1",
          "speakerId": "speaker-1",
          "segments": [
            {
              "id": "segment-1-1",
              "text": "Bonjour, je vous appelle "
            },
            {
              "id": "segment-1-2",
              "text": "parce que",
              "grammarId": "grammar-a2-parce-que-cause"
            },
            {
              "id": "segment-1-3",
              "text": " ma "
            },
            {
              "id": "segment-1-4",
              "text": "carte",
              "vocabularyId": "word-carte-service"
            },
            {
              "id": "segment-1-5",
              "text": " "
            },
            {
              "id": "segment-1-6",
              "text": "ne fonctionne pas",
              "vocabularyId": "word-fonctionner",
              "grammarId": "grammar-negation-ne-pas"
            },
            {
              "id": "segment-1-7",
              "text": " à la bibliothèque. Je voudrais "
            },
            {
              "id": "segment-1-8",
              "text": "expliquer",
              "vocabularyId": "word-expliquer"
            },
            {
              "id": "segment-1-9",
              "text": " le "
            },
            {
              "id": "segment-1-10",
              "text": "problème",
              "vocabularyId": "word-probleme"
            },
            {
              "id": "segment-1-11",
              "text": " avant de venir à l’accueil."
            }
          ],
          "translationZh": "您好，我打电话是因为借阅卡在图书馆不能使用。我想先说明问题，再到接待处。"
        },
        {
          "id": "entry-2",
          "speakerId": "speaker-2",
          "segments": [
            {
              "id": "segment-2-1",
              "text": "Bonjour. Pouvez-vous préciser ce qui se passe ? Est-ce que la machine refuse la carte, ou est-ce qu’un "
            },
            {
              "id": "segment-2-2",
              "text": "message",
              "vocabularyId": "word-message"
            },
            {
              "id": "segment-2-3",
              "text": " apparaît sur l’"
            },
            {
              "id": "segment-2-4",
              "text": "écran",
              "vocabularyId": "word-ecran"
            },
            {
              "id": "segment-2-5",
              "text": " ?"
            }
          ],
          "translationZh": "您好。您能具体说说发生了什么吗？机器不接受卡，还是屏幕上出现了消息？"
        },
        {
          "id": "entry-3",
          "speakerId": "speaker-1",
          "segments": [
            {
              "id": "segment-3-1",
              "text": "L’écran "
            },
            {
              "id": "segment-3-2",
              "text": "affiche",
              "vocabularyId": "word-afficher"
            },
            {
              "id": "segment-3-3",
              "text": " « Carte non reconnue ». J’ai "
            },
            {
              "id": "segment-3-4",
              "text": "essayé",
              "vocabularyId": "word-essayer"
            },
            {
              "id": "segment-3-5",
              "text": " deux fois ce matin avec la même carte, mais je n’ai pas pu emprunter le livre."
            }
          ],
          "translationZh": "屏幕显示“卡无法识别”。今早我用同一张卡试了两次，但没能借书。"
        },
        {
          "id": "entry-4",
          "speakerId": "speaker-2",
          "segments": [
            {
              "id": "segment-4-1",
              "text": "Merci pour ces précisions. Votre carte a-t-elle déjà fonctionné dans cette bibliothèque ? Cela nous aide à comprendre la situation avant de vérifier votre dossier."
            }
          ],
          "translationZh": "谢谢您的说明。这张卡之前在这家图书馆用过吗？这有助于我们在查看档案前了解情况。"
        },
        {
          "id": "entry-5",
          "speakerId": "speaker-1",
          "segments": [
            {
              "id": "segment-5-1",
              "text": "Oui, je l’ai utilisée la semaine dernière. Je n’ai pas changé de carte depuis. Je peux vous montrer le message sur place si cela vous aide."
            }
          ],
          "translationZh": "用过，上周我用过。之后没有换卡。如果有帮助，我可以到现场把消息给您看。"
        },
        {
          "id": "entry-6",
          "speakerId": "speaker-2",
          "segments": [
            {
              "id": "segment-6-1",
              "text": "D’accord. Pour le moment, je ne peux pas donner la cause exacte par téléphone. Nous devons regarder la carte et vérifier les informations à l’accueil."
            }
          ],
          "translationZh": "好的。目前我不能在电话里给出准确原因。我们需要在接待处查看卡片并核对信息。"
        },
        {
          "id": "entry-7",
          "speakerId": "speaker-1",
          "segments": [
            {
              "id": "segment-7-1",
              "text": "Je comprends. Je vais venir cet après-midi avec ma carte. Pouvez-vous noter que j’ai déjà essayé deux fois, pour éviter de répéter toute l’explication ?"
            }
          ],
          "translationZh": "明白。我今天下午会带卡过来。您能记下我已经试过两次，避免重复全部说明吗？"
        },
        {
          "id": "entry-8",
          "speakerId": "speaker-2",
          "segments": [
            {
              "id": "segment-8-1",
              "text": "Bien sûr. Je note le message et les deux essais. À votre arrivée, expliquez que vous avez appelé ce matin ; nous allons reprendre la vérification avec vous."
            }
          ],
          "translationZh": "当然。我记下消息和两次尝试。您到达时请说明今天早晨打过电话，我们会和您继续核对。"
        }
      ]
    },
    {
      "id": "explanation-main",
      "type": "explanation",
      "titleZh": "这句话如何使用",
      "bodyZh": "parce que 接 ma carte ne fonctionne pas，说明来电原因。ne fonctionne pas 的否定围住变位动词。j’ai essayé、je n’ai pas pu 是已经尝试和没能完成的过去表达；je l’ai utilisée 中 l’ 代替阴性 carte，过去分词使用 utilisée，本课随文说明而不系统训练这项配合。接待员未从错误消息直接断言故障原因。",
      "targets": [
        {
          "blockId": "dialogue-main",
          "entryId": "entry-1",
          "segmentId": "segment-1-2"
        },
        {
          "blockId": "dialogue-main",
          "entryId": "entry-1",
          "segmentId": "segment-1-6"
        }
      ]
    },
    {
      "id": "culture-context",
      "type": "culture",
      "titleZh": "场景中的细节",
      "bodyZh": "卡片、设备、错误消息和接待流程均为虚构借阅场景，不是实际系统排障指南。",
      "scopeZh": "本课虚构场景，不概括所有法语地区或个人的行为。"
    },
