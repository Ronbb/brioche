{
  "schemaVersion": "1.0",
  "id": "a2-services-fill-information",
  "revision": 1,
  "levelId": "a2",
  "unitId": "a2-daily-services",
  "title": {
    "fr": "Avant d’envoyer le formulaire",
    "zh": "填写并核对信息"
  },
  "summaryZh": "从填写说明中区分姓名栏、联系方式和核对步骤。",
  "estimatedMinutes": 16,
  "objectivesZh": [
    "区分 nom 和 prénom 两栏",
    "理解表格字段用途",
    "用 pour 加原形说明目的"
  ],
  "knowledge": {
    "vocabulary": [
      {
        "id": "word-formulaire",
        "lemma": "formulaire",
        "partOfSpeech": "noun",
        "meaningZh": "表格",
        "noteZh": "搭配冠词学习 formulaire。",
        "gender": "masculine"
      },
      {
        "id": "word-nom",
        "lemma": "nom",
        "partOfSpeech": "noun",
        "meaningZh": "姓；名称",
        "noteZh": "这里与 prénom 对照，指姓氏。",
        "gender": "masculine"
      },
      {
        "id": "word-prenom",
        "lemma": "prénom",
        "partOfSpeech": "noun",
        "meaningZh": "名字（区别于姓氏）",
        "noteZh": "Mon prénom 是“我的名字”。",
        "gender": "masculine"
      },
      {
        "id": "word-adresse",
        "lemma": "adresse",
        "partOfSpeech": "noun",
        "meaningZh": "地址",
        "noteZh": "搭配冠词学习 adresse。",
        "gender": "feminine"
      },
      {
        "id": "word-telephone",
        "lemma": "téléphone",
        "partOfSpeech": "noun",
        "meaningZh": "电话；手机",
        "noteZh": "正文中用来查看时间。",
        "gender": "masculine"
      },
      {
        "id": "word-champ",
        "lemma": "champ",
        "partOfSpeech": "noun",
        "meaningZh": "填写栏；字段",
        "noteZh": "本课指表格中的一栏。",
        "gender": "masculine"
      },
      {
        "id": "word-remplir",
        "lemma": "remplir",
        "partOfSpeech": "verb",
        "meaningZh": "填写；填满",
        "noteZh": "本课 remplir un formulaire 表示填写表格。"
      },
      {
        "id": "word-verifier",
        "lemma": "vérifier",
        "partOfSpeech": "verb",
        "meaningZh": "核对；检查",
        "noteZh": "本课 vérifier les informations 表示核对信息。"
      }
    ],
    "grammar": [
      {
        "id": "grammar-a2-form-labels",
        "titleZh": "Nom / Prénom：区分表格中的姓名栏",
        "bodyZh": "本课表格明确把 Nom 用于姓、Prénom 用于名。Nom 在其他语境也能泛指名称，不能把所有 nom 都译成姓。法语姓名顺序与字段用途应按具体表格确认。",
        "examples": [
          {
            "fr": "Le champ « Prénom » indique le prénom.",
            "zh": "“Prénom”这一栏填写名。"
          }
        ]
      },
      {
        "id": "grammar-a2-pour-infinitive-purpose",
        "titleZh": "pour + 原形：说明目的",
        "bodyZh": "pour 后接动词原形说明动作的目的。本课 pour envoyer une confirmation 说明机构使用联系方式做什么；不表示因为某件已发生的事。",
        "examples": [
          {
            "fr": "Elle relit le formulaire pour vérifier les informations.",
            "zh": "她重读表格，为了核对信息。"
          }
        ]
      }
    ]
  },
  "blocks": [
    {
      "id": "scene-main",
      "type": "scene",
      "placeZh": "虚构中心的活动咨询表",
      "situationZh": "从填写说明中区分姓名栏、联系方式和核对步骤。",
      "illustrationId": "art-city-morning"
    },
    {
      "id": "article-main",
      "type": "article",
      "titleZh": "填写并核对信息",
      "narratorId": "character-camille",
      "paragraphs": [
        {
          "id": "entry-1",
          "segments": [
            {
              "id": "segment-1-1",
              "text": "Camille prépare un "
            },
            {
              "id": "segment-1-2",
              "text": "formulaire",
              "vocabularyId": "word-formulaire"
            },
            {
              "id": "segment-1-3",
              "text": " pour demander des informations sur une activité. Elle lit d’abord les instructions et regarde les "
            },
            {
              "id": "segment-1-4",
              "text": "champs",
              "vocabularyId": "word-champ"
            },
            {
              "id": "segment-1-5",
              "text": " avant de commencer à écrire."
            }
          ],
          "translationZh": "Camille 准备填写一张表格，咨询一项活动。她先读说明，看看各栏，再开始写。"
        },
        {
          "id": "entry-2",
          "segments": [
            {
              "id": "segment-2-1",
              "text": "Dans ce formulaire, le champ « "
            },
            {
              "id": "segment-2-2",
              "text": "Nom",
              "vocabularyId": "word-nom",
              "grammarId": "grammar-a2-form-labels"
            },
            {
              "id": "segment-2-3",
              "text": " » demande le nom de famille. Le champ « "
            },
            {
              "id": "segment-2-4",
              "text": "Prénom",
              "vocabularyId": "word-prenom"
            },
            {
              "id": "segment-2-5",
              "text": " » demande le prénom. Camille fait attention à ne pas inverser les deux."
            }
          ],
          "translationZh": "这份表格中，“Nom”栏要求姓，“Prénom”栏要求名。Camille 注意不把两项写反。"
        },
        {
          "id": "entry-3",
          "segments": [
            {
              "id": "segment-3-1",
              "text": "Une autre partie demande une "
            },
            {
              "id": "segment-3-2",
              "text": "adresse",
              "vocabularyId": "word-adresse"
            },
            {
              "id": "segment-3-3",
              "text": " électronique "
            },
            {
              "id": "segment-3-4",
              "text": "pour envoyer",
              "grammarId": "grammar-a2-pour-infinitive-purpose"
            },
            {
              "id": "segment-3-5",
              "text": " une confirmation. Il ne s’agit pas de l’adresse du logement : la consigne précise le type d’adresse attendu."
            }
          ],
          "translationZh": "另一部分要求邮箱地址，用来发送确认信息。这不是住址：说明明确给出了所需地址类型。"
        },
        {
          "id": "entry-4",
          "segments": [
            {
              "id": "segment-4-1",
              "text": "Le numéro de "
            },
            {
              "id": "segment-4-2",
              "text": "téléphone",
              "vocabularyId": "word-telephone"
            },
            {
              "id": "segment-4-3",
              "text": " est facultatif dans cet exemple. Camille peut laisser ce champ vide et choisir de recevoir la réponse par courrier électronique."
            }
          ],
          "translationZh": "这个例子中的电话号码为选填。Camille 可以留空，选择用电子邮件接收答复。"
        },
        {
          "id": "entry-5",
          "segments": [
            {
              "id": "segment-5-1",
              "text": "Avant de "
            },
            {
              "id": "segment-5-2",
              "text": "remplir",
              "vocabularyId": "word-remplir"
            },
            {
              "id": "segment-5-3",
              "text": " la dernière partie, elle relit la description de l’activité. Elle indique le moment qui l’intéresse, puis "
            },
            {
              "id": "segment-5-4",
              "text": "vérifie",
              "vocabularyId": "word-verifier"
            },
            {
              "id": "segment-5-5",
              "text": " les informations pour éviter une erreur."
            }
          ],
          "translationZh": "填写最后一部分前，她重读活动介绍。她填上感兴趣的时段，再核对信息，避免出错。"
        },
        {
          "id": "entry-6",
          "segments": [
            {
              "id": "segment-6-1",
              "text": "Enfin, elle lit le récapitulatif avant d’envoyer le formulaire. Si une question n’est pas claire, elle contacte l’accueil au lieu d’inventer une information ou de remplir une case au hasard."
            }
          ],
          "translationZh": "最后，她发送表格前会读一遍汇总。如果有问题不清楚，她会联系接待处，不编造信息，也不随意填一栏。"
        }
      ]
    },
    {
      "id": "explanation-main",
      "type": "explanation",
      "titleZh": "这句话如何使用",
      "bodyZh": "Nom 在这份表格明确指姓，Prénom 指名；adresse électronique 是邮箱地址。facultatif 表示选填，这个设定只针对本课表格。pour envoyer、pour éviter 后接原形说明目的。整篇是填写说明短文，不收集或要求学习者提供真实个人信息。",
      "targets": [
        {
          "blockId": "article-main",
          "entryId": "entry-2",
          "segmentId": "segment-2-2"
        },
        {
          "blockId": "article-main",
          "entryId": "entry-3",
          "segmentId": "segment-3-4"
        }
      ]
    },
    {
