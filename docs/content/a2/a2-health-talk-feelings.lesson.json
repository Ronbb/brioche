{
  "schemaVersion": "1.0",
  "id": "a2-health-talk-feelings",
  "revision": 1,
  "levelId": "a2",
  "unitId": "a2-body-wellbeing",
  "title": {
    "fr": "Une journée avec plusieurs émotions",
    "zh": "表达情绪与状态"
  },
  "summaryZh": "读一段主观感受，区分情绪变化、原因和朋友的支持。",
  "estimatedMinutes": 16,
  "objectivesZh": [
    "理解几个常见情绪词",
    "用 être 加形容词描述状态",
    "用 parce que 说明感受的原因"
  ],
  "knowledge": {
    "vocabulary": [
      {
        "id": "word-stresse",
        "lemma": "stressé",
        "partOfSpeech": "adjective",
        "meaningZh": "紧张的；有压力的",
        "noteZh": "阴性 stressée；本课描述主观感受，不是诊断。"
      },
      {
        "id": "word-inquiet",
        "lemma": "inquiet",
        "partOfSpeech": "adjective",
        "meaningZh": "担心的",
        "noteZh": "阴性 inquiète。"
      },
      {
        "id": "word-content",
        "lemma": "content",
        "partOfSpeech": "adjective",
        "meaningZh": "高兴的；满意的",
        "noteZh": "阴性 contente。"
      },
      {
        "id": "word-triste",
        "lemma": "triste",
        "partOfSpeech": "adjective",
        "meaningZh": "难过的",
        "noteZh": "阴阳性单数形式相同。"
      },
      {
        "id": "word-fatigue-adj",
        "lemma": "fatigué",
        "partOfSpeech": "adjective",
        "meaningZh": "疲倦的",
        "noteZh": "阴性单数 fatiguée；本课 Camille 说 je suis fatiguée。"
      },
      {
        "id": "word-discuter",
        "lemma": "discuter",
        "partOfSpeech": "verb",
        "meaningZh": "讨论；交谈",
        "noteZh": "discuter avec quelqu’un 表示与某人交谈。"
      },
      {
        "id": "word-pause",
        "lemma": "pause",
        "partOfSpeech": "noun",
        "meaningZh": "休息；暂停",
        "noteZh": "faire une pause 表示休息一会儿。",
        "gender": "feminine"
      },
      {
        "id": "word-soutien",
        "lemma": "soutien",
        "partOfSpeech": "noun",
        "meaningZh": "支持",
        "noteZh": "本课指朋友倾听和理解带来的支持。",
        "gender": "masculine"
      }
    ],
    "grammar": [
      {
        "id": "grammar-a2-etre-feeling-adjective",
        "titleZh": "être + 形容词：说自己的状态",
        "bodyZh": "je suis + 形容词表达状态。形容词与所描述的人配合：Camille 说 je suis stressée、contente，Luc 可说 je suis stressé、content；triste 的阴阳性单数形式相同。",
        "examples": [
          {
            "fr": "Je suis contente de parler avec mon amie.",
            "zh": "我很高兴和朋友聊天。"
          }
        ]
      },
      {
        "id": "grammar-a2-parce-que-cause",
        "titleZh": "parce que：说明原因",
        "bodyZh": "parce que 后接带变位动词的句子，解释原因；元音前 que 可省音，如 parce qu’il。与 pour + 原形的目的表达区分。",
        "examples": [
          {
            "fr": "Je vous appelle parce que ma carte ne fonctionne pas.",
            "zh": "我给您打电话，因为我的卡不能使用。"
          }
        ]
      }
    ]
  },
  "blocks": [
    {
      "id": "scene-main",
      "type": "scene",
      "placeZh": "Camille 写给朋友的一段消息",
      "situationZh": "读一段主观感受，区分情绪变化、原因和朋友的支持。",
      "illustrationId": "art-home-morning"
    },
    {
      "id": "article-main",
      "type": "article",
      "titleZh": "表达情绪与状态",
      "narratorId": "character-camille",
      "paragraphs": [
        {
          "id": "entry-1",
          "segments": [
            {
              "id": "segment-1-1",
              "text": "Ce matin, je suis "
            },
            {
              "id": "segment-1-2",
              "text": "stressée",
              "vocabularyId": "word-stresse",
              "grammarId": "grammar-a2-etre-feeling-adjective"
            },
            {
              "id": "segment-1-3",
              "text": " "
            },
            {
              "id": "segment-1-4",
              "text": "parce que",
              "grammarId": "grammar-a2-parce-que-cause"
            },
            {
              "id": "segment-1-5",
              "text": " je dois présenter un petit projet devant mon groupe. J’ai préparé mes notes, mais je pense encore aux questions possibles."
            }
          ],
          "translationZh": "今天早晨，我很紧张，因为要在小组前介绍一个小项目。我准备好了笔记，但仍在想可能遇到的问题。"
        },
        {
          "id": "entry-2",
          "segments": [
            {
              "id": "segment-2-1",
              "text": "Je suis aussi "
            },
            {
              "id": "segment-2-2",
              "text": "inquiète",
              "vocabularyId": "word-inquiet"
            },
            {
              "id": "segment-2-3",
              "text": " de ne pas trouver les mots au bon moment. Mon amie écoute ce que je veux dire et me propose de répéter avec elle."
            }
          ],
          "translationZh": "我也担心到时候找不到合适的词。朋友听我想说的内容，提议和她一起练习。"
        },
        {
          "id": "entry-3",
          "segments": [
            {
              "id": "segment-3-1",
              "text": "Après la présentation, je suis "
            },
            {
              "id": "segment-3-2",
              "text": "contente",
              "vocabularyId": "word-content"
            },
            {
              "id": "segment-3-3",
              "text": " : les autres ont compris mon idée et posé des questions intéressantes. Je ne connais pas toutes les réponses, et je peux le dire."
            }
          ],
          "translationZh": "介绍之后，我很高兴：其他人理解了想法，提出了有趣的问题。我不知道所有答案，也可以如实说。"
        },
        {
          "id": "entry-4",
          "segments": [
            {
              "id": "segment-4-1",
              "text": "L’après-midi, je suis "
            },
            {
              "id": "segment-4-2",
              "text": "fatiguée",
              "vocabularyId": "word-fatigue-adj"
            },
            {
              "id": "segment-4-3",
              "text": " et je fais une "
            },
            {
              "id": "segment-4-4",
              "text": "pause",
              "vocabularyId": "word-pause"
            },
            {
              "id": "segment-4-5",
              "text": ". Je prends un moment pour "
            },
            {
              "id": "segment-4-6",
              "text": "discuter",
              "vocabularyId": "word-discuter"
            },
            {
              "id": "segment-4-7",
              "text": " avec Luc de cette journée, sans chercher à tout raconter en détail."
            }
          ],
          "translationZh": "下午，我很疲倦，休息了一会儿。我花些时间和 Luc 聊这一天，不试图把每个细节都讲完。"
        },
        {
          "id": "entry-5",
          "segments": [
            {
              "id": "segment-5-1",
              "text": "Luc est "
            },
            {
              "id": "segment-5-2",
              "text": "triste",
              "vocabularyId": "word-triste"
            },
            {
              "id": "segment-5-3",
              "text": " parce qu’un ami quitte la ville. Il préfère simplement parler de leurs souvenirs. Je l’écoute ; je ne décide pas à sa place de ce qu’il doit ressentir."
            }
          ],
          "translationZh": "Luc 很难过，因为一位朋友要离开这座城市。他只是想聊聊共同回忆。我听他说，不替他决定应该有什么感受。"
        },
        {
          "id": "entry-6",
          "segments": [
            {
              "id": "segment-6-1",
              "text": "Nous avons des émotions différentes et nous pouvons les décrire avec nos propres mots. Pour nous, le "
            },
            {
              "id": "segment-6-2",
              "text": "soutien",
              "vocabularyId": "word-soutien"
            },
            {
              "id": "segment-6-3",
              "text": " consiste surtout à écouter et à demander quel type de conversation convient à l’autre."
            }
          ],
          "translationZh": "我们的情绪不同，可以用自己的话描述。对我们来说，支持主要是倾听，并询问对方想怎样交谈。"
        }
      ]
    },
    {
      "id": "explanation-main",
      "type": "explanation",
      "titleZh": "这句话如何使用",
      "bodyZh": "stressée、inquiète、contente、fatiguée 描述 Camille 的状态，使用阴性形式；triste 描述 Luc，词形不变。parce que 说明原因。l’écoute 中 l’ 代替 Luc，à sa place 表示代替他；正文不要求推测别人的真实情绪。",
      "targets": [
        {
          "blockId": "article-main",
          "entryId": "entry-1",
          "segmentId": "segment-1-2"
        },
        {
          "blockId": "article-main",
          "entryId": "entry-1",
          "segmentId": "segment-1-4"
        }
      ]
    },
    {
      "id": "culture-context",
      "type": "culture",
      "titleZh": "场景中的细节",
      "bodyZh": "感受、压力和朋友回应均为虚构个人经历；情绪词用于日常表达，不作为心理诊断、评估或治疗建议。",
      "scopeZh": "本课虚构场景，不概括所有法语地区或个人的行为。"
    },
    {
      "id": "vocabulary-targets",
