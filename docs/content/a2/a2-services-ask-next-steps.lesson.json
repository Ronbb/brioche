        "grammar-a2-devoir-present"
      ]
    },
    {
      "id": "exercise-comprehension",
      "type": "exercise",
      "exerciseType": "single-choice",
      "promptZh": "收到材料的确认消息是否就是申请的最终答复？",
      "options": [
        {
          "id": "distractor-a",
          "text": "是，说明申请已经获准"
        },
        {
          "id": "correct",
          "text": "不是，只确认材料到达"
        },
        {
          "id": "distractor-b",
          "text": "是，说明申请已经被拒绝"
        }
      ]
    },
    {
      "id": "exercise-fill",
      "type": "exercise",
      "exerciseType": "fill-blank",
      "promptZh": "根据提示补全句子。",
      "templateFr": "Je ___ vérifier le document demandé.",
      "hintZh": "devoir 搭配 je 的现在时是 dois，后面接原形 vérifier。"
    },
    {
      "id": "exercise-order",
      "type": "exercise",
      "exerciseType": "order",
      "promptZh": "把语块排成一句日常表达。",
      "tokens": [
        {
          "id": "token-3",
          "text": "le document demandé."
        },
        {
          "id": "token-1",
          "text": "D’abord,"
        },
        {
          "id": "token-2",
          "text": "je dois vérifier"
        }
      ]
    },
    {
      "id": "habit-main",
      "type": "habit",
      "taskZh": "为虚构申请写三步流程，再写一句询问处理时间的问题。",
      "alternativeZh": "也可以只在心里构思或写一句虚构信息，不需要提供现实行为证明。"
    },
    {
      "id": "summary-main",
      "type": "summary",
      "takeawaysZh": [
        "我能询问缺少的材料。",
        "我能整理处理步骤的顺序。",
        "我能确认时限和后续联系方式。"
      ]
    }
  ],
