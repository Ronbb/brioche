  "levelId": "a2",
  "unitId": "a2-daily-services",
  "title": {
    "fr": "Que dois-je faire ensuite ?",
    "zh": "询问后续处理方式"
  },
  "summaryZh": "确认缺少哪份材料、怎样发送和什么时候继续联系。",
  "estimatedMinutes": 16,
  "objectivesZh": [
    "询问缺少的材料",
    "整理处理步骤的顺序",
    "确认时限和后续联系方式"
  ],
  "knowledge": {
    "vocabulary": [
      {
        "id": "word-demande",
        "lemma": "demande",
        "partOfSpeech": "noun",
        "meaningZh": "请求；申请",
        "noteZh": "搭配冠词学习 demande。",
        "gender": "feminine"
      },
      {
        "id": "word-dossier",
        "lemma": "dossier",
        "partOfSpeech": "noun",
        "meaningZh": "资料档案；申请材料",
        "noteZh": "搭配冠词学习 dossier。",
        "gender": "masculine"
      },
      {
        "id": "word-document",
        "lemma": "document",
        "partOfSpeech": "noun",
        "meaningZh": "文件；资料",
        "noteZh": "搭配冠词学习 document。",
        "gender": "masculine"
      },
      {
        "id": "word-envoyer",
        "lemma": "envoyer",
        "partOfSpeech": "verb",
        "meaningZh": "发送",
        "noteZh": "envoyer un document 表示发送文件。"
      },
      {
        "id": "word-copie",
        "lemma": "copie",
        "partOfSpeech": "noun",
        "meaningZh": "副本",
        "noteZh": "搭配冠词学习 copie。",
        "gender": "feminine"
      },
      {
        "id": "word-reponse",
        "lemma": "réponse",
        "partOfSpeech": "noun",
        "meaningZh": "答复",
        "noteZh": "搭配冠词学习 réponse。",
        "gender": "feminine"
      },
      {
        "id": "word-delai",
        "lemma": "délai",
        "partOfSpeech": "noun",
        "meaningZh": "时限；处理时间",
        "noteZh": "搭配冠词学习 délai。",
        "gender": "masculine"
      },
      {
        "id": "word-attendre",
        "lemma": "attendre",
        "partOfSpeech": "verb",
        "meaningZh": "等待",
        "noteZh": "elle attend 是第三人称单数现在时。"
      }
    ],
    "grammar": [
      {
        "id": "grammar-a2-sequence",
        "titleZh": "D’abord, ensuite, enfin：组织顺序",
        "bodyZh": "d’abord 表示首先，ensuite 表示接下来，enfin 表示最后。这些连接词可组织计划、操作步骤或过去事件的叙述；它们本身不决定动词时态。例句用近期将来表达计划，讲述过去经历时则按情境使用过去时。",
        "examples": [
          {
            "fr": "D’abord, nous allons visiter le musée.",
            "zh": "首先，我们打算参观博物馆。"
          }
        ]
      },
      {
        "id": "grammar-a2-devoir-present",
        "titleZh": "devoir + 原形：说需要做的事",
        "bodyZh": "devoir 的现在时随主语变化：je dois、tu dois、nous devons。后接动词原形，如 nous devons ranger。这些课程用它表达需要做的事，包括家务分工和办事步骤；devoir 还可表达推测等其他意思，不能把所有用法都解释为义务。",
        "examples": [
          {
            "fr": "Nous devons ranger la cuisine.",
            "zh": "我们需要整理厨房。"
          }
        ]
      }
    ]
  },
  "blocks": [
    {
      "id": "scene-main",
      "type": "scene",
      "placeZh": "虚构中心的资料咨询",
      "situationZh": "确认缺少哪份材料、怎样发送和什么时候继续联系。",
      "illustrationId": "art-city-morning"
    },
    {
      "id": "dialogue-main",
      "type": "dialogue",
      "titleZh": "询问后续处理方式",
      "speakers": [
        {
          "id": "speaker-1",
          "labelZh": "活动申请者 Camille",
          "characterId": "character-camille",
          "displayName": "Camille",
          "avatarId": "avatar-camille-v1"
        },
        {
          "id": "speaker-2",
          "labelZh": "社区中心接待员 Luc",
          "characterId": "character-luc",
          "displayName": "Luc",
          "avatarId": "avatar-luc-v1"
        }
      ],
      "turns": [
        {
          "id": "entry-1",
          "speakerId": "speaker-1",
          "segments": [
            {
              "id": "segment-1-1",
              "text": "Bonjour, je voudrais savoir où en est ma "
            },
            {
              "id": "segment-1-2",
              "text": "demande",
              "vocabularyId": "word-demande"
            },
            {
              "id": "segment-1-3",
              "text": " pour l’atelier. J’ai envoyé le formulaire hier, mais je ne sais pas si mon "
            },
            {
              "id": "segment-1-4",
              "text": "dossier",
              "vocabularyId": "word-dossier"
            },
            {
              "id": "segment-1-5",
              "text": " est complet."
            }
          ],
          "translationZh": "您好，我想知道工作坊申请进展。我昨天发了表格，但不知道材料是否齐全。"
        },
        {
          "id": "entry-2",
          "speakerId": "speaker-2",
          "segments": [
            {
              "id": "segment-2-1",
              "text": "Bonjour. Nous avons reçu votre formulaire. Il manque une "
            },
            {
              "id": "segment-2-2",
              "text": "copie",
              "vocabularyId": "word-copie"
            },
            {
              "id": "segment-2-3",
              "text": " du "
            },
            {
              "id": "segment-2-4",
              "text": "document",
              "vocabularyId": "word-document"
            },
            {
              "id": "segment-2-5",
              "text": " demandé dans les instructions. Vous pouvez l’"
            },
            {
              "id": "segment-2-6",
              "text": "envoyer",
              "vocabularyId": "word-envoyer"
            },
            {
              "id": "segment-2-7",
              "text": " par le même canal que le formulaire."
            }
          ],
          "translationZh": "您好。我们收到表格了。还缺一份说明中要求的文件副本。您可以通过发送表格的同一渠道发送。"
        },
        {
          "id": "entry-3",
          "speakerId": "speaker-1",
          "segments": [
            {
              "id": "segment-3-1",
              "text": "D’accord. "
            },
            {
              "id": "segment-3-2",
              "text": "D’abord",
              "grammarId": "grammar-a2-sequence"
            },
            {
              "id": "segment-3-3",
              "text": ", je "
            },
            {
              "id": "segment-3-4",
              "text": "dois",
              "grammarId": "grammar-a2-devoir-present"
            },
            {
              "id": "segment-3-5",
              "text": " vérifier quel document est demandé. Ensuite, je dois préparer la copie et l’envoyer. C’est bien l’ordre à suivre ?"
            }
          ],
          "translationZh": "好的。首先，我需要确认要求哪份文件。然后准备副本并发送。步骤顺序是这样吗？"
        },
        {
          "id": "entry-4",
          "speakerId": "speaker-2",
          "segments": [
            {
              "id": "segment-4-1",
              "text": "Oui. Enfin, vous allez recevoir un message qui confirme que les pièces sont arrivées. Ce message n’est pas encore la "
            },
            {
              "id": "segment-4-2",
              "text": "réponse",
              "vocabularyId": "word-reponse"
            },
            {
              "id": "segment-4-3",
              "text": " définitive à votre demande."
            }
          ],
          "translationZh": "是的。最后，您会收到确认材料到达的消息。这还不是申请的最终答复。"
        },
        {
          "id": "entry-5",
          "speakerId": "speaker-1",
          "segments": [
            {
              "id": "segment-5-1",
              "text": "Quel est le "
            },
            {
              "id": "segment-5-2",
              "text": "délai",
              "vocabularyId": "word-delai"
            },
            {
              "id": "segment-5-3",
              "text": " prévu après la réception des pièces ? Je peux "
            },
            {
              "id": "segment-5-4",
              "text": "attendre",
              "vocabularyId": "word-attendre"
            },
            {
              "id": "segment-5-5",
              "text": ", mais je voudrais savoir quand vous contacter si je ne reçois rien."
            }
          ],
          "translationZh": "收到材料后，预计处理时间是多久？我可以等，但想知道没收到消息时什么时候联系您。"
        },
        {
          "id": "entry-6",
          "speakerId": "speaker-2",
          "segments": [
            {
              "id": "segment-6-1",
              "text": "Dans cet exemple, la réponse est prévue dans les cinq jours ouvrés après la réception du dossier complet. Le message de réception précise la date de référence."
            }
          ],
          "translationZh": "这个例子中，收到完整材料后预计五个工作日内答复。收件消息会明确用于计算的日期。"
        },
        {
          "id": "entry-7",
          "speakerId": "speaker-1",
          "segments": [
            {
              "id": "segment-7-1",
              "text": "Je vais donc regarder la date indiquée, puis attendre votre réponse. Si ce délai est dépassé, je peux appeler l’accueil avec la référence de ma demande ?"
            }
          ],
          "translationZh": "那么我会看标注日期，再等待答复。如果超过时限，我可以提供申请编号，打电话到接待处吗？"
        },
        {
          "id": "entry-8",
          "speakerId": "speaker-2",
          "segments": [
            {
              "id": "segment-8-1",
              "text": "Oui, c’est cela. Gardez les messages pour retrouver la référence. Si une instruction reste peu claire, contactez-nous avant d’envoyer un autre document ou une nouvelle demande."
            }
          ],
          "translationZh": "是的。请保留消息以便找到编号。如果说明仍不清楚，发送另一份文件或新申请前请先联系我们。"
        }
      ]
    },
    {
      "id": "explanation-main",
      "type": "explanation",
      "titleZh": "这句话如何使用",
      "bodyZh": "D’abord、ensuite、enfin 组织步骤，je dois 接 vérifier 或 préparer 等原形。où en est ma demande 是询问进展的语块。les pièces 在此指材料，不是前一单元的房间词义；jours ouvrés 为本例工作日说法，具体日历没有给出，不能自行推算最终日期。收到材料的确认不等于申请获准。",
      "targets": [
        {
          "blockId": "dialogue-main",
          "entryId": "entry-3",
          "segmentId": "segment-3-2"
        },
        {
          "blockId": "dialogue-main",
          "entryId": "entry-3",
          "segmentId": "segment-3-4"
        }
      ]
    },
    {
      "id": "culture-context",
      "type": "culture",
      "titleZh": "场景中的细节",
      "bodyZh": "材料、渠道、五个工作日和后续电话均为虚构中心的练习设定，不是行政规定、法定期限或服务承诺。",
      "scopeZh": "本课虚构场景，不概括所有法语地区或个人的行为。"
    },
    {
