{
  "schemaVersion": "1.0",
  "id": "a2-express-evaluate-experience",
  "revision": 1,
  "levelId": "a2",
  "unitId": "a2-expression-negotiation",
  "title": {
    "fr": "Mon avis après une sortie",
    "zh": "评价一次体验"
  },
  "summaryZh": "区分经历事实、个人评价和带理由的推荐。",
  "estimatedMinutes": 16,
  "objectivesZh": [
    "标明个人评价",
    "用原因解释感受",
    "结合需求说明推荐"
  ],
  "knowledge": {
    "vocabulary": [
      {
        "id": "word-avis",
        "lemma": "avis",
        "partOfSpeech": "noun",
        "meaningZh": "看法；意见",
        "noteZh": "à mon avis 表示依我看。",
        "gender": "masculine"
      },
      {
        "id": "word-agreable",
        "lemma": "agréable",
        "partOfSpeech": "adjective",
        "meaningZh": "舒适的；令人愉快的",
        "noteZh": "本课是说话者对环境的个人评价。"
      },
      {
        "id": "word-bruyant",
        "lemma": "bruyant",
        "partOfSpeech": "adjective",
        "meaningZh": "吵闹的",
        "noteZh": "bruyant / bruyante 随所修饰名词配合。"
      },
      {
        "id": "word-accueillant",
        "lemma": "accueillant",
        "partOfSpeech": "adjective",
        "meaningZh": "友好的；热情的",
        "noteZh": "本课人员态度的个人评价，不是场所保证。"
      },
      {
        "id": "word-ambiance",
        "lemma": "ambiance",
        "partOfSpeech": "noun",
        "meaningZh": "氛围",
        "noteZh": "搭配冠词学习 ambiance。",
        "gender": "feminine"
      },
      {
        "id": "word-service",
        "lemma": "service",
        "partOfSpeech": "noun",
        "meaningZh": "服务",
        "noteZh": "搭配冠词学习 service。",
        "gender": "masculine"
      },
      {
        "id": "word-calme",
        "lemma": "calme",
        "partOfSpeech": "adjective",
        "meaningZh": "安静的",
        "noteZh": "本课形容房间或安静状态，阴阳性单数形式相同。"
      },
      {
        "id": "word-recommander",
        "lemma": "recommander",
        "partOfSpeech": "verb",
        "meaningZh": "推荐",
        "noteZh": "推荐须结合个人需求，不保证别人感受相同。"
      }
    ],
    "grammar": [
      {
        "id": "grammar-a2-personal-opinion",
        "titleZh": "à mon avis：标明个人评价",
        "bodyZh": "à mon avis 表示依我看，说明后面的评价属于说话者；je trouve + 宾语 + 形容词表达个人看法。本课 je trouve ce lieu agréable 不是所有人都同意的客观结论。",
        "examples": [
          {
            "fr": "À mon avis, ce lieu est agréable.",
            "zh": "依我看，这个地方很舒适。"
          }
        ]
      },
      {
        "id": "grammar-a2-parce-que-cause",
        "titleZh": "parce que：说明原因",
        "bodyZh": "parce que 后接带变位动词的句子，解释原因；元音前 que 可省音，如 parce qu’il。与 pour + 原形的目的表达区分。",
        "examples": [
          {
            "fr": "Je vous appelle parce que ma carte ne fonctionne pas.",
            "zh": "我给您打电话，因为我的卡不能使用。"
          }
        ]
      }
    ]
  },
  "blocks": [
    {
      "id": "scene-main",
      "type": "scene",
      "placeZh": "Camille 在家整理一次出行后的感受",
      "situationZh": "区分经历事实、个人评价和带理由的推荐。",
      "illustrationId": "art-home-morning"
    },
    {
      "id": "article-main",
      "type": "article",
      "titleZh": "评价一次体验",
      "narratorId": "character-camille",
      "paragraphs": [
        {
          "id": "entry-1",
          "segments": [
            {
              "id": "segment-1-1",
              "text": "Hier, Luc et moi avons passé une heure dans un petit café après notre promenade. Nous avons pris une boisson et parlé de notre semaine près de la fenêtre."
            }
          ],
          "translationZh": "昨天散步后，我和 Luc 在一家小咖啡馆待了一小时。我们在窗边喝饮品，聊这一周的事情。"
        },
        {
          "id": "entry-2",
          "segments": [
            {
              "id": "segment-2-1",
              "text": "À mon avis",
              "vocabularyId": "word-avis",
              "grammarId": "grammar-a2-personal-opinion"
            },
            {
              "id": "segment-2-2",
              "text": ", ce lieu est "
            },
            {
              "id": "segment-2-3",
              "text": "agréable",
              "vocabularyId": "word-agreable"
            },
            {
              "id": "segment-2-4",
              "text": " "
            },
            {
              "id": "segment-2-5",
              "text": "parce que",
              "grammarId": "grammar-a2-parce-que-cause"
            },
            {
              "id": "segment-2-6",
              "text": " les tables sont assez espacées. Je trouve aussi la lumière douce. Ce sont mes impressions, et Luc peut avoir un autre avis."
            }
          ],
          "translationZh": "依我看，这个地方很舒适，因为桌子间距比较大。我还觉得光线柔和。这些是我的感受，Luc 也可能有不同看法。"
        },
        {
          "id": "entry-3",
          "segments": [
            {
              "id": "segment-3-1",
              "text": "Le "
            },
            {
              "id": "segment-3-2",
              "text": "service",
              "vocabularyId": "word-service"
            },
            {
              "id": "segment-3-3",
              "text": " a été rapide pendant notre visite. La personne qui nous a accueillis a répondu à nos questions sur les boissons. J’ai trouvé son accueil chaleureux et son attitude "
            },
            {
              "id": "segment-3-4",
              "text": "accueillante",
              "vocabularyId": "word-accueillant"
            },
            {
              "id": "segment-3-5",
              "text": "."
            }
          ],
          "translationZh": "我们到访时，服务很快。接待我们的人回答了饮品问题。我觉得接待热情，态度友好。"
        },
        {
          "id": "entry-4",
          "segments": [
            {
              "id": "segment-4-1",
              "text": "Cependant, le café est devenu "
            },
            {
              "id": "segment-4-2",
              "text": "bruyant",
              "vocabularyId": "word-bruyant"
            },
            {
              "id": "segment-4-3",
              "text": " quand un groupe est entré. L’"
            },
            {
              "id": "segment-4-4",
              "text": "ambiance",
              "vocabularyId": "word-ambiance"
            },
            {
              "id": "segment-4-5",
              "text": " était animée, mais j’ai eu du mal à entendre Luc. Pour une conversation "
            },
            {
              "id": "segment-4-6",
              "text": "calme",
              "vocabularyId": "word-calme"
            },
            {
              "id": "segment-4-7",
              "text": ", je préfère un autre moment."
            }
          ],
          "translationZh": "不过，一群人进来后，咖啡馆变吵了。气氛热闹，但我不太听得清 Luc。想安静聊天时，我更喜欢换个时段。"
        },
        {
          "id": "entry-5",
          "segments": [
            {
              "id": "segment-5-1",
              "text": "Je peux "
            },
            {
              "id": "segment-5-2",
              "text": "recommander",
              "vocabularyId": "word-recommander"
            },
            {
              "id": "segment-5-3",
              "text": " ce café pour une courte pause, mais pas forcément pour lire longtemps. Mon avis dépend du moment de la visite et de ce que je souhaite faire."
            }
          ],
          "translationZh": "我可以推荐来这里短暂休息，但长时间阅读就未必适合。我的评价取决于到访时段和想做的事情。"
        },
        {
          "id": "entry-6",
          "segments": [
            {
              "id": "segment-6-1",
              "text": "Avant une prochaine sortie, je vais demander à Luc s’il préfère un endroit plus tranquille. Nous pouvons comparer nos impressions sans décider qu’une seule personne a raison."
            }
          ],
          "translationZh": "下次出门前，我会问 Luc 是否更喜欢安静一点的地方。我们可以比较感受，不必认定只有一个人的意见正确。"
        }
      ]
    },
    {
      "id": "explanation-main",
      "type": "explanation",
      "titleZh": "这句话如何使用",
      "bodyZh": "à mon avis 标明主观看法；parce que 后接说明原因的句子。a été、est devenu、était、j’ai eu 是叙述过去的支持表达；本课不系统讲授这些不规则变位。du mal à entendre 表示难以听清；pas forcément 是不一定。accueillis 指两位来访者，accueillante 与阴性 attitude 配合。",
      "targets": [
        {
          "blockId": "article-main",
          "entryId": "entry-2",
          "segmentId": "segment-2-1"
        },
        {
          "blockId": "article-main",
          "entryId": "entry-2",
          "segmentId": "segment-2-5"
        }
      ]
    },
    {
      "id": "culture-context",
      "type": "culture",
      "titleZh": "场景中的细节",
      "bodyZh": "这是一次虚构到访的个人感受，不代表店铺长期品质，也不概括法国咖啡馆。",
      "scopeZh": "本课虚构场景，不概括所有法语地区或个人的行为。"
    },
