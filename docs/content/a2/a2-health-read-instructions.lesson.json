    {
      "id": "exercise-comprehension",
      "type": "exercise",
      "exerciseType": "single-choice",
      "promptZh": "说明要求哪一部分表格留空？",
      "options": [
        {
          "id": "distractor-a",
          "text": "所有姓名栏"
        },
        {
          "id": "correct",
          "text": "诊所专用部分"
        },
        {
          "id": "distractor-b",
          "text": "整份表格"
        }
      ]
    },
    {
      "id": "exercise-fill",
      "type": "exercise",
      "exerciseType": "fill-blank",
      "promptZh": "根据提示补全句子。",
      "templateFr": "Ne remplissez ___ cette partie.",
      "hintZh": "否定指令用 ne + 命令式动词 + pas。"
    },
    {
      "id": "exercise-order",
      "type": "exercise",
      "exerciseType": "order",
      "promptZh": "把语块排成一句日常表达。",
      "tokens": [
        {
          "id": "token-3",
          "text": "après votre passage à l’accueil."
        },
        {
          "id": "token-1",
          "text": "Patientez"
        },
        {
          "id": "token-2",
          "text": "dans la salle d’attente"
        }
      ]
    },
    {
      "id": "habit-main",
      "type": "habit",
      "taskZh": "为虚构接待处写一条简单指令与一条否定指令，只描述办事流程。",
      "alternativeZh": "也可以只在心里构思或写一句虚构信息，不需要提供现实行为证明。"
    },
    {
      "id": "summary-main",
      "type": "summary",
      "takeawaysZh": [
        "我能识别面向 vous 的简单指令。",
        "我能理解否定指令。",
        "我能按文字确认接待流程。"
      ]
    }
  ],
