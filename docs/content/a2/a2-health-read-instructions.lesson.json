{
  "schemaVersion": "1.0",
  "id": "a2-health-read-instructions",
  "revision": 1,
  "levelId": "a2",
  "unitId": "a2-body-wellbeing",
  "title": {
    "fr": "À l’accueil du cabinet",
    "zh": "读懂接待处的简单指引"
  },
  "summaryZh": "阅读接待说明，找出等候地点、不应填写的区域和询问方式。",
  "estimatedMinutes": 16,
  "objectivesZh": [
    "识别面向 vous 的简单指令",
    "理解否定指令",
    "按文字确认接待流程"
  ],
  "knowledge": {
    "vocabulary": [
      {
        "id": "word-accueil",
        "lemma": "accueil",
        "partOfSpeech": "noun",
        "meaningZh": "接待处；接待",
        "noteZh": "搭配冠词学习 accueil。",
        "gender": "masculine"
      },
      {
        "id": "word-salle",
        "lemma": "salle",
        "partOfSpeech": "noun",
        "meaningZh": "房间；厅",
        "noteZh": "salle d’attente 表示等候室。",
        "gender": "feminine"
      },
      {
        "id": "word-attente",
        "lemma": "attente",
        "partOfSpeech": "noun",
        "meaningZh": "等待",
        "noteZh": "搭配冠词学习 attente。",
        "gender": "feminine"
      },
      {
        "id": "word-formulaire",
        "lemma": "formulaire",
        "partOfSpeech": "noun",
        "meaningZh": "表格",
        "noteZh": "搭配冠词学习 formulaire。",
        "gender": "masculine"
      },
      {
        "id": "word-document",
        "lemma": "document",
        "partOfSpeech": "noun",
        "meaningZh": "文件；资料",
        "noteZh": "搭配冠词学习 document。",
        "gender": "masculine"
      },
      {
        "id": "word-expliquer",
        "lemma": "expliquer",
        "partOfSpeech": "verb",
        "meaningZh": "解释；说明",
        "noteZh": "expliquer un problème 表示说明问题。"
      },
      {
        "id": "word-patienter",
        "lemma": "patienter",
        "partOfSpeech": "verb",
        "meaningZh": "耐心等待",
        "noteZh": "patientez 是本课面向 vous 的指令形式。"
      },
      {
        "id": "word-lire",
        "lemma": "lire",
        "partOfSpeech": "verb",
        "meaningZh": "阅读",
        "noteZh": "elle lit 表示她阅读。"
      }
    ],
    "grammar": [
      {
        "id": "grammar-a2-imperative-vous",
        "titleZh": "指令中的 vous 命令式",
        "bodyZh": "命令式没有显式主语。本课面向 vous，用 présentez、patientez 等形式给出步骤；不要在前面另加 vous。不是所有动词都能机械套用 -ez，特殊形式另学。",
        "examples": [
          {
            "fr": "Patientez dans la salle d’attente.",
            "zh": "请在等候室等待。"
          }
        ]
      },
      {
        "id": "grammar-a2-negative-imperative",
        "titleZh": "否定指令：ne…pas + 命令式",
        "bodyZh": "完整否定指令把 ne…pas 放在命令式动词两边。本课 Ne remplissez pas 表示不要填写；元音前 ne 省音为 n’。",
        "examples": [
          {
            "fr": "Ne remplissez pas cette partie.",
            "zh": "不要填写这一部分。"
          }
        ]
      }
    ]
  },
  "blocks": [
    {
      "id": "scene-main",
      "type": "scene",
      "placeZh": "虚构诊所的接待说明",
      "situationZh": "阅读接待说明，找出等候地点、不应填写的区域和询问方式。",
      "illustrationId": "art-clinic-reception"
    },
    {
      "id": "article-main",
      "type": "article",
      "titleZh": "读懂接待处的简单指引",
      "narratorId": "character-camille",
      "paragraphs": [
        {
          "id": "entry-1",
          "segments": [
            {
              "id": "segment-1-1",
              "text": "Camille arrive dans un cabinet pour un rendez-vous. À l’entrée, elle lit une fiche qui décrit l’organisation de l’"
            },
            {
              "id": "segment-1-2",
              "text": "accueil",
              "vocabularyId": "word-accueil"
            },
            {
              "id": "segment-1-3",
              "text": ". Il s’agit des consignes de ce lieu fictif."
            }
          ],
          "translationZh": "Camille 到诊所赴约。入口处，她读到一张介绍接待安排的说明纸。这些是该虚构地点的指引。"
        },
        {
          "id": "entry-2",
          "segments": [
            {
              "id": "segment-2-1",
              "text": "« "
            },
            {
              "id": "segment-2-2",
              "text": "Présentez-vous",
              "grammarId": "grammar-a2-imperative-vous"
            },
            {
              "id": "segment-2-3",
              "text": " à l’accueil et indiquez l’heure de votre rendez-vous. Gardez le message de confirmation pour retrouver les informations si une question reste peu claire. »"
            }
          ],
          "translationZh": "“请到接待处报到，说明预约时刻。保留确认消息，问题不清楚时便于找到信息。”"
        },
        {
          "id": "entry-3",
          "segments": [
            {
              "id": "segment-3-1",
              "text": "« "
            },
            {
              "id": "segment-3-2",
              "text": "Lisez",
              "vocabularyId": "word-lire"
            },
            {
              "id": "segment-3-3",
              "text": " les indications sur le "
            },
            {
              "id": "segment-3-4",
              "text": "formulaire",
              "vocabularyId": "word-formulaire"
            },
            {
              "id": "segment-3-5",
              "text": " avant d’écrire. "
            },
            {
              "id": "segment-3-6",
              "text": "Ne remplissez pas",
              "grammarId": "grammar-a2-negative-imperative"
            },
            {
              "id": "segment-3-7",
              "text": " la partie réservée au cabinet. Si vous ne comprenez pas un champ, demandez une explication à l’accueil. »"
            }
          ],
          "translationZh": "“填写前请读表格上的说明。不要填写诊所专用部分。如果不理解某一栏，请向接待处询问。”"
        },
        {
          "id": "entry-4",
          "segments": [
            {
              "id": "segment-4-1",
              "text": "« Les "
            },
            {
              "id": "segment-4-2",
              "text": "documents",
              "vocabularyId": "word-document"
            },
            {
              "id": "segment-4-3",
              "text": " demandés pour votre rendez-vous sont précisés dans votre message. Ne laissez pas un document personnel sur une table commune ; montrez-le à la personne qui vous accueille. »"
            }
          ],
          "translationZh": "“预约所需文件在消息中列明。不要把个人文件放在共用桌上；请出示给接待您的人。”"
        },
        {
          "id": "entry-5",
          "segments": [
            {
              "id": "segment-5-1",
              "text": "« "
            },
            {
              "id": "segment-5-2",
              "text": "Patientez",
              "vocabularyId": "word-patienter"
            },
            {
              "id": "segment-5-3",
              "text": " dans la "
            },
            {
              "id": "segment-5-4",
              "text": "salle",
              "vocabularyId": "word-salle"
            },
            {
              "id": "segment-5-5",
              "text": " d’"
            },
            {
              "id": "segment-5-6",
              "text": "attente",
              "vocabularyId": "word-attente"
            },
            {
              "id": "segment-5-7",
              "text": " après votre échange avec l’accueil. Un membre de l’équipe vient vous chercher. Si vous avez une question sur l’organisation, adressez-vous à l’accueil. »"
            }
          ],
          "translationZh": "“与接待处交谈后，请在等候室等待。工作人员会来找您。如果有接待安排方面的问题，请询问接待处。”"
        },
        {
          "id": "entry-6",
          "segments": [
            {
              "id": "segment-6-1",
              "text": "Camille vérifie le lieu d’attente et la partie du formulaire qu’elle doit laisser vide. Elle peut "
            },
            {
              "id": "segment-6-2",
              "text": "expliquer",
              "vocabularyId": "word-expliquer"
            },
            {
              "id": "segment-6-3",
              "text": " ce qu’elle ne comprend pas au lieu de remplir le document au hasard."
            }
          ],
          "translationZh": "Camille 核对等候地点，以及应留空的表格部分。她可以说明不理解的地方，不随意填写。"
        }
      ]
    },
    {
      "id": "explanation-main",
      "type": "explanation",
      "titleZh": "这句话如何使用",
      "bodyZh": "présentez、patientez 为面向 vous 的命令式，句子不写显式主语 vous；Présentez-vous 中 vous 是反身代词。Lisez 是 lire 的命令式，不是简单把词尾换成 -ez。Ne remplissez pas、Ne laissez pas 是否定指令；本课只讨论接待和填表，不把流程当成医疗指引。",
      "targets": [
        {
          "blockId": "article-main",
          "entryId": "entry-2",
          "segmentId": "segment-2-2"
        },
        {
          "blockId": "article-main",
          "entryId": "entry-3",
          "segmentId": "segment-3-6"
        }
      ]
    },
    {
      "id": "culture-context",
      "type": "culture",
      "titleZh": "场景中的细节",
      "bodyZh": "接待处、表格区域、文件与等候安排是虚构场景，不说明所有诊所的流程，也不提供医学判断或处理建议。",
      "scopeZh": "本课虚构场景，不概括所有法语地区或个人的行为。"
    },
    {
      "id": "vocabulary-targets",
      "type": "vocabulary",
      "entryIds": [
        "word-accueil",
        "word-salle",
        "word-attente",
