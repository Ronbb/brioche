{
  "schemaVersion": "1.0",
  "id": "a2-travel-buy-return-ticket",
  "revision": 1,
  "levelId": "a2",
  "unitId": "a2-weekend-travel",
  "title": {
    "fr": "Un aller-retour pour Lyon",
    "zh": "购买城际往返票"
  },
  "summaryZh": "把去程、回程、是否换乘和座位需求说清楚。",
  "estimatedMinutes": 16,
  "objectivesZh": [
    "区分单程与往返",
    "核对去程回程日期时刻",
    "询问直达与座位"
  ],
  "knowledge": {
    "vocabulary": [
      {
        "id": "word-aller-retour",
        "lemma": "aller-retour",
        "partOfSpeech": "noun",
        "meaningZh": "往返票；往返",
        "noteZh": "搭配冠词学习 aller-retour。",
        "gender": "masculine"
      },
      {
        "id": "expr-aller-simple",
        "lemma": "aller simple",
        "partOfSpeech": "phrase",
        "meaningZh": "单程票",
        "noteZh": "与 aller-retour 相对，购票时要明确票程。"
      },
      {
        "id": "word-depart",
        "lemma": "départ",
        "partOfSpeech": "noun",
        "meaningZh": "出发",
        "noteZh": "le départ 指发车或离开的时刻。",
        "gender": "masculine"
      },
      {
        "id": "word-retour",
        "lemma": "retour",
        "partOfSpeech": "noun",
        "meaningZh": "返程；返回",
        "noteZh": "搭配冠词学习 retour。",
        "gender": "masculine"
      },
      {
        "id": "word-correspondance",
        "lemma": "correspondance",
        "partOfSpeech": "noun",
        "meaningZh": "换乘",
        "noteZh": "搭配冠词学习 correspondance。",
        "gender": "feminine"
      },
      {
        "id": "word-direct",
        "lemma": "direct",
        "partOfSpeech": "adjective",
        "meaningZh": "直达的",
        "noteZh": "un train direct 中与阳性单数 train 配合。"
      },
      {
        "id": "word-place",
        "lemma": "place",
        "partOfSpeech": "noun",
        "meaningZh": "座位；位置",
        "noteZh": "搭配冠词学习 place。",
        "gender": "feminine"
      },
      {
        "id": "word-reserver",
        "lemma": "réserver",
        "partOfSpeech": "verb",
        "meaningZh": "预订",
        "noteZh": "本单元 réserver une chambre 表示预订客房。"
      }
    ],
    "grammar": [
      {
        "id": "grammar-a2-aller-retour",
        "titleZh": "un aller simple / un aller-retour：明确票程",
        "bodyZh": "un aller simple 表示单程票；un aller-retour 表示往返票。这是票程词汇搭配，不是动词 aller 的变位。往返要进一步确认去程与回程日期时刻。",
        "examples": [
          {
            "fr": "Je voudrais un aller-retour pour Lyon.",
            "zh": "我想要一张去里昂的往返票。"
          }
        ]
      },
      {
        "id": "grammar-time-a",
        "titleZh": "à + 时刻：说明发生时间",
        "bodyZh": "Le train part à neuf heures dix 说明列车九点十分发车。à 引出事件发生的时刻。",
        "examples": [
          {
            "fr": "Le train part à neuf heures dix.",
            "zh": "列车九点十分发车。"
          }
        ]
      }
    ]
  },
  "blocks": [
    {
      "id": "scene-main",
      "type": "scene",
      "placeZh": "虚构车站的售票窗口",
      "situationZh": "把去程、回程、是否换乘和座位需求说清楚。",
      "illustrationId": "art-city-morning"
    },
    {
      "id": "dialogue-main",
      "type": "dialogue",
      "titleZh": "购买城际往返票",
      "speakers": [
        {
          "id": "speaker-1",
          "labelZh": "购买车票的旅客",
          "characterId": "character-camille",
          "displayName": "Camille",
          "avatarId": "avatar-camille-v1"
        },
        {
          "id": "speaker-2",
          "labelZh": "售票员",
          "characterId": "character-luc",
          "displayName": "Luc",
          "avatarId": "avatar-luc-v1"
        }
      ],
      "turns": [
        {
          "id": "entry-1",
          "speakerId": "speaker-1",
          "segments": [
            {
              "id": "segment-1-1",
              "text": "Bonjour, je voudrais un "
            },
            {
              "id": "segment-1-2",
              "text": "aller-retour",
              "vocabularyId": "word-aller-retour",
              "grammarId": "grammar-a2-aller-retour"
            },
            {
              "id": "segment-1-3",
              "text": " pour Lyon. Je vais partir samedi matin et revenir dimanche soir. Quels horaires pouvez-vous me proposer ?"
            }
          ],
          "translationZh": "您好，我想买一张去里昂的往返票。我打算星期六上午出发、星期日晚上返回。您可以提供哪些时刻？"
        },
        {
          "id": "entry-2",
          "speakerId": "speaker-2",
          "segments": [
            {
              "id": "segment-2-1",
              "text": "Bonjour. Pour le "
            },
            {
              "id": "segment-2-2",
              "text": "départ",
              "vocabularyId": "word-depart"
            },
            {
              "id": "segment-2-3",
              "text": " samedi, nous avons un train "
            },
            {
              "id": "segment-2-4",
              "text": "à neuf heures",
              "grammarId": "grammar-time-a"
            },
            {
              "id": "segment-2-5",
              "text": " et un autre à dix heures trente. Quel horaire préférez-vous ?"
            }
          ],
          "translationZh": "您好。星期六去程有九点和十点半两班车。您更喜欢哪个时刻？"
        },
        {
          "id": "entry-3",
          "speakerId": "speaker-1",
          "segments": [
            {
              "id": "segment-3-1",
              "text": "Je préfère le train de neuf heures. Est-ce un train "
            },
            {
              "id": "segment-3-2",
              "text": "direct",
              "vocabularyId": "word-direct"
            },
            {
              "id": "segment-3-3",
              "text": ", ou est-ce que je dois changer de train pendant le trajet ?"
            }
          ],
          "translationZh": "我更喜欢九点那班。它是直达车吗，还是途中需要换乘？"
        },
        {
          "id": "entry-4",
          "speakerId": "speaker-2",
          "segments": [
            {
              "id": "segment-4-1",
              "text": "C’est un train direct, sans "
            },
            {
              "id": "segment-4-2",
              "text": "correspondance",
              "vocabularyId": "word-correspondance"
            },
            {
              "id": "segment-4-3",
              "text": ". Pour le "
            },
            {
              "id": "segment-4-4",
              "text": "retour",
              "vocabularyId": "word-retour"
            },
            {
              "id": "segment-4-5",
              "text": " dimanche, le train de dix-neuf heures arrive ici à vingt et une heures."
            }
          ],
          "translationZh": "这是直达车，不需要换乘。星期日回程的十九点班次会在二十一点到达这里。"
        },
        {
          "id": "entry-5",
          "speakerId": "speaker-1",
          "segments": [
            {
              "id": "segment-5-1",
              "text": "Cela me convient. Je voudrais aussi "
            },
            {
              "id": "segment-5-2",
              "text": "réserver",
              "vocabularyId": "word-reserver"
            },
            {
              "id": "segment-5-3",
              "text": " une "
            },
            {
              "id": "segment-5-4",
              "text": "place",
              "vocabularyId": "word-place"
            },
            {
              "id": "segment-5-5",
              "text": " assise. Le prix annoncé comprend-il les deux trajets et la réservation de la place ?"
            }
          ],
          "translationZh": "这个安排适合我。我还想预订一个座位。所报价格包含两个行程和座位预订吗？"
        },
        {
          "id": "entry-6",
          "speakerId": "speaker-2",
          "segments": [
            {
              "id": "segment-6-1",
              "text": "Oui, le total est de soixante euros pour cet aller-retour, avec une place réservée sur chaque train. Un "
            },
            {
              "id": "segment-6-2",
              "text": "aller simple",
              "vocabularyId": "expr-aller-simple"
            },
            {
              "id": "segment-6-3",
              "text": " coûte trente euros dans cet exemple."
            }
          ],
          "translationZh": "是的，本次往返共六十欧元，每班车都有预订座位。在这个例子中，单程票三十欧元。"
        },
        {
          "id": "entry-7",
          "speakerId": "speaker-1",
          "segments": [
            {
              "id": "segment-7-1",
              "text": "D’accord. Je confirme le départ samedi à neuf heures et le retour dimanche à dix-neuf heures. Pouvez-vous imprimer les informations avec les billets ?"
            }
          ],
          "translationZh": "好的。我确认星期六九点去程和星期日十九点回程。您可以把行程信息随车票一起打印吗？"
        },
        {
          "id": "entry-8",
          "speakerId": "speaker-2",
          "segments": [
            {
              "id": "segment-8-1",
              "text": "Bien sûr. Voici les billets et les horaires. Vérifiez la destination et les dates avant de partir, puis regardez les écrans pour trouver votre quai."
            }
          ],
          "translationZh": "当然。这是车票和时刻信息。出发前请核对目的地和日期，然后查看显示屏寻找站台。"
        }
      ]
    },
    {
      "id": "explanation-main",
      "type": "explanation",
      "titleZh": "这句话如何使用",
      "bodyZh": "un aller-retour 是往返票，不能把其中 aller 当作 nous allons 的动词形式。à neuf heures 和 à dix-neuf heures 分别是去程与回程出发时间；二十一点是回程到达时间。comprend-il 是正式询问形式，本课先按“是否包含”的语块理解。",
      "targets": [
        {
          "blockId": "dialogue-main",
          "entryId": "entry-1",
          "segmentId": "segment-1-2"
        },
        {
          "blockId": "dialogue-main",
          "entryId": "entry-2",
          "segmentId": "segment-2-4"
        }
      ]
    },
    {
      "id": "culture-context",
      "type": "culture",
      "titleZh": "场景中的细节",
      "bodyZh": "班次、直达、价格、打印票和预订座位均是虚构售票情境，不代表任何铁路公司的票制或真实运行时刻；真实旅程须核对运营方票面和实时屏幕。",
      "scopeZh": "本课虚构场景，不概括所有法语地区或个人的行为。"
    },
    {
      "id": "vocabulary-targets",
      "type": "vocabulary",
      "entryIds": [
        "word-aller-retour",
        "expr-aller-simple",
        "word-depart",
