        },
        {
          "id": "correct",
          "text": "十九点"
        },
        {
          "id": "distractor-b",
          "text": "二十一点"
        }
      ]
    },
    {
      "id": "exercise-fill",
      "type": "exercise",
      "exerciseType": "fill-blank",
      "promptZh": "根据提示补全句子。",
      "templateFr": "Je voudrais un aller-___ pour Lyon.",
      "hintZh": "aller-retour 表示往返；aller simple 表示单程。"
    },
    {
      "id": "exercise-order",
      "type": "exercise",
