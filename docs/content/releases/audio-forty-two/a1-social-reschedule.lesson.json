  "blocks": [
    {
      "id": "scene-main",
      "illustrationId": "art-park-meeting",
      "placeZh": "两位朋友调整虚构电影院约见",
      "situationZh": "说明当天不能参加，并确认另一个见面时间。",
      "type": "scene"
    },
    {
      "id": "dialogue-main",
      "speakers": [
        {
          "avatarId": "avatar-camille-v1",
          "characterId": "character-camille",
          "displayName": "Camille",
          "id": "speaker-1",
          "labelZh": "朋友"
        },
        {
          "avatarId": "avatar-lea-v1",
          "characterId": "character-lea",
          "displayName": "Léa",
          "id": "speaker-2",
          "labelZh": "朋友"
        }
      ],
      "titleZh": "拒绝并提出新的时间",
      "turns": [
        {
          "id": "entry-1",
          "segments": [
            {
              "id": "segment-1-1",
              "text": "Tu "
            },
            {
              "grammarId": "grammar-pouvoir-invite",
              "id": "segment-1-2",
              "text": "peux",
              "vocabularyId": "word-pouvoir"
            },
            {
              "id": "segment-1-3",
              "text": " venir "
            },
            {
              "id": "segment-1-4",
              "text": "dimanche",
              "vocabularyId": "word-dimanche"
            },
            {
              "id": "segment-1-5",
              "text": " ?"
            }
          ],
          "speakerId": "speaker-1",
          "translationZh": "你星期日能来吗？"
        },
        {
          "id": "entry-2",
          "segments": [
            {
              "id": "segment-2-1",
              "text": "Désolée",
              "vocabularyId": "expr-desolee"
            },
            {
              "id": "segment-2-2",
              "text": ", je ne "
            },
            {
              "grammarId": "grammar-ne-peux-pas",
              "id": "segment-2-3",
              "text": "peux",
              "vocabularyId": "word-pouvoir"
            },
            {
              "id": "segment-2-4",
              "text": " pas. Je travaille."
            }
          ],
          "speakerId": "speaker-2",
          "translationZh": "抱歉，我不能来。我那天工作。"
        },
        {
          "id": "entry-3",
          "segments": [
            {
              "id": "segment-3-1",
              "text": "Pas de problème",
              "vocabularyId": "expr-pas-de-probleme"
            },
            {
              "id": "segment-3-2",
              "text": ". Et "
            },
            {
              "id": "segment-3-3",
              "text": "lundi",
              "vocabularyId": "word-lundi"
            },
            {
              "id": "segment-3-4",
              "text": " ?"
            }
          ],
          "speakerId": "speaker-1",
          "translationZh": "没问题。那星期一呢？"
        },
        {
          "id": "entry-4",
          "segments": [
            {
              "id": "segment-4-1",
              "text": "Lundi",
              "vocabularyId": "word-lundi"
            },
            {
              "id": "segment-4-2",
              "text": ", je suis "
            },
            {
              "id": "segment-4-3",
              "text": "libre",
              "vocabularyId": "word-libre"
            },
            {
              "id": "segment-4-4",
              "text": " "
            },
            {
              "id": "segment-4-5",
              "text": "après",
              "vocabularyId": "word-apres"
            },
            {
              "id": "segment-4-6",
              "text": " "
            },
            {
              "id": "segment-4-7",
              "text": "dix-huit",
              "vocabularyId": "word-dix-huit"
            },
            {
              "id": "segment-4-8",
              "text": " heures."
            }
          ],
          "speakerId": "speaker-2",
          "translationZh": "星期一，我下午六点以后有空。"
        },
        {
          "id": "entry-5",
          "segments": [
            {
              "id": "segment-5-1",
              "text": "On "
            },
            {
              "grammarId": "grammar-pouvoir-invite",
              "id": "segment-5-2",
              "text": "peut",
              "vocabularyId": "word-pouvoir"
            },
            {
              "id": "segment-5-3",
              "text": " se retrouver à "
            },
            {
              "id": "segment-5-4",
              "text": "dix-huit",
              "vocabularyId": "word-dix-huit"
            },
            {
              "id": "segment-5-5",
              "text": " heures trente ?"
            }
          ],
          "speakerId": "speaker-1",
          "translationZh": "我们可以在下午六点半碰面吗？"
        },
        {
          "id": "entry-6",
          "segments": [
            {
              "id": "segment-6-1",
              "text": "Oui. Devant le cinéma ?"
            }
          ],
          "speakerId": "speaker-2",
          "translationZh": "可以。在电影院前面吗？"
        },
        {
          "id": "entry-7",
          "segments": [
            {
              "id": "segment-7-1",
              "text": "D’accord. À "
            },
            {
              "id": "segment-7-2",
              "text": "lundi",
              "vocabularyId": "word-lundi"
            },
            {
              "id": "segment-7-3",
              "text": " !"
            }
          ],
          "speakerId": "speaker-1",
          "translationZh": "好的。星期一见！"
        },
        {
          "id": "entry-8",
          "segments": [
            {
              "id": "segment-8-1",
              "text": "À "
            },
            {
              "id": "segment-8-2",
              "text": "lundi",
              "vocabularyId": "word-lundi"
            },
            {
              "id": "segment-8-3",
              "text": " !"
            }
          ],
          "speakerId": "speaker-2",
          "translationZh": "星期一见！"
        }
      ],
      "type": "dialogue"
    },
    {
      "bodyZh": "je ne peux pas 是完整否定，peux 是 pouvoir 的第一人称形式。对方先接受这个情况，再提出星期一。après dix-huit heures 是十八点之后，最终约定 dix-huit heures trente，即下午六点半。本课 se retrouver 作为“碰面”的常用搭配理解。",
