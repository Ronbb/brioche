  "knowledge": {
    "grammar": [
      {
        "bodyZh": "pouvoir 的第一人称现在时是 peux。完整否定把 ne 和 pas 放在它两边：je ne peux pas venir。venir 保留原形；可以再说一个简单原因或提出新的时间。",
        "examples": [
          {
            "fr": "Je ne peux pas venir dimanche.",
            "recording": {
              "asset": {
                "assetId": "speech-c30ea1cef266ae3fcca35402822350a0600f3cc22f2d9ccbde0f9c04dbf60355",
                "creditZh": "Brioche 原创课程，Qwen 合成语音",
                "durationMs": 1600,
                "mimeType": "audio/wav",
                "revision": 1,
                "sha256": "63ca01cb339f83de7eec607c2a337d8e4fc9a8db211ac988de7d1275c4775636",
                "url": "/api/audio/63ca01cb339f83de7eec607c2a337d8e4fc9a8db211ac988de7d1275c4775636.wav"
              },
              "endMs": 1600,
              "startMs": 0
            },
            "zh": "我星期日不能来。"
          }
        ],
        "id": "grammar-ne-peux-pas",
        "titleZh": "Je ne peux pas：说明不能参加"
      },
      {
        "bodyZh": "本课 je peux、tu peux、on peut 后接动词原形。口语中 on 可表示“我们”，但动词仍用第三人称单数 peut。On peut prendre un café ? 用来提议一起喝咖啡。",
        "examples": [
          {
            "fr": "On peut prendre un café ensemble ?",
            "recording": {
              "asset": {
                "assetId": "speech-8b15988f6bcba4b1e1671c33de0b4b70c63f8ebd6bf39823832ad99fb9bc1ef4",
                "creditZh": "Brioche 原创课程，Qwen 合成语音",
                "durationMs": 1920,
                "mimeType": "audio/wav",
                "revision": 1,
                "sha256": "08decfc96223c7efadae538512823649aa0cd4c1289c4709f6e4755bb596d246",
                "url": "/api/audio/08decfc96223c7efadae538512823649aa0cd4c1289c4709f6e4755bb596d246.wav"
              },
              "endMs": 1920,
              "startMs": 0
            },
            "zh": "我们可以一起喝杯咖啡吗？"
          }
        ],
        "id": "grammar-pouvoir-invite",
        "titleZh": "pouvoir + 动词原形：提出安排"
      }
