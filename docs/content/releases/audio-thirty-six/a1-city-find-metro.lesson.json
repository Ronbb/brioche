        {
          "id": "entry-7",
          "segments": [
            {
              "id": "segment-7-1",
              "text": "Merci beaucoup."
            }
          ],
          "speakerId": "speaker-1",
          "translationZh": "非常感谢。"
        },
        {
          "id": "entry-8",
          "segments": [
            {
              "id": "segment-8-1",
              "text": "De rien."
            }
          ],
          "speakerId": "speaker-2",
          "translationZh": "不客气。"
