            },
            {
              "id": "segment-2-4",
              "text": "."
            }
          ],
          "speakerId": "speaker-2",
          "translationZh": "直走，然后向左。"
        },
        {
          "id": "entry-3",
          "segments": [
            {
              "id": "segment-3-2",
              "text": "L’entrée",
              "vocabularyId": "word-entree"
            },
            {
              "id": "segment-3-3",
              "text": " est "
