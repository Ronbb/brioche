  "blocks": [
    {
      "id": "scene-main",
      "illustrationId": "art-cafe-lunch",
      "placeZh": "虚构餐馆的午餐服务",
      "situationZh": "说明用餐人数，表达对蔬菜的喜好，并选择餐点和饮品。",
      "type": "scene"
    },
    {
      "id": "dialogue-main",
      "speakers": [
        {
          "avatarId": "avatar-camille-v1",
          "characterId": "character-camille",
          "displayName": "Camille",
          "id": "speaker-1",
          "labelZh": "顾客"
        },
        {
          "avatarId": "avatar-luc-v1",
          "characterId": "character-luc",
          "displayName": "Luc",
          "id": "speaker-2",
          "labelZh": "餐馆服务员"
        }
      ],
      "titleZh": "看菜单并点餐",
      "turns": [
        {
          "id": "entry-1",
          "segments": [
            {
              "id": "segment-1-1",
              "text": "Bonjour. Une table "
            },
            {
              "grammarId": "grammar-table-pour",
              "id": "segment-1-2",
              "text": "pour"
            },
            {
              "id": "segment-1-3",
              "text": " une "
            },
            {
              "id": "segment-1-4",
              "text": "personne",
              "vocabularyId": "word-personne"
            },
            {
              "id": "segment-1-5",
              "text": ", s’il vous plaît."
            }
          ],
          "speakerId": "speaker-1",
          "translationZh": "您好。请给我一张一人用餐的桌子。"
        },
        {
          "id": "entry-2",
          "segments": [
            {
              "id": "segment-2-1",
              "text": "Bonjour. Voici la "
            },
            {
              "id": "segment-2-2",
              "text": "carte",
              "vocabularyId": "word-menu-carte"
            },
            {
              "id": "segment-2-3",
              "text": "."
            }
          ],
          "speakerId": "speaker-2",
          "translationZh": "您好。这是菜单。"
        },
        {
          "id": "entry-3",
          "segments": [
            {
              "grammarId": "grammar-aimer-food",
              "id": "segment-3-1",
              "text": "J’aime"
            },
            {
              "id": "segment-3-2",
              "text": " les "
            },
            {
              "id": "segment-3-3",
              "text": "légumes",
              "vocabularyId": "word-legume"
            },
            {
              "id": "segment-3-4",
              "text": ". Vous avez un "
            },
            {
              "id": "segment-3-5",
              "text": "plat",
              "vocabularyId": "word-plat"
            },
            {
              "id": "segment-3-6",
              "text": " avec des "
            },
            {
              "id": "segment-3-7",
              "text": "légumes",
              "vocabularyId": "word-legume"
            },
            {
              "id": "segment-3-8",
              "text": " ?"
            }
          ],
          "speakerId": "speaker-1",
          "translationZh": "我喜欢蔬菜。你们有蔬菜做的菜吗？"
        },
        {
          "id": "entry-4",
          "segments": [
            {
              "id": "segment-4-1",
              "text": "Oui, nous avons une "
            },
            {
              "id": "segment-4-2",
              "text": "soupe",
              "vocabularyId": "word-soupe"
            },
            {
              "id": "segment-4-3",
              "text": " de "
            },
            {
              "id": "segment-4-4",
              "text": "légumes",
              "vocabularyId": "word-legume"
            },
            {
              "id": "segment-4-5",
              "text": " et une "
            },
            {
              "id": "segment-4-6",
              "text": "salade",
              "vocabularyId": "word-salade"
            },
            {
              "id": "segment-4-7",
              "text": "."
            }
          ],
          "speakerId": "speaker-2",
          "translationZh": "有，我们有蔬菜汤和沙拉。"
        },
        {
          "id": "entry-5",
          "segments": [
            {
              "id": "segment-5-1",
              "text": "Je voudrais une "
            },
            {
              "id": "segment-5-2",
              "text": "salade",
              "vocabularyId": "word-salade"
            },
            {
              "id": "segment-5-3",
              "text": " et du pain."
            }
          ],
          "speakerId": "speaker-1",
          "translationZh": "我想要一份沙拉和一些面包。"
        },
        {
          "id": "entry-6",
          "segments": [
            {
              "id": "segment-6-1",
              "text": "Et comme "
            },
            {
              "id": "segment-6-2",
              "text": "boisson",
              "vocabularyId": "word-boisson"
            },
            {
              "id": "segment-6-3",
              "text": " ?"
            }
          ],
          "speakerId": "speaker-2",
          "translationZh": "那饮品呢？"
        },
        {
          "id": "entry-7",
          "segments": [
            {
              "id": "segment-7-1",
              "text": "De "
            },
            {
              "id": "segment-7-2",
              "text": "l’eau",
              "vocabularyId": "word-eau"
            },
            {
              "id": "segment-7-3",
              "text": ", s’il vous plaît."
            }
          ],
          "speakerId": "speaker-1",
          "translationZh": "请给我一些水。"
        },
        {
          "id": "entry-8",
          "segments": [
            {
              "id": "segment-8-1",
              "text": "Très bien."
            }
          ],
          "speakerId": "speaker-2",
          "translationZh": "好的。"
        }
      ],
      "type": "dialogue"
    },
    {
      "bodyZh": "pour une personne 说明一人用餐。这里的 la carte 是菜单；J’aime les légumes 表达对蔬菜的喜好，后面接定冠词 les。Et comme boisson ? 在点餐中询问饮品。de l’eau 是不指定精确数量的水；eau 以元音开头。",
      "id": "explanation-main",
