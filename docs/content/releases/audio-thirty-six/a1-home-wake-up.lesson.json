  "blocks": [
    {
      "id": "scene-main",
      "illustrationId": "art-home-morning",
      "placeZh": "Camille 在家的一天早晨",
      "situationZh": "读懂一段早晨安排，分清起床、早餐和出门的时间。",
      "type": "scene"
    },
    {
      "id": "article-main",
      "narratorId": "character-camille",
      "paragraphs": [
        {
          "id": "entry-1",
          "segments": [
            {
              "id": "segment-1-1",
              "text": "Le "
            },
            {
              "id": "segment-1-2",
              "text": "matin",
              "vocabularyId": "word-matin"
            },
            {
              "id": "segment-1-3",
              "text": ", Camille "
            },
            {
              "grammarId": "grammar-se-lever-present",
              "id": "segment-1-4",
              "text": "se lève",
              "vocabularyId": "word-se-lever"
            },
            {
              "id": "segment-1-5",
              "text": " à "
            },
            {
              "id": "segment-1-6",
              "text": "sept",
              "vocabularyId": "word-sept"
            },
            {
              "id": "segment-1-7",
              "text": " "
            },
            {
              "grammarId": "grammar-time-a",
              "id": "segment-1-8",
              "text": "heures",
              "vocabularyId": "word-heure"
            },
            {
              "id": "segment-1-9",
              "text": "."
            }
          ],
          "translationZh": "早晨，Camille 七点起床。"
        },
        {
          "id": "entry-2",
          "segments": [
            {
              "id": "segment-2-1",
              "text": "Elle ouvre la fenêtre et regarde le ciel."
            }
          ],
          "translationZh": "她打开窗户，看看天空。"
        },
        {
          "id": "entry-3",
          "segments": [
            {
              "id": "segment-3-1",
              "text": "Elle prend une "
            },
            {
              "id": "segment-3-2",
              "text": "douche",
              "vocabularyId": "word-douche"
            },
            {
              "id": "segment-3-3",
              "text": ", puis elle s’habille."
            }
          ],
          "translationZh": "她洗淋浴，然后穿衣服。"
        },
        {
          "id": "entry-4",
          "segments": [
            {
              "id": "segment-4-1",
              "text": "À "
            },
            {
              "id": "segment-4-2",
              "text": "sept",
              "vocabularyId": "word-sept"
            },
            {
              "id": "segment-4-3",
              "text": " "
            },
            {
              "grammarId": "grammar-time-a",
              "id": "segment-4-4",
              "text": "heures",
              "vocabularyId": "word-heure"
            },
            {
              "id": "segment-4-5",
              "text": " "
            },
            {
              "id": "segment-4-6",
              "text": "trente",
              "vocabularyId": "word-trente"
            },
            {
              "id": "segment-4-7",
              "text": ", elle "
            },
            {
              "id": "segment-4-8",
              "text": "prépare",
              "vocabularyId": "word-preparer"
            },
            {
              "id": "segment-4-9",
              "text": " son petit-déjeuner."
            }
          ],
          "translationZh": "七点半，她准备早餐。"
        },
        {
          "id": "entry-5",
          "segments": [
            {
              "id": "segment-5-1",
              "text": "Elle mange du pain et boit un café dans la cuisine."
            }
          ],
          "translationZh": "她在厨房吃面包、喝咖啡。"
        },
        {
          "id": "entry-6",
          "segments": [
            {
              "id": "segment-6-1",
              "text": "Elle regarde "
            },
            {
              "id": "segment-6-2",
              "text": "l’heure",
              "vocabularyId": "word-heure"
            },
            {
              "id": "segment-6-3",
              "text": " sur son téléphone."
            }
          ],
          "translationZh": "她在手机上看时间。"
        },
        {
          "id": "entry-7",
          "segments": [
            {
              "id": "segment-7-1",
              "text": "À "
            },
            {
              "id": "segment-7-2",
              "text": "huit",
              "vocabularyId": "word-huit"
            },
            {
              "id": "segment-7-3",
              "text": " "
            },
            {
              "grammarId": "grammar-time-a",
              "id": "segment-7-4",
              "text": "heures",
              "vocabularyId": "word-heure"
            },
            {
              "id": "segment-7-5",
              "text": ", elle part de chez elle pour aller à l’université."
            }
          ],
          "translationZh": "八点，她离开家去大学。"
        }
      ],
      "titleZh": "说说起床时间",
      "type": "article"
    },
    {
      "bodyZh": "à 引出事情发生的时刻：à sept heures 是七点，à sept heures trente 是七点半。短文中 elle se lève 说她起床；换成自己时用 je me lève。puis 表示“然后”，帮助串起早晨的动作。",
      "id": "explanation-main",
      "targets": [
        {
          "blockId": "article-main",
          "entryId": "entry-1",
