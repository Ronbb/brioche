  "blocks": [
    {
      "id": "scene-main",
      "illustrationId": "art-fruit-market",
      "placeZh": "Camille 按清单购买午餐食材",
      "situationZh": "从购物短文中辨认食材、数量表达和个人喜好。",
      "type": "scene"
    },
    {
      "id": "article-main",
      "narratorId": "character-camille",
      "paragraphs": [
        {
          "id": "entry-1",
          "segments": [
            {
              "id": "segment-1-1",
              "text": "Camille va au "
            },
            {
              "id": "segment-1-2",
              "text": "supermarché",
              "vocabularyId": "word-supermarche"
            },
            {
              "id": "segment-1-3",
              "text": " pour préparer le déjeuner."
            }
          ],
          "translationZh": "Camille 去超市购买食材，准备午餐。"
        },
        {
          "id": "entry-2",
          "segments": [
            {
              "id": "segment-2-1",
              "text": "Dans son sac, elle a une "
            },
            {
              "id": "segment-2-2",
              "text": "liste",
              "vocabularyId": "word-liste"
            },
            {
              "id": "segment-2-3",
              "text": " et un petit carnet."
            }
          ],
          "translationZh": "她的包里有一张清单和一个小本子。"
        },
        {
          "id": "entry-3",
          "segments": [
            {
              "id": "segment-3-1",
              "text": "Elle achète "
            },
            {
              "grammarId": "grammar-food-partitive",
              "id": "segment-3-2",
              "text": "du"
            },
            {
              "id": "segment-3-3",
              "text": " "
            },
            {
              "id": "segment-3-4",
              "text": "riz",
              "vocabularyId": "word-riz"
            },
            {
              "id": "segment-3-5",
              "text": ", "
            },
            {
              "grammarId": "grammar-food-partitive",
              "id": "segment-3-6",
              "text": "des"
            },
            {
              "id": "segment-3-7",
              "text": " "
            },
            {
              "id": "segment-3-8",
              "text": "tomates",
              "vocabularyId": "word-tomate"
            },
            {
              "id": "segment-3-9",
              "text": " et une "
            },
            {
              "id": "segment-3-10",
              "text": "bouteille",
              "vocabularyId": "word-bouteille"
            },
            {
              "id": "segment-3-11",
              "text": " "
            },
            {
              "id": "segment-3-12",
              "text": "d’eau",
              "vocabularyId": "word-eau"
            },
            {
              "id": "segment-3-13",
              "text": "."
            }
          ],
          "translationZh": "她买一些米、西红柿和一瓶水。"
        },
        {
          "id": "entry-4",
          "segments": [
            {
              "id": "segment-4-1",
              "text": "Elle "
            },
            {
              "grammarId": "grammar-aimer-food",
              "id": "segment-4-2",
              "text": "aime",
              "vocabularyId": "word-aimer"
            },
            {
              "id": "segment-4-3",
              "text": " les "
            },
            {
              "id": "segment-4-4",
              "text": "tomates",
              "vocabularyId": "word-tomate"
            },
            {
              "id": "segment-4-5",
              "text": ", mais elle "
            },
            {
              "grammarId": "grammar-aimer-food",
              "id": "segment-4-6",
              "text": "n’aime pas",
              "vocabularyId": "word-aimer"
            },
            {
              "id": "segment-4-7",
              "text": " le "
            },
            {
              "id": "segment-4-8",
              "text": "fromage",
              "vocabularyId": "word-fromage"
            },
            {
              "id": "segment-4-9",
              "text": "."
            }
          ],
          "translationZh": "她喜欢西红柿，但不喜欢奶酪。"
        },
        {
          "id": "entry-5",
          "segments": [
            {
              "id": "segment-5-1",
              "text": "Elle regarde les prix avant de choisir les produits."
            }
          ],
          "translationZh": "她挑选商品前先看看价格。"
        },
        {
          "id": "entry-6",
          "segments": [
            {
              "id": "segment-6-1",
              "text": "À la caisse, elle pose les courses sur le tapis."
            }
          ],
          "translationZh": "在收银处，她把购买的东西放到传送带上。"
        },
        {
          "id": "entry-7",
          "segments": [
            {
              "id": "segment-7-1",
              "text": "Elle paie par carte, puis elle rentre à la maison."
            }
          ],
          "translationZh": "她用银行卡付款，然后回家。"
        }
      ],
      "titleZh": "读懂一张购物清单",
      "type": "article"
    },
    {
      "bodyZh": "du riz 表示不指定精确数量的米；des tomates 表示若干西红柿。une bouteille d’eau 已有瓶数，所以用 d’eau。泛指喜欢食物用定冠词，elle aime les tomates；否定写 elle n’aime pas le fromage。la caisse 是收银处，le tapis 在这里是收银传送带。",
      "id": "explanation-main",
      "targets": [
        {
          "blockId": "article-main",
          "entryId": "entry-3",
          "segmentId": "segment-3-2"
        },
        {
          "blockId": "article-main",
          "entryId": "entry-4",
          "segmentId": "segment-4-2"
        }
      ],
      "titleZh": "这句话如何使用",
      "type": "explanation"
    },
    {
      "bodyZh": "清单与食物喜好属于虚构角色，不代表统一的法国家庭菜单、饮食或购物方式。",
      "id": "culture-context",
      "scopeZh": "本课虚构场景，不概括所有法语地区或个人的行为。",
      "titleZh": "场景中的细节",
      "type": "culture"
    },
