  "blocks": [
    {
      "id": "scene-main",
      "illustrationId": "art-home-morning",
      "placeZh": "两位朋友聊今天的安排",
      "situationZh": "与朋友聊今天在家学习的安排和休息时间。",
      "type": "scene"
    },
    {
      "id": "dialogue-main",
      "speakers": [
        {
          "avatarId": "avatar-camille-v1",
          "characterId": "character-camille",
          "displayName": "Camille",
          "id": "speaker-1",
          "labelZh": "朋友"
        },
        {
          "avatarId": "avatar-lea-v1",
          "characterId": "character-lea",
          "displayName": "Léa",
          "id": "speaker-2",
          "labelZh": "朋友"
        }
      ],
      "titleZh": "工作与学习的一天",
      "turns": [
        {
          "id": "entry-1",
          "segments": [
            {
              "id": "segment-1-1",
              "text": "Tu "
            },
            {
              "id": "segment-1-2",
              "text": "travailles",
              "vocabularyId": "word-travailler"
            },
            {
              "id": "segment-1-3",
              "text": " aujourd’hui ?"
            }
          ],
          "speakerId": "speaker-1",
          "translationZh": "你今天工作吗？"
        },
        {
          "id": "entry-2",
          "segments": [
            {
              "id": "segment-2-1",
              "text": "Non, aujourd’hui, "
            },
            {
              "grammarId": "grammar-etudier-present",
              "id": "segment-2-2",
              "text": "j’étudie",
              "vocabularyId": "word-etudier"
            },
            {
              "id": "segment-2-3",
              "text": " à la "
            },
            {
              "id": "segment-2-4",
              "text": "maison",
              "vocabularyId": "word-maison"
            },
            {
              "id": "segment-2-5",
              "text": "."
            }
          ],
          "speakerId": "speaker-2",
          "translationZh": "不，今天我在家学习。"
        },
        {
          "id": "entry-3",
          "segments": [
            {
              "id": "segment-3-1",
              "text": "Tu "
            },
            {
              "grammarId": "grammar-etudier-present",
              "id": "segment-3-2",
              "text": "étudies",
              "vocabularyId": "word-etudier"
            },
            {
              "id": "segment-3-3",
              "text": " le français ?"
            }
          ],
          "speakerId": "speaker-1",
          "translationZh": "你学习法语吗？"
        },
        {
          "id": "entry-4",
          "segments": [
            {
              "id": "segment-4-1",
              "text": "Oui, "
            },
            {
              "id": "segment-4-2",
              "text": "j’étudie",
              "vocabularyId": "word-etudier"
            },
            {
              "id": "segment-4-3",
              "text": " le français "
            },
            {
              "grammarId": "grammar-et-connect",
              "id": "segment-4-4",
              "text": "et"
            },
            {
              "id": "segment-4-5",
              "text": " je fais un "
            },
            {
              "id": "segment-4-6",
              "text": "exercice",
              "vocabularyId": "word-exercice"
            },
            {
              "id": "segment-4-7",
              "text": "."
            }
          ],
          "speakerId": "speaker-2",
          "translationZh": "是的，我学习法语并做一道练习。"
        },
        {
          "id": "entry-5",
          "segments": [
            {
              "id": "segment-5-1",
              "text": "Tu as un bureau ?"
            }
          ],
          "speakerId": "speaker-1",
          "translationZh": "你有书桌吗？"
        },
        {
          "id": "entry-6",
          "segments": [
            {
              "id": "segment-6-1",
              "text": "Oui. Je "
            },
            {
              "id": "segment-6-2",
              "text": "commence",
              "vocabularyId": "word-commencer"
            },
            {
              "id": "segment-6-3",
              "text": " à neuf heures "
            },
            {
              "grammarId": "grammar-et-connect",
              "id": "segment-6-4",
              "text": "et"
            },
            {
              "id": "segment-6-5",
              "text": " je "
            },
            {
              "id": "segment-6-6",
              "text": "finis",
              "vocabularyId": "word-finir"
            },
            {
              "id": "segment-6-7",
              "text": " à "
            },
            {
              "id": "segment-6-8",
              "text": "midi",
              "vocabularyId": "word-midi"
            },
            {
              "id": "segment-6-9",
              "text": "."
            }
          ],
          "speakerId": "speaker-2",
          "translationZh": "有。我九点开始，中午十二点结束。"
        },
        {
          "id": "entry-7",
          "segments": [
            {
              "id": "segment-7-1",
              "text": "Et après ?"
            }
          ],
          "speakerId": "speaker-1",
          "translationZh": "那之后呢？"
        },
        {
          "id": "entry-8",
          "segments": [
            {
              "id": "segment-8-1",
              "text": "Après, je fais une "
            },
            {
              "id": "segment-8-2",
              "text": "pause",
              "vocabularyId": "word-pause"
            },
            {
              "id": "segment-8-3",
              "text": " "
            },
            {
              "grammarId": "grammar-et-connect",
              "id": "segment-8-4",
              "text": "et"
            },
            {
              "id": "segment-8-5",
              "text": " je prépare le déjeuner."
            }
          ],
          "speakerId": "speaker-2",
          "translationZh": "之后，我休息一会儿，再准备午餐。"
        }
      ],
      "type": "dialogue"
    },
    {
      "bodyZh": "étudier 的词尾随主语改变：j’étudie、tu étudies。et 连接两个动作。je fais 本课作为“我做”的语块理解，faire 的完整变位以后学习。neuf heures 是九点，midi 是中午十二点。",
      "id": "explanation-main",
