  "knowledge": {
    "grammar": [
      {
        "bodyZh": "étudier 去掉 -er 后接现在时词尾：je 配 -e，tu 配 -es。je 在元音前省音，所以写 j’étudie；tu étudies 保留 tu。",
        "examples": [
          {
            "fr": "Tu étudies le français.",
            "recording": {
              "asset": {
                "assetId": "speech-f89528fa62931054ca139127ae5ed832bfa3ee8431e10003e67775675591bb5c",
                "creditZh": "Brioche 原创课程，Qwen 合成语音",
                "durationMs": 1360,
                "mimeType": "audio/wav",
                "revision": 1,
                "sha256": "fba314eea0a28756845dd28ebc4790a2612297e3a11ebb9a37ac4e385ec51865",
                "url": "/api/audio/fba314eea0a28756845dd28ebc4790a2612297e3a11ebb9a37ac4e385ec51865.wav"
              },
              "endMs": 1360,
              "startMs": 0
            },
            "zh": "你学习法语。"
          }
        ],
        "id": "grammar-etudier-present",
        "titleZh": "étudier 的现在时"
      },
      {
        "bodyZh": "et 连接两个并列动作。J’étudie le français et je fais un exercice 先说学习，再补充做练习；je fais 本课作为“我做”的常用语块理解。",
        "examples": [
