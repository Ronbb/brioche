            {
              "id": "segment-1-4",
              "text": "samedi",
              "vocabularyId": "word-samedi"
            },
            {
              "id": "segment-1-5",
              "text": " ?"
            }
          ],
          "speakerId": "speaker-1",
          "translationZh": "你星期六有空吗？"
        },
        {
          "id": "entry-2",
          "segments": [
            {
              "id": "segment-2-1",
              "text": "Oui, pourquoi ?"
            }
          ],
          "speakerId": "speaker-2",
          "translationZh": "有，怎么了？"
        },
        {
          "id": "entry-3",
          "segments": [
            {
              "id": "segment-3-1",
              "text": "On "
            },
            {
              "grammarId": "grammar-pouvoir-invite",
              "id": "segment-3-2",
              "text": "peut",
              "vocabularyId": "word-pouvoir"
            },
            {
              "id": "segment-3-3",
              "text": " "
            },
            {
              "id": "segment-3-4",
              "text": "prendre",
              "vocabularyId": "word-prendre"
            },
            {
              "id": "segment-3-5",
              "text": " un "
            },
            {
              "id": "segment-3-6",
              "text": "café",
              "vocabularyId": "word-cafe"
            },
            {
              "id": "segment-3-7",
              "text": " "
            },
            {
              "id": "segment-3-8",
              "text": "ensemble",
              "vocabularyId": "word-ensemble"
            },
            {
              "id": "segment-3-9",
              "text": " ?"
            }
          ],
          "speakerId": "speaker-1",
          "translationZh": "我们可以一起喝杯咖啡吗？"
        },
        {
          "id": "entry-4",
          "segments": [
            {
              "id": "segment-4-1",
              "text": "Oui, bonne idée. "
            },
            {
              "grammarId": "grammar-invite-time-question",
              "id": "segment-4-2",
              "text": "À quelle heure",
              "vocabularyId": "expr-a-quelle-heure"
            },
            {
              "id": "segment-4-3",
              "text": " ?"
            }
          ],
          "speakerId": "speaker-2",
          "translationZh": "可以，好主意。几点？"
        },
        {
          "id": "entry-5",
          "segments": [
            {
              "id": "segment-5-1",
              "text": "À "
