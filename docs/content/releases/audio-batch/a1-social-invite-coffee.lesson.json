          "speakerId": "speaker-1",
          "translationZh": "下午三点。"
        },
        {
          "id": "entry-6",
          "segments": [
            {
              "id": "segment-6-1",
              "text": "D’accord. Au café près du parc ?"
            }
          ],
          "speakerId": "speaker-2",
          "translationZh": "好的。在公园旁的咖啡馆吗？"
        },
        {
          "id": "entry-7",
          "segments": [
            {
              "id": "segment-7-1",
              "text": "Oui, devant le café."
            }
          ],
          "speakerId": "speaker-1",
          "translationZh": "对，在咖啡馆前面。"
        },
        {
          "id": "entry-8",
          "segments": [
            {
              "id": "segment-8-1",
              "text": "Parfait, à "
