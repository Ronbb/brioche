  "blocks": [
    {
      "id": "scene-main",
      "illustrationId": "art-cafe-lunch",
      "placeZh": "先确认成分，再在用餐后结账",
      "situationZh": "询问汤里是否有奶油，提出不加奶酪的选择，并在用餐后结账。",
      "type": "scene"
    },
    {
      "id": "dialogue-main",
      "speakers": [
        {
          "avatarId": "avatar-camille-v1",
          "characterId": "character-camille",
          "displayName": "Camille",
          "id": "speaker-1",
          "labelZh": "顾客"
        },
        {
          "avatarId": "avatar-luc-v1",
          "characterId": "character-luc",
          "displayName": "Luc",
          "id": "speaker-2",
          "labelZh": "餐馆服务员"
        }
      ],
      "titleZh": "询问成分与结账",
      "turns": [
        {
          "id": "entry-1",
          "segments": [
            {
              "id": "segment-1-1",
              "text": "Excusez-moi, "
            },
            {
              "grammarId": "grammar-question-ingredients",
              "id": "segment-1-2",
              "text": "il y a de la"
            },
            {
              "id": "segment-1-3",
              "text": " "
            },
            {
              "id": "segment-1-4",
              "text": "crème",
              "vocabularyId": "word-creme"
            },
            {
              "id": "segment-1-5",
              "text": " dans cette soupe ?"
            }
          ],
          "speakerId": "speaker-1",
          "translationZh": "不好意思，这份汤里有奶油吗？"
        },
        {
          "id": "entry-2",
          "segments": [
            {
              "id": "segment-2-1",
              "text": "Oui, il y a de la "
            },
            {
              "id": "segment-2-2",
              "text": "crème",
              "vocabularyId": "word-creme"
            },
            {
              "id": "segment-2-3",
              "text": "."
            }
          ],
          "speakerId": "speaker-2",
          "translationZh": "有，里面有奶油。"
        },
        {
          "id": "entry-3",
          "segments": [
            {
              "id": "segment-3-1",
              "text": "Alors, une salade "
            },
            {
              "grammarId": "grammar-sans-ingredient",
              "id": "segment-3-2",
              "text": "sans",
              "vocabularyId": "word-sans"
            },
            {
              "id": "segment-3-3",
              "text": " "
            },
            {
              "id": "segment-3-4",
              "text": "fromage",
              "vocabularyId": "word-fromage"
            },
            {
              "id": "segment-3-5",
              "text": ", s’il vous plaît."
            }
          ],
          "speakerId": "speaker-1",
          "translationZh": "那请给我一份不加奶酪的沙拉。"
        },
        {
          "id": "entry-4",
          "segments": [
            {
              "id": "segment-4-1",
              "text": "D’accord, je vous apporte la salade."
            }
          ],
          "speakerId": "speaker-2",
          "translationZh": "好的，我给您端来沙拉。"
        },
        {
          "id": "entry-5",
          "segments": [
            {
              "id": "segment-5-1",
              "text": "L’addition",
              "vocabularyId": "word-addition"
            },
            {
              "id": "segment-5-2",
              "text": ", s’il vous plaît."
            }
          ],
          "speakerId": "speaker-1",
          "translationZh": "请给我账单。"
        },
        {
          "id": "entry-6",
          "segments": [
            {
              "id": "segment-6-1",
              "text": "Voilà. "
            },
            {
              "id": "segment-6-2",
              "text": "Douze",
              "vocabularyId": "word-douze"
            },
            {
              "id": "segment-6-3",
              "text": " "
            },
            {
              "id": "segment-6-4",
              "text": "euros",
              "vocabularyId": "word-euro"
            },
            {
              "id": "segment-6-5",
              "text": "."
            }
          ],
          "speakerId": "speaker-2",
          "translationZh": "给您。十二欧元。"
        },
        {
          "id": "entry-7",
          "segments": [
            {
              "id": "segment-7-1",
              "text": "Je peux "
            },
            {
              "id": "segment-7-2",
              "text": "payer",
              "vocabularyId": "word-payer"
            },
            {
              "id": "segment-7-3",
              "text": " "
            },
            {
              "id": "segment-7-4",
              "text": "par carte",
              "vocabularyId": "expr-par-carte"
            },
            {
              "id": "segment-7-5",
              "text": " ?"
            }
          ],
          "speakerId": "speaker-1",
          "translationZh": "我可以用银行卡付款吗？"
        },
        {
          "id": "entry-8",
          "segments": [
            {
              "id": "segment-8-1",
              "text": "Oui. Merci, bonne journée."
            }
          ],
          "speakerId": "speaker-2",
          "translationZh": "可以。谢谢，祝您今天愉快。"
        }
      ],
      "type": "dialogue"
    },
    {
      "bodyZh": "Il y a… ? 可以询问成分；sans fromage 是不加奶酪的请求，仍需对方确认。对话压缩了点餐与用餐后的两个时刻，第五句起是结账。L’addition 指餐馆账单；Je peux payer par carte ? 复用前面学过的付款请求。",
      "id": "explanation-main",
      "targets": [
        {
          "blockId": "dialogue-main",
          "entryId": "entry-1",
          "segmentId": "segment-1-2"
        },
        {
          "blockId": "dialogue-main",
          "entryId": "entry-3",
          "segmentId": "segment-3-2"
        }
      ],
      "titleZh": "这句话如何使用",
      "type": "explanation"
    },
    {
      "bodyZh": "成分、金额及可提供的选择都是虚构服务情境；实际菜品和可调整内容需要向当时的服务人员确认。",
