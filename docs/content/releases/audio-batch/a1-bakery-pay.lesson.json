  "blocks": [
    {
      "id": "scene-main",
      "illustrationId": "art-bakery-morning",
      "placeZh": "一家社区面包店",
      "situationZh": "听懂示例价格，询问是否可以刷卡付款。",
      "type": "scene"
    },
    {
      "id": "dialogue-main",
      "speakers": [
        {
          "avatarId": "avatar-camille-v1",
          "characterId": "character-camille",
          "displayName": "Camille",
          "id": "speaker-1",
          "labelZh": "顾客"
        },
        {
          "avatarId": "avatar-luc-v1",
          "characterId": "character-luc",
          "displayName": "Luc",
          "id": "speaker-2",
          "labelZh": "店员"
        }
      ],
      "titleZh": "询价与付款",
      "turns": [
        {
          "id": "entry-1",
          "segments": [
            {
              "id": "segment-1-1",
              "text": "Bonjour. "
            },
            {
              "id": "segment-1-2",
              "text": "C’est combien",
              "vocabularyId": "expr-cest-combien"
            },
            {
              "id": "segment-1-3",
              "text": " ?"
            }
          ],
          "speakerId": "speaker-1",
          "translationZh": "您好。多少钱？"
        },
        {
          "id": "entry-2",
          "segments": [
            {
              "id": "segment-2-1",
              "text": "Quatre "
            },
            {
              "grammarId": "grammar-price-euros",
              "id": "segment-2-2",
              "text": "euros",
              "vocabularyId": "word-euro"
            },
            {
              "id": "segment-2-3",
              "text": ", s’il vous plaît."
            }
          ],
          "speakerId": "speaker-2",
          "translationZh": "四欧元，谢谢。"
        },
        {
          "id": "entry-3",
