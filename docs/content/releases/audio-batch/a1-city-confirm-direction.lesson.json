  "blocks": [
    {
      "id": "scene-main",
      "illustrationId": "art-city-morning",
      "placeZh": "一座虚构城市的街道与车站",
      "situationZh": "确认列车是否前往火车站，并理解另一方向的提示。",
      "type": "scene"
    },
    {
      "id": "dialogue-main",
      "speakers": [
        {
          "avatarId": "avatar-camille-v1",
          "characterId": "character-camille",
          "displayName": "Camille",
          "id": "speaker-1",
          "labelZh": "出行者"
        },
        {
          "avatarId": "avatar-lea-v1",
          "characterId": "character-lea",
          "displayName": "Léa",
          "id": "speaker-2",
          "labelZh": "路人"
        }
      ],
      "titleZh": "确认乘车方向",
      "turns": [
        {
          "id": "entry-1",
          "segments": [
            {
              "id": "segment-1-1",
              "text": "Excusez-moi, ce "
            },
            {
              "id": "segment-1-2",
              "text": "train",
              "vocabularyId": "word-train"
            },
            {
              "id": "segment-1-3",
              "text": " "
            },
            {
              "grammarId": "grammar-aller-present",
              "id": "segment-1-4",
              "text": "va",
              "vocabularyId": "word-aller"
            },
            {
              "id": "segment-1-5",
              "text": " à la "
            },
            {
              "id": "segment-1-6",
              "text": "gare",
              "vocabularyId": "word-gare"
            },
            {
              "id": "segment-1-7",
              "text": " ?"
            }
          ],
          "speakerId": "speaker-1",
          "translationZh": "打扰一下，这班列车去火车站吗？"
        },
        {
          "id": "entry-2",
          "segments": [
            {
              "id": "segment-2-1",
              "text": "Non, il "
            },
            {
              "grammarId": "grammar-aller-present",
              "id": "segment-2-2",
              "text": "va",
              "vocabularyId": "word-aller"
            },
            {
              "id": "segment-2-3",
              "text": " "
            },
            {
              "grammarId": "grammar-destination-au",
              "id": "segment-2-4",
              "text": "au"
            },
            {
              "id": "segment-2-5",
              "text": " "
            },
            {
              "id": "segment-2-6",
              "text": "centre-ville",
              "vocabularyId": "word-centre-ville"
            },
            {
              "id": "segment-2-7",
              "text": "."
            }
          ],
          "speakerId": "speaker-2",
          "translationZh": "不，它去市中心。"
        },
        {
          "id": "entry-3",
          "segments": [
            {
              "id": "segment-3-1",
              "text": "Pour la "
            },
            {
              "id": "segment-3-2",
              "text": "gare",
              "vocabularyId": "word-gare"
            },
            {
              "id": "segment-3-3",
              "text": ", c’est l’autre "
            },
            {
              "id": "segment-3-4",
              "text": "direction",
              "vocabularyId": "word-direction"
            },
            {
              "id": "segment-3-5",
              "text": " ?"
            }
          ],
          "speakerId": "speaker-1",
          "translationZh": "去火车站是另一个方向吗？"
        },
        {
          "id": "entry-4",
          "segments": [
            {
              "id": "segment-4-1",
              "text": "Oui. Regardez le "
            },
            {
              "id": "segment-4-2",
              "text": "panneau",
              "vocabularyId": "word-panneau"
            },
            {
              "id": "segment-4-3",
              "text": "."
            }
          ],
          "speakerId": "speaker-2",
          "translationZh": "是的。请看指示牌。"
        },
        {
          "id": "entry-5",
          "segments": [
            {
              "id": "segment-5-1",
              "text": "Je "
            },
            {
              "id": "segment-5-2",
              "text": "vais",
              "vocabularyId": "word-aller"
            },
            {
              "id": "segment-5-3",
              "text": " à la "
            },
            {
              "id": "segment-5-4",
              "text": "gare",
              "vocabularyId": "word-gare"
            },
            {
              "id": "segment-5-5",
              "text": "."
            }
          ],
          "speakerId": "speaker-1",
          "translationZh": "我要去火车站。"
        },
        {
          "id": "entry-6",
          "segments": [
            {
              "id": "segment-6-1",
              "text": "Alors, prenez le "
            },
            {
              "id": "segment-6-2",
              "text": "train",
              "vocabularyId": "word-train"
            },
            {
              "id": "segment-6-3",
              "text": " de "
            },
            {
              "id": "segment-6-4",
              "text": "l’autre côté",
              "vocabularyId": "expr-autre-cote"
            },
            {
              "id": "segment-6-5",
              "text": "."
            }
          ],
          "speakerId": "speaker-2",
          "translationZh": "那请乘另一边的列车。"
        },
        {
          "id": "entry-7",
          "segments": [
            {
              "id": "segment-7-1",
              "text": "Merci beaucoup."
            }
          ],
          "speakerId": "speaker-1",
          "translationZh": "非常感谢。"
        },
        {
          "id": "entry-8",
          "segments": [
            {
              "id": "segment-8-1",
              "text": "De rien."
            }
          ],
          "speakerId": "speaker-2",
          "translationZh": "不客气。"
        }
      ],
      "type": "dialogue"
    },
    {
      "bodyZh": "aller 的现在时是不规则变化。je vais 表示“我去”，il va / ce train va 表示“他去/这班列车前往”。\n\ngare 是阴性名词，因此说 à la gare；centre-ville 是阳性，à + le 缩合为 au，不能写 à le centre-ville。",
