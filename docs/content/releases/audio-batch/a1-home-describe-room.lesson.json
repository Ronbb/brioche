  "blocks": [
    {
      "id": "scene-main",
      "illustrationId": "art-home-morning",
      "placeZh": "Camille 的虚构公寓",
      "situationZh": "向朋友介绍公寓里的房间和书桌位置。",
      "type": "scene"
    },
    {
      "id": "dialogue-main",
      "speakers": [
        {
          "avatarId": "avatar-camille-v1",
          "characterId": "character-camille",
          "displayName": "Camille",
          "id": "speaker-1",
          "labelZh": "公寓主人"
        },
        {
          "avatarId": "avatar-lea-v1",
          "characterId": "character-lea",
          "displayName": "Léa",
          "id": "speaker-2",
          "labelZh": "来访的朋友"
        }
      ],
      "titleZh": "描述我的房间",
      "turns": [
        {
          "id": "entry-1",
          "segments": [
            {
              "id": "segment-1-1",
              "text": "Voilà mon "
            },
            {
              "id": "segment-1-2",
              "text": "appartement",
              "vocabularyId": "word-appartement"
            },
            {
              "id": "segment-1-3",
              "text": "."
            }
          ],
          "speakerId": "speaker-1",
          "translationZh": "这是我的公寓。"
        },
        {
          "id": "entry-2",
          "segments": [
            {
              "id": "segment-2-1",
              "text": "Il est petit, mais lumineux."
            }
          ],
          "speakerId": "speaker-2",
          "translationZh": "它不大，但很明亮。"
        },
        {
          "id": "entry-3",
          "segments": [
            {
              "grammarId": "grammar-il-y-a-existence",
              "id": "segment-3-1",
              "text": "Il y a",
              "vocabularyId": "expr-il-y-a"
            },
            {
              "id": "segment-3-2",
              "text": " une "
            },
            {
              "id": "segment-3-3",
              "text": "cuisine",
              "vocabularyId": "word-cuisine"
            },
            {
              "id": "segment-3-4",
              "text": " ?"
            }
          ],
          "speakerId": "speaker-2",
          "translationZh": "有厨房吗？"
        },
        {
          "id": "entry-4",
          "segments": [
            {
              "id": "segment-4-1",
              "text": "Oui, "
            },
            {
              "id": "segment-4-2",
              "text": "il y a",
              "vocabularyId": "expr-il-y-a"
            },
            {
              "id": "segment-4-3",
              "text": " une "
            },
            {
              "id": "segment-4-4",
              "text": "cuisine",
              "vocabularyId": "word-cuisine"
            },
            {
              "id": "segment-4-5",
              "text": " et une "
            },
            {
              "id": "segment-4-6",
              "text": "chambre",
              "vocabularyId": "word-chambre"
            },
            {
              "id": "segment-4-7",
              "text": "."
            }
          ],
          "speakerId": "speaker-1",
          "translationZh": "是的，有厨房和卧室。"
        },
        {
          "id": "entry-5",
          "segments": [
            {
              "id": "segment-5-1",
              "text": "Tu "
            },
            {
              "grammarId": "grammar-avoir-possession",
              "id": "segment-5-2",
              "text": "as",
              "vocabularyId": "word-avoir"
            },
            {
              "id": "segment-5-3",
              "text": " un "
            },
            {
              "id": "segment-5-4",
              "text": "bureau",
              "vocabularyId": "word-bureau"
            },
            {
              "id": "segment-5-5",
              "text": " ?"
            }
          ],
          "speakerId": "speaker-2",
          "translationZh": "你有书桌吗？"
        },
        {
          "id": "entry-6",
          "segments": [
            {
              "id": "segment-6-1",
              "text": "Oui, "
            },
            {
              "grammarId": "grammar-avoir-possession",
              "id": "segment-6-2",
              "text": "j’ai",
              "vocabularyId": "word-avoir"
            },
            {
              "id": "segment-6-3",
              "text": " un "
            },
            {
              "id": "segment-6-4",
              "text": "bureau",
              "vocabularyId": "word-bureau"
            },
            {
              "id": "segment-6-5",
              "text": " dans ma "
            },
            {
              "id": "segment-6-6",
              "text": "chambre",
              "vocabularyId": "word-chambre"
            },
            {
              "id": "segment-6-7",
              "text": "."
            }
          ],
          "speakerId": "speaker-1",
          "translationZh": "有，我的卧室里有一张书桌。"
        },
        {
          "id": "entry-7",
          "segments": [
            {
              "id": "segment-7-1",
              "text": "Et le "
            },
            {
              "id": "segment-7-2",
              "text": "salon",
              "vocabularyId": "word-salon"
            },
            {
              "id": "segment-7-3",
              "text": " ?"
            }
          ],
          "speakerId": "speaker-2",
          "translationZh": "那客厅呢？"
        },
        {
          "id": "entry-8",
          "segments": [
            {
              "id": "segment-8-1",
              "text": "Le "
            },
            {
              "id": "segment-8-2",
              "text": "salon",
              "vocabularyId": "word-salon"
            },
            {
              "id": "segment-8-3",
              "text": " est "
            },
            {
              "id": "segment-8-4",
              "text": "à côté de",
              "vocabularyId": "expr-a-cote-de"
            },
            {
              "id": "segment-8-5",
              "text": " la "
            },
            {
              "id": "segment-8-6",
              "text": "cuisine",
              "vocabularyId": "word-cuisine"
            },
            {
              "id": "segment-8-7",
              "text": "."
            }
          ],
          "speakerId": "speaker-1",
          "translationZh": "客厅在厨房旁边。"
        }
      ],
      "type": "dialogue"
    },
    {
      "bodyZh": "petit 和 lumineux 分别表示“小”和“明亮”。Il y a 用来介绍有什么；j’ai 说明我拥有什么。这里的 bureau 是书桌。朋友之间使用 tu。",
      "id": "explanation-main",
