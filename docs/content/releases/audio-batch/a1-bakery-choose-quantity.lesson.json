  "blocks": [
    {
      "id": "scene-main",
      "illustrationId": "art-bakery-morning",
      "placeZh": "一家社区面包店",
      "situationZh": "用一和二说明面包数量，确认订单。",
      "type": "scene"
    },
    {
      "id": "dialogue-main",
      "speakers": [
        {
          "avatarId": "avatar-luc-v1",
          "characterId": "character-luc",
          "displayName": "Luc",
          "id": "speaker-1",
          "labelZh": "店员"
        },
        {
          "avatarId": "avatar-camille-v1",
          "characterId": "character-camille",
          "displayName": "Camille",
          "id": "speaker-2",
          "labelZh": "顾客"
        }
      ],
      "titleZh": "说清想要几个",
      "turns": [
        {
          "id": "entry-1",
          "segments": [
            {
              "id": "segment-1-1",
              "text": "Bonjour !"
            }
          ],
          "speakerId": "speaker-1",
          "translationZh": "您好！"
        },
        {
          "id": "entry-2",
          "segments": [
            {
              "id": "segment-2-1",
              "text": "Je voudrais",
              "vocabularyId": "expr-je-voudrais"
            },
            {
              "id": "segment-2-2",
              "text": " "
            },
            {
              "grammarId": "grammar-bakery-quantity",
              "id": "segment-2-3",
              "text": "deux",
              "vocabularyId": "word-deux"
            },
            {
              "id": "segment-2-4",
              "text": " "
            },
            {
              "grammarId": "grammar-croissant-plural",
              "id": "segment-2-5",
              "text": "croissants",
              "vocabularyId": "word-croissant"
            },
            {
              "id": "segment-2-6",
              "text": "."
            }
          ],
          "speakerId": "speaker-2",
          "translationZh": "我想要两个可颂。"
        },
        {
          "id": "entry-3",
          "segments": [
            {
              "grammarId": "grammar-bakery-quantity",
              "id": "segment-3-1",
              "text": "Deux",
              "vocabularyId": "word-deux"
            },
            {
              "id": "segment-3-2",
              "text": " "
            },
            {
              "grammarId": "grammar-croissant-plural",
              "id": "segment-3-3",
              "text": "croissants",
              "vocabularyId": "word-croissant"
            },
            {
              "id": "segment-3-4",
              "text": " ?"
            }
          ],
          "speakerId": "speaker-1",
          "translationZh": "两个可颂吗？"
        },
        {
          "id": "entry-4",
          "segments": [
            {
              "id": "segment-4-1",
              "text": "Oui, et un "
            },
            {
              "id": "segment-4-2",
              "text": "pain",
              "vocabularyId": "word-pain"
            },
            {
              "id": "segment-4-3",
              "text": ", "
            },
            {
              "id": "segment-4-4",
              "text": "s’il vous plaît",
              "vocabularyId": "expr-sil-vous-plait"
            },
            {
              "id": "segment-4-5",
              "text": "."
            }
          ],
          "speakerId": "speaker-2",
          "translationZh": "是的，再要一个面包，谢谢。"
        },
        {
          "id": "entry-5",
          "segments": [
            {
              "id": "segment-5-1",
              "text": "Un "
            },
            {
              "id": "segment-5-2",
              "text": "pain",
              "vocabularyId": "word-pain"
            },
            {
              "id": "segment-5-3",
              "text": " et "
            },
            {
              "grammarId": "grammar-bakery-quantity",
              "id": "segment-5-4",
              "text": "deux",
              "vocabularyId": "word-deux"
            },
            {
              "id": "segment-5-5",
              "text": " "
            },
            {
              "grammarId": "grammar-croissant-plural",
              "id": "segment-5-6",
              "text": "croissants",
              "vocabularyId": "word-croissant"
            },
            {
              "id": "segment-5-7",
              "text": "."
            }
          ],
          "speakerId": "speaker-1",
          "translationZh": "一个面包和两个可颂。"
        },
        {
          "id": "entry-6",
          "segments": [
            {
              "id": "segment-6-1",
              "text": "C’est tout ?"
            }
          ],
          "speakerId": "speaker-1",
          "translationZh": "就这些吗？"
        },
        {
          "id": "entry-7",
          "segments": [
            {
