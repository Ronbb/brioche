  "blocks": [
    {
      "id": "scene-main",
      "illustrationId": "art-home-morning",
      "placeZh": "Léa 的虚构一周日程",
      "situationZh": "从一周安排中找出工作地点，并用否定表达休息日。",
      "type": "scene"
    },
    {
      "id": "article-main",
      "narratorId": "character-lea",
      "paragraphs": [
        {
          "id": "entry-1",
          "segments": [
            {
              "id": "segment-1-1",
              "text": "Léa travaille à Lyon."
            }
          ],
          "translationZh": "Léa 在里昂工作。"
        },
        {
          "id": "entry-2",
          "segments": [
            {
              "id": "segment-2-1",
              "text": "Le "
            },
            {
              "grammarId": "grammar-le-weekday-habit",
              "id": "segment-2-2",
              "text": "lundi",
              "vocabularyId": "word-lundi"
            },
            {
              "id": "segment-2-3",
              "text": " et le "
            },
            {
              "id": "segment-2-4",
              "text": "mardi",
              "vocabularyId": "word-mardi"
            },
            {
              "id": "segment-2-5",
              "text": ", elle travaille au bureau."
            }
          ],
          "translationZh": "她每周一和周二在办公室工作。"
        },
        {
          "id": "entry-3",
          "segments": [
            {
              "id": "segment-3-1",
              "text": "Le "
            },
            {
              "grammarId": "grammar-le-weekday-habit",
              "id": "segment-3-2",
              "text": "mercredi",
              "vocabularyId": "word-mercredi"
            },
            {
              "id": "segment-3-3",
              "text": ", elle travaille à la maison."
            }
          ],
          "translationZh": "她每周三在家工作。"
        },
        {
          "id": "entry-4",
          "segments": [
            {
              "id": "segment-4-1",
              "text": "Elle commence à huit heures trente et elle finit à dix-sept heures."
            }
          ],
          "translationZh": "她八点半开始，十七点结束。"
        },
        {
          "id": "entry-5",
          "segments": [
            {
              "id": "segment-5-1",
              "text": "Le "
            },
            {
              "id": "segment-5-2",
              "text": "samedi",
              "vocabularyId": "word-samedi"
            },
            {
              "id": "segment-5-3",
              "text": ", elle fait les courses et elle prépare le repas."
            }
          ],
          "translationZh": "每周六，她采购日用品并准备饭菜。"
        },
        {
          "id": "entry-6",
          "segments": [
            {
              "id": "segment-6-1",
              "text": "Le "
            },
            {
              "id": "segment-6-2",
              "text": "dimanche",
              "vocabularyId": "word-dimanche"
            },
            {
              "id": "segment-6-3",
              "text": ", elle "
            },
            {
              "grammarId": "grammar-negation-ne-pas",
              "id": "segment-6-4",
              "text": "ne travaille pas"
            },
            {
              "id": "segment-6-5",
              "text": " : elle "
            },
            {
              "id": "segment-6-6",
              "text": "lit",
              "vocabularyId": "word-lire"
            },
            {
              "id": "segment-6-7",
              "text": " un "
            },
            {
              "id": "segment-6-8",
              "text": "livre",
              "vocabularyId": "word-livre"
            },
            {
              "id": "segment-6-9",
              "text": " et elle marche dans le "
            },
            {
              "id": "segment-6-10",
              "text": "parc",
              "vocabularyId": "word-parc"
            },
            {
              "id": "segment-6-11",
              "text": "."
            }
          ],
          "translationZh": "每周日，她不工作：她读书，还在公园散步。"
        },
        {
          "id": "entry-7",
          "segments": [
            {
              "id": "segment-7-1",
              "text": "Le soir, elle prépare son sac et regarde son agenda pour le lendemain."
            }
          ],
          "translationZh": "晚上，她收拾包，并查看日程本上第二天的安排。"
        }
      ],
      "titleZh": "一周的日常习惯",
      "type": "article"
    },
    {
      "bodyZh": "le + 星期在这里表示每周的习惯。ne 和 pas 放在变位动词的两边。au bureau 在这里表示在办公室，区别于前课 un bureau 的书桌。faire les courses 是采购日常用品；le lendemain 是第二天。",
      "id": "explanation-main",
      "targets": [
        {
          "blockId": "article-main",
          "entryId": "entry-6",
          "segmentId": "segment-6-4"
        },
        {
          "blockId": "article-main",
          "entryId": "entry-2",
          "segmentId": "segment-2-2"
        }
      ],
      "titleZh": "这句话如何使用",
      "type": "explanation"
    },
    {
      "bodyZh": "这是 Léa 个人的虚构安排，不据此推断法国人的工作日、周末或远程办公习惯。",
      "id": "culture-context",
      "scopeZh": "本课虚构场景，不概括所有法语地区或个人的行为。",
      "titleZh": "场景中的细节",
      "type": "culture"
    },
    {
      "entryIds": [
        "word-lundi",
        "word-mardi",
        "word-mercredi",
        "word-samedi",
        "word-dimanche",
        "word-lire",
        "word-livre",
        "word-parc"
      ],
      "id": "vocabulary-targets",
      "type": "vocabulary"
    },
    {
      "entryIds": [
        "grammar-negation-ne-pas",
        "grammar-le-weekday-habit"
      ],
      "id": "grammar-targets",
      "type": "grammar"
    },
    {
      "exerciseType": "single-choice",
      "id": "exercise-comprehension",
      "options": [
        {
          "id": "distractor-a",
          "text": "星期一"
        },
        {
          "id": "correct",
          "text": "星期三"
        },
        {
          "id": "distractor-b",
          "text": "星期二"
        }
      ],
      "promptZh": "Léa 每周几在家工作？",
      "type": "exercise"
    },
    {
      "exerciseType": "fill-blank",
      "hintZh": "完整否定是 ne + 变位动词 + pas。",
      "id": "exercise-fill",
      "promptZh": "根据提示补全句子。",
      "templateFr": "Le dimanche, elle ne travaille ___.",
      "type": "exercise"
    },
    {
      "exerciseType": "order",
      "id": "exercise-order",
      "promptZh": "把语块排成一句日常表达。",
      "tokens": [
        {
          "id": "token-3",
          "text": "pas."
        },
        {
          "id": "token-1",
          "text": "Le dimanche,"
        },
        {
          "id": "token-2",
          "text": "je ne travaille"
        }
      ],
      "type": "exercise"
    },
    {
      "alternativeZh": "也可以只在心里构思或写一句虚构信息，不需要提供现实行为证明。",
      "id": "habit-main",
      "taskZh": "选一个星期，用 Le… 说一句虚构的每周安排；也可以用 ne…pas 说不做的事情。",
      "type": "habit"
    },
    {
      "id": "summary-main",
      "takeawaysZh": [
        "我能找到星期与对应安排。",
        "我能用 le + 星期说每周习惯。",
        "我能用 ne…pas 否定动作。"
      ],
      "type": "summary"
    }
  ],
