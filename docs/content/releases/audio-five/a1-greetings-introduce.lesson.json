  "blocks": [
    {
      "id": "scene-main",
      "illustrationId": "art-first-conversations",
      "placeZh": "一次社区活动中的初次交谈",
      "situationZh": "说明居住城市和当前身份，并把问题转给对方。",
      "type": "scene"
    },
    {
      "id": "dialogue-main",
      "speakers": [
        {
          "avatarId": "avatar-camille-v1",
          "characterId": "character-camille",
          "displayName": "Camille",
          "id": "speaker-1",
          "labelZh": "初次相识"
        },
        {
          "avatarId": "avatar-lea-v1",
          "characterId": "character-lea",
          "displayName": "Léa",
          "id": "speaker-2",
          "labelZh": "初次相识"
        }
      ],
      "titleZh": "说说自己",
      "turns": [
        {
          "id": "entry-1",
          "segments": [
            {
              "id": "segment-1-1",
              "text": "Je m’appelle",
              "vocabularyId": "expr-je-mappelle"
            },
            {
              "id": "segment-1-2",
              "text": " Camille."
            }
          ],
          "speakerId": "speaker-1",
          "translationZh": "我叫 Camille。"
        },
        {
          "id": "entry-2",
          "segments": [
            {
              "id": "segment-2-1",
              "text": "Moi, c’est Léa."
            }
          ],
          "speakerId": "speaker-2",
          "translationZh": "我叫 Léa。"
        },
        {
          "id": "entry-3",
          "segments": [
            {
              "id": "segment-3-1",
              "text": "J’habite",
              "vocabularyId": "expr-jhabite"
            },
            {
              "id": "segment-3-2",
              "text": " "
            },
            {
              "grammarId": "grammar-habiter-city",
              "id": "segment-3-3",
              "text": "à Lyon"
            },
            {
              "id": "segment-3-4",
              "text": ". "
            },
            {
              "id": "segment-3-5",
              "text": "Et vous",
              "vocabularyId": "expr-et-vous"
            },
            {
              "id": "segment-3-6",
              "text": " ?"
            }
          ],
          "speakerId": "speaker-1",
          "translationZh": "我住在里昂。您呢？"
        },
        {
          "id": "entry-4",
          "segments": [
            {
              "id": "segment-4-1",
              "text": "Moi aussi, "
            },
            {
              "id": "segment-4-2",
              "text": "j’habite",
              "vocabularyId": "expr-jhabite"
            },
            {
              "id": "segment-4-3",
              "text": " "
            },
            {
              "grammarId": "grammar-habiter-city",
              "id": "segment-4-4",
              "text": "à Lyon"
            },
            {
              "id": "segment-4-5",
              "text": "."
            }
          ],
          "speakerId": "speaker-2",
          "translationZh": "我也住在里昂。"
        },
        {
          "id": "entry-5",
          "segments": [
            {
              "grammarId": "grammar-etre-identity",
              "id": "segment-5-1",
              "text": "Je suis",
              "vocabularyId": "expr-je-suis"
            },
            {
              "id": "segment-5-2",
              "text": " "
            },
            {
