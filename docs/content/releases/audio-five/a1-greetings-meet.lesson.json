  "blocks": [
    {
      "id": "scene-main",
      "illustrationId": "art-first-conversations",
      "placeZh": "一次社区活动中的初次交谈",
      "situationZh": "用问候和名字开启第一次交谈，再自然地道别。",
      "type": "scene"
    },
    {
      "id": "dialogue-main",
      "speakers": [
        {
          "avatarId": "avatar-camille-v1",
          "characterId": "character-camille",
          "displayName": "Camille",
          "id": "speaker-1",
          "labelZh": "初次相识"
        },
        {
          "avatarId": "avatar-lea-v1",
          "characterId": "character-lea",
          "displayName": "Léa",
          "id": "speaker-2",
          "labelZh": "初次相识"
        }
      ],
      "titleZh": "第一次打招呼",
      "turns": [
        {
          "id": "entry-1",
          "segments": [
            {
              "id": "segment-1-1",
              "text": "Bonjour",
              "vocabularyId": "word-bonjour"
            },
            {
              "id": "segment-1-2",
              "text": " !"
            }
          ],
          "speakerId": "speaker-1",
          "translationZh": "您好！"
        },
        {
          "id": "entry-2",
          "segments": [
            {
              "id": "segment-2-1",
              "text": "Bonjour",
              "vocabularyId": "word-bonjour"
            },
            {
              "id": "segment-2-2",
              "text": " !"
            }
          ],
          "speakerId": "speaker-2",
          "translationZh": "您好！"
        },
        {
          "id": "entry-3",
          "segments": [
            {
              "grammarId": "grammar-name-first-person",
              "id": "segment-3-1",
              "text": "Je m’appelle",
              "vocabularyId": "expr-je-mappelle"
            },
            {
              "id": "segment-3-2",
              "text": " Camille. "
            },
            {
              "grammarId": "grammar-address-vous",
              "id": "segment-3-3",
              "text": "Et vous",
              "vocabularyId": "expr-et-vous"
            },
            {
              "id": "segment-3-4",
              "text": " ?"
            }
          ],
          "speakerId": "speaker-1",
          "translationZh": "我叫 Camille。您呢？"
        },
        {
          "id": "entry-4",
          "segments": [
            {
              "grammarId": "grammar-name-first-person",
              "id": "segment-4-1",
              "text": "Je m’appelle",
              "vocabularyId": "expr-je-mappelle"
            },
            {
              "id": "segment-4-2",
              "text": " Léa."
            }
          ],
          "speakerId": "speaker-2",
          "translationZh": "我叫 Léa。"
        },
        {
          "id": "entry-5",
          "segments": [
            {
              "id": "segment-5-1",
              "text": "Enchantée",
              "vocabularyId": "word-enchantee"
            },
            {
              "id": "segment-5-2",
              "text": ", Léa."
            }
          ],
          "speakerId": "speaker-1",
          "translationZh": "很高兴认识您，Léa。"
        },
        {
          "id": "entry-6",
          "segments": [
            {
              "id": "segment-6-1",
              "text": "Enchantée",
              "vocabularyId": "word-enchantee"
            },
            {
              "id": "segment-6-2",
              "text": ", Camille."
            }
          ],
          "speakerId": "speaker-2",
          "translationZh": "很高兴认识您，Camille。"
        },
        {
          "id": "entry-7",
          "segments": [
            {
              "id": "segment-7-1",
              "text": "À bientôt",
              "vocabularyId": "expr-a-bientot"
            },
            {
              "id": "segment-7-2",
              "text": " !"
            }
          ],
          "speakerId": "speaker-1",
          "translationZh": "回头见！"
        },
        {
          "id": "entry-8",
          "segments": [
            {
              "id": "segment-8-1",
              "text": "Au revoir",
              "vocabularyId": "expr-au-revoir"
            },
            {
              "id": "segment-8-2",
              "text": " !"
            }
          ],
          "speakerId": "speaker-2",
          "translationZh": "再见！"
        }
      ],
      "type": "dialogue"
    },
    {
      "bodyZh": "m’appelle 是 s’appeler 的第一人称单数现在时；先把 Je m’appelle + 名字作为整体使用。\n\n本课双方刚见面，使用 vous 称呼对方。它也可以表示复数“你们”；何时改用 tu 要结合关系与场合。",
      "id": "explanation-main",
      "targets": [
        {
          "blockId": "dialogue-main",
          "entryId": "entry-3",
          "segmentId": "segment-3-1"
        },
        {
          "blockId": "dialogue-main",
          "entryId": "entry-3",
          "segmentId": "segment-3-3"
        }
      ],
      "titleZh": "这句话如何使用",
      "type": "explanation"
    },
    {
      "bodyZh": "本课模拟初次相识的两位女性；enchantée 的书写形式与说话者一致。无需把问候方式当成所有人的统一习惯。",
      "id": "culture-context",
      "scopeZh": "本课虚构场景，不概括所有法语地区或个人的行为。",
      "titleZh": "场景中的细节",
      "type": "culture"
    },
