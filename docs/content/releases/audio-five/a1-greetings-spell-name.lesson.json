  "blocks": [
    {
      "id": "scene-main",
      "illustrationId": "art-first-conversations",
      "placeZh": "一次社区活动中的初次交谈",
      "situationZh": "区分名字和姓氏，听懂逐字母拼写的请求。",
      "type": "scene"
    },
    {
      "id": "dialogue-main",
      "speakers": [
        {
          "avatarId": "avatar-camille-v1",
          "characterId": "character-camille",
          "displayName": "Camille",
          "id": "speaker-1",
          "labelZh": "初次相识"
        },
        {
          "avatarId": "avatar-lea-v1",
          "characterId": "character-lea",
          "displayName": "Léa",
          "id": "speaker-2",
          "labelZh": "初次相识"
        }
      ],
      "titleZh": "拼写自己的名字",
      "turns": [
        {
          "id": "entry-1",
          "segments": [
            {
              "id": "segment-1-1",
              "text": "Quel est votre "
            },
            {
              "id": "segment-1-2",
              "text": "prénom",
              "vocabularyId": "word-prenom"
            },
            {
              "id": "segment-1-3",
              "text": " ?"
            }
          ],
          "speakerId": "speaker-1",
          "translationZh": "您的名字是什么？"
        },
        {
          "id": "entry-2",
          "segments": [
            {
              "grammarId": "grammar-mon-name",
              "id": "segment-2-1",
              "text": "Mon"
            },
            {
              "id": "segment-2-2",
              "text": " "
            },
            {
              "id": "segment-2-3",
              "text": "prénom",
              "vocabularyId": "word-prenom"
            },
            {
              "id": "segment-2-4",
              "text": " est Léa."
            }
          ],
          "speakerId": "speaker-2",
          "translationZh": "我的名字是 Léa。"
        },
        {
          "id": "entry-3",
          "segments": [
            {
              "grammarId": "grammar-pouvez-vous-spell",
              "id": "segment-3-1",
              "text": "Pouvez-vous"
            },
            {
              "id": "segment-3-2",
              "text": " "
            },
            {
              "id": "segment-3-3",
              "text": "épeler",
              "vocabularyId": "word-epeler"
            },
            {
              "id": "segment-3-4",
              "text": " votre "
            },
            {
              "id": "segment-3-5",
              "text": "prénom",
              "vocabularyId": "word-prenom"
            },
            {
              "id": "segment-3-6",
              "text": " ?"
            }
          ],
          "speakerId": "speaker-1",
          "translationZh": "您可以拼写一下您的名字吗？"
        },
        {
          "id": "entry-4",
          "segments": [
            {
              "id": "segment-4-1",
              "text": "L, É, A."
            }
          ],
          "speakerId": "speaker-2",
          "translationZh": "L、带尖音符的 E、A。"
        },
        {
          "id": "entry-5",
          "segments": [
            {
              "id": "segment-5-1",
              "text": "Il y a "
            },
            {
              "id": "segment-5-2",
              "text": "trois",
              "vocabularyId": "word-trois"
            },
            {
              "id": "segment-5-3",
              "text": " "
            },
            {
              "id": "segment-5-4",
              "text": "lettres",
              "vocabularyId": "word-lettre"
            },
            {
              "id": "segment-5-5",
              "text": " ?"
            }
          ],
          "speakerId": "speaker-1",
          "translationZh": "有三个字母吗？"
        },
        {
          "id": "entry-6",
          "segments": [
            {
              "id": "segment-6-1",
              "text": "Oui. Et votre "
            },
            {
              "id": "segment-6-2",
              "text": "nom",
              "vocabularyId": "word-nom"
            },
            {
              "id": "segment-6-3",
              "text": " ?"
            }
          ],
          "speakerId": "speaker-2",
          "translationZh": "是的。您的姓呢？"
        },
        {
          "id": "entry-7",
          "segments": [
            {
              "grammarId": "grammar-mon-name",
              "id": "segment-7-1",
              "text": "Mon"
            },
            {
              "id": "segment-7-2",
              "text": " "
            },
            {
              "id": "segment-7-3",
              "text": "nom",
              "vocabularyId": "word-nom"
            },
            {
              "id": "segment-7-4",
              "text": " est Martin."
            }
          ],
          "speakerId": "speaker-1",
          "translationZh": "我姓 Martin。"
        },
        {
          "id": "entry-8",
          "segments": [
            {
              "id": "segment-8-1",
              "text": "Merci",
