  "blocks": [
    {
      "id": "scene-main",
      "illustrationId": "art-first-conversations",
      "placeZh": "一次社区活动中的初次交谈",
      "situationZh": "没听懂时请求重复或放慢语速。",
      "type": "scene"
    },
    {
      "id": "dialogue-main",
      "speakers": [
        {
          "avatarId": "avatar-camille-v1",
          "characterId": "character-camille",
          "displayName": "Camille",
          "id": "speaker-1",
          "labelZh": "初次相识"
        },
        {
          "avatarId": "avatar-lea-v1",
          "characterId": "character-lea",
          "displayName": "Léa",
          "id": "speaker-2",
          "labelZh": "初次相识"
        }
      ],
      "titleZh": "请对方再说一次",
      "turns": [
        {
          "id": "entry-1",
          "segments": [
            {
              "id": "segment-1-1",
              "text": "Pardon",
              "vocabularyId": "word-pardon"
            },
            {
              "id": "segment-1-2",
              "text": ", je "
            },
            {
              "grammarId": "grammar-negation-comprendre",
              "id": "segment-1-3",
              "text": "ne"
            },
            {
              "id": "segment-1-4",
              "text": " "
            },
            {
              "id": "segment-1-5",
              "text": "comprends",
              "vocabularyId": "word-comprendre"
            },
            {
              "id": "segment-1-6",
              "text": " pas."
            }
          ],
          "speakerId": "speaker-1",
          "translationZh": "对不起，我没有听懂。"
        },
        {
          "id": "entry-2",
          "segments": [
            {
              "id": "segment-2-1",
              "text": "Je m’appelle Léa."
            }
          ],
          "speakerId": "speaker-2",
          "translationZh": "我叫 Léa。"
        },
        {
          "id": "entry-3",
          "segments": [
            {
              "grammarId": "grammar-pouvoir-repeat",
              "id": "segment-3-1",
              "text": "Vous pouvez"
            },
            {
              "id": "segment-3-2",
              "text": " "
            },
            {
              "id": "segment-3-3",
              "text": "répéter",
              "vocabularyId": "word-repeter"
            },
            {
              "id": "segment-3-4",
              "text": ", "
            },
            {
              "id": "segment-3-5",
              "text": "s’il vous plaît",
              "vocabularyId": "expr-sil-vous-plait"
            },
            {
              "id": "segment-3-6",
              "text": " ?"
            }
          ],
          "speakerId": "speaker-1",
          "translationZh": "请您再说一遍，好吗？"
        },
        {
          "id": "entry-4",
          "segments": [
            {
              "id": "segment-4-1",
              "text": "Oui",
              "vocabularyId": "word-oui"
            },
            {
              "id": "segment-4-2",
              "text": ". Je m’appelle Léa."
            }
          ],
          "speakerId": "speaker-2",
          "translationZh": "好的。我叫 Léa。"
        },
        {
          "id": "entry-5",
          "segments": [
            {
              "id": "segment-5-1",
              "text": "Plus lentement",
              "vocabularyId": "expr-plus-lentement"
            },
            {
              "id": "segment-5-2",
              "text": ", "
            },
            {
              "id": "segment-5-3",
              "text": "s’il vous plaît",
              "vocabularyId": "expr-sil-vous-plait"
            },
            {
              "id": "segment-5-4",
              "text": "."
            }
          ],
          "speakerId": "speaker-1",
          "translationZh": "请慢一点。"
        },
        {
