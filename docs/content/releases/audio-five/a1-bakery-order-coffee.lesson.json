  "blocks": [
    {
      "id": "scene-main",
      "illustrationId": "art-bakery-morning",
      "placeZh": "一家社区面包店",
      "situationZh": "点咖啡或茶，并说明是否加牛奶。",
      "type": "scene"
    },
    {
      "id": "dialogue-main",
      "speakers": [
        {
          "avatarId": "avatar-luc-v1",
          "characterId": "character-luc",
          "displayName": "Luc",
          "id": "speaker-1",
          "labelZh": "店员"
        },
        {
          "avatarId": "avatar-camille-v1",
          "characterId": "character-camille",
          "displayName": "Camille",
          "id": "speaker-2",
          "labelZh": "顾客"
        }
      ],
      "titleZh": "再来一杯饮品",
      "turns": [
        {
          "id": "entry-1",
          "segments": [
            {
              "id": "segment-1-1",
              "text": "Bonjour !"
            }
          ],
          "speakerId": "speaker-1",
          "translationZh": "您好！"
        },
        {
          "id": "entry-2",
          "segments": [
            {
              "grammarId": "grammar-drink-un",
              "id": "segment-2-1",
              "text": "Un"
            },
            {
              "id": "segment-2-2",
              "text": " "
            },
            {
              "id": "segment-2-3",
              "text": "café",
              "vocabularyId": "word-cafe"
            },
            {
              "id": "segment-2-4",
              "text": ", "
            },
            {
              "id": "segment-2-5",
              "text": "s’il vous plaît",
              "vocabularyId": "expr-sil-vous-plait"
            },
            {
              "id": "segment-2-6",
              "text": "."
            }
          ],
          "speakerId": "speaker-2",
          "translationZh": "请给我一杯咖啡。"
        },
        {
          "id": "entry-3",
          "segments": [
            {
              "id": "segment-3-1",
              "text": "Avec",
              "vocabularyId": "word-avec"
            },
            {
              "id": "segment-3-2",
              "text": " du "
            },
            {
              "id": "segment-3-3",
              "text": "lait",
              "vocabularyId": "word-lait"
            },
            {
              "id": "segment-3-4",
              "text": " ?"
            }
          ],
          "speakerId": "speaker-1",
          "translationZh": "加牛奶吗？"
        },
        {
          "id": "entry-4",
          "segments": [
            {
              "id": "segment-4-1",
              "text": "Oui",
              "vocabularyId": "word-oui"
            },
            {
              "id": "segment-4-2",
              "text": ", "
            },
            {
              "id": "segment-4-3",
              "text": "avec",
              "vocabularyId": "word-avec"
            },
            {
              "id": "segment-4-4",
              "text": " du "
            },
            {
              "id": "segment-4-5",
              "text": "lait",
              "vocabularyId": "word-lait"
            },
            {
              "id": "segment-4-6",
              "text": "."
            }
          ],
          "speakerId": "speaker-2",
          "translationZh": "是的，加牛奶。"
        },
        {
          "id": "entry-5",
          "segments": [
            {
              "id": "segment-5-1",
              "text": "Et pour votre amie ?"
            }
          ],
          "speakerId": "speaker-1",
          "translationZh": "您的朋友呢？"
        },
        {
          "id": "entry-6",
          "segments": [
            {
              "grammarId": "grammar-drink-un",
              "id": "segment-6-1",
              "text": "Un"
            },
            {
              "id": "segment-6-2",
              "text": " "
            },
            {
