  "levelId": "a1",
  "unitId": "a1-home-routine",
  "title": {
    "fr": "J’étudie à la maison",
    "zh": "工作与学习的一天"
  },
  "summaryZh": "与朋友聊今天在家学习的安排和休息时间。",
  "estimatedMinutes": 12,
  "objectivesZh": [
    "区分工作与学习",
    "使用 j’étudie 和 tu étudies",
    "连接两个日常动作"
  ],
  "knowledge": {
    "vocabulary": [
      {
        "id": "word-etudier",
        "lemma": "étudier",
        "partOfSpeech": "verb",
        "meaningZh": "学习",
        "noteZh": "j’étudie、tu étudies 分别表示“我学习”“你学习”。"
      },
      {
        "id": "word-travailler",
        "lemma": "travailler",
        "partOfSpeech": "verb",
        "meaningZh": "工作",
        "noteZh": "正文的 je travaille 表示“我工作”。"
      },
      {
        "id": "word-maison",
        "lemma": "maison",
        "partOfSpeech": "noun",
        "meaningZh": "房屋；家",
        "noteZh": "à la maison 表示在家。",
        "gender": "feminine"
      },
      {
        "id": "word-exercice",
        "lemma": "exercice",
        "partOfSpeech": "noun",
        "meaningZh": "练习",
        "noteZh": "exercice 的单数形式；搭配冠词学习。",
        "gender": "masculine"
      },
      {
        "id": "word-pause",
        "lemma": "pause",
        "partOfSpeech": "noun",
        "meaningZh": "休息；暂停",
        "noteZh": "faire une pause 表示休息一会儿。",
        "gender": "feminine"
      },
      {
        "id": "word-commencer",
        "lemma": "commencer",
        "partOfSpeech": "verb",
        "meaningZh": "开始",
        "noteZh": "je commence 表示我开始。"
      },
      {
        "id": "word-finir",
        "lemma": "finir",
        "partOfSpeech": "verb",
        "meaningZh": "结束；完成",
        "noteZh": "je finis 表示我结束或完成。"
      },
      {
        "id": "word-midi",
        "lemma": "midi",
        "partOfSpeech": "noun",
        "meaningZh": "中午十二点",
        "noteZh": "à midi 表示在中午十二点。",
        "gender": "masculine"
      }
    ],
    "grammar": [
      {
        "id": "grammar-etudier-present",
        "titleZh": "étudier 的现在时",
        "bodyZh": "étudier 去掉 -er 后接现在时词尾：je 配 -e，tu 配 -es。je 在元音前省音，所以写 j’étudie；tu étudies 保留 tu。",
        "examples": [
          {
            "fr": "Tu étudies le français.",
            "zh": "你学习法语。"
          }
        ]
      },
      {
        "id": "grammar-et-connect",
        "titleZh": "et：连接两个动作",
        "bodyZh": "et 连接两个并列动作。J’étudie le français et je fais un exercice 先说学习，再补充做练习；je fais 本课作为“我做”的常用语块理解。",
        "examples": [
          {
            "fr": "J’étudie le français et je fais un exercice.",
            "zh": "我学习法语并做一道练习。"
          }
        ]
      }
    ]
  },
