              "id": "segment-3-4",
              "text": " "
            },
            {
              "id": "segment-3-5",
              "text": "par carte",
              "vocabularyId": "expr-par-carte"
            },
            {
              "id": "segment-3-6",
              "text": " ?"
            }
          ],
          "translationZh": "我可以用银行卡付款吗？"
        },
        {
          "id": "entry-4",
          "speakerId": "speaker-2",
          "segments": [
            {
              "id": "segment-4-1",
              "text": "Oui. Vous pouvez aussi "
            },
            {
              "id": "segment-4-2",
              "text": "payer",
              "vocabularyId": "word-payer"
            },
            {
              "id": "segment-4-3",
              "text": " "
            },
            {
              "id": "segment-4-4",
              "text": "en espèces",
              "vocabularyId": "expr-en-especes"
            },
            {
              "id": "segment-4-5",
              "text": "."
            }
          ],
          "translationZh": "可以。您也可以用现金付款。"
        },
        {
          "id": "entry-5",
          "speakerId": "speaker-1",
          "segments": [
            {
              "id": "segment-5-1",
              "text": "Par carte",
              "vocabularyId": "expr-par-carte"
            },
            {
              "id": "segment-5-2",
              "text": ", alors."
            }
          ],
          "translationZh": "那就用银行卡。"
        },
        {
          "id": "entry-6",
          "speakerId": "speaker-2",
          "segments": [
            {
              "id": "segment-6-1",
              "text": "Voilà",
