  "unitId": "a1-breakfast-bakery",
  "title": {
    "fr": "Je peux payer par carte ?",
    "zh": "询价与付款"
  },
  "summaryZh": "听懂示例价格，询问是否可以刷卡付款。",
  "estimatedMinutes": 12,
  "objectivesZh": [
    "询问总价",
    "辨认现金和银行卡支付",
    "询问能否使用一种付款方式"
  ],
  "knowledge": {
    "vocabulary": [
      {
        "id": "word-euro",
        "lemma": "euro",
        "partOfSpeech": "noun",
        "meaningZh": "欧元",
        "noteZh": "复数 euros；课程价格均为虚构教学设定。",
        "gender": "masculine"
      },
      {
        "id": "expr-par-carte",
        "lemma": "par carte",
        "partOfSpeech": "phrase",
        "meaningZh": "用银行卡",
        "noteZh": "payer par carte 表示刷卡或用银行卡支付。"
      },
      {
        "id": "expr-en-especes",
        "lemma": "en espèces",
        "partOfSpeech": "phrase",
        "meaningZh": "用现金",
        "noteZh": "payer en espèces 表示现金付款。"
      },
      {
        "id": "word-payer",
        "lemma": "payer",
        "partOfSpeech": "verb",
        "meaningZh": "付款",
        "noteZh": "Je peux payer…? 询问能否用某种方式付款。"
      },
      {
        "id": "word-voila",
        "lemma": "voilà",
        "partOfSpeech": "interjection",
        "meaningZh": "给您；就是这里",
        "noteZh": "在交付商品或票据时，Voilà 可以表示“给您”。"
      },
      {
        "id": "word-merci",
        "lemma": "merci",
        "partOfSpeech": "interjection",
        "meaningZh": "谢谢",
        "noteZh": "用于表达感谢。"
      },
      {
        "id": "expr-cest-combien",
        "lemma": "c’est combien",
        "partOfSpeech": "phrase",
        "meaningZh": "多少钱？",
        "noteZh": "询价的常用口语。本例的价格只是教学情景设定。"
      },
      {
        "id": "expr-au-revoir",
        "lemma": "au revoir",
        "partOfSpeech": "phrase",
        "meaningZh": "再见",
        "noteZh": "结束交谈、离开时使用。"
      }
    ],
    "grammar": [
      {
        "id": "grammar-pouvoir-pay",
        "titleZh": "Je peux + 动词原形",
        "bodyZh": "peux 是 pouvoir 的第一人称单数现在时。Je peux payer…? 在本课询问某种付款方式是否可行，payer 保留原形。",
        "examples": [
          {
            "fr": "Je peux payer par carte ?",
            "zh": "我可以用银行卡付款吗？"
          }
        ]
      },
      {
        "id": "grammar-price-euros",
        "titleZh": "euros：金额中的复数",
        "bodyZh": "本课 quatre euros 是四欧元，euro 在这里写成复数 euros。用数字表示金额时，低于二用单数，例如 1,20 euro；二及以上用复数，例如 2 euros。本课价格只用于练习。",
        "examples": [
          {
            "fr": "Quatre euros.",
            "zh": "四欧元。"
          }
        ]
      }
    ]
  },
