            },
            {
              "id": "segment-6-2",
              "text": " votre ticket."
            }
          ],
          "translationZh": "这是您的小票。"
        },
        {
          "id": "entry-7",
          "speakerId": "speaker-1",
          "segments": [
            {
              "id": "segment-7-1",
              "text": "Merci",
              "vocabularyId": "word-merci"
            },
            {
              "id": "segment-7-2",
              "text": ", "
            },
            {
              "id": "segment-7-3",
              "text": "au revoir",
              "vocabularyId": "expr-au-revoir"
            },
            {
              "id": "segment-7-4",
              "text": "."
