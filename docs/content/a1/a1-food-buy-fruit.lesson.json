            },
            {
              "id": "segment-1-3",
              "text": " un "
            },
            {
              "id": "segment-1-4",
              "text": "kilo",
              "vocabularyId": "word-kilo",
              "grammarId": "grammar-kilo-de"
            },
            {
              "id": "segment-1-5",
              "text": " de "
            },
            {
              "id": "segment-1-6",
              "text": "pommes",
              "vocabularyId": "word-pomme",
              "grammarId": "grammar-food-plural"
            },
            {
              "id": "segment-1-7",
              "text": ", s’il vous plaît."
            }
          ],
          "translationZh": "您好，我想要一公斤苹果，谢谢。"
        },
        {
          "id": "entry-2",
          "speakerId": "speaker-2",
          "segments": [
            {
              "id": "segment-2-1",
              "text": "Bonjour. Des "
            },
            {
              "id": "segment-2-2",
              "text": "pommes",
              "vocabularyId": "word-pomme"
            },
            {
              "id": "segment-2-3",
              "text": " "
            },
            {
              "id": "segment-2-4",
              "text": "rouges",
              "vocabularyId": "word-rouge"
            },
            {
              "id": "segment-2-5",
              "text": " ou "
            },
            {
              "id": "segment-2-6",
              "text": "vertes",
              "vocabularyId": "word-vert"
            },
            {
              "id": "segment-2-7",
              "text": " ?"
            }
          ],
          "translationZh": "您好。红苹果还是绿苹果？"
        },
        {
          "id": "entry-3",
          "speakerId": "speaker-1",
          "segments": [
            {
              "id": "segment-3-1",
              "text": "Des "
            },
            {
              "id": "segment-3-2",
              "text": "pommes",
              "vocabularyId": "word-pomme"
            },
            {
              "id": "segment-3-3",
              "text": " "
            },
            {
              "id": "segment-3-4",
              "text": "rouges",
              "vocabularyId": "word-rouge"
            },
            {
              "id": "segment-3-5",
              "text": ", et deux "
            },
            {
              "id": "segment-3-6",
              "text": "bananes",
              "vocabularyId": "word-banane",
              "grammarId": "grammar-food-plural"
            },
            {
              "id": "segment-3-7",
              "text": "."
            }
          ],
          "translationZh": "红苹果，再加两根香蕉。"
        },
        {
          "id": "entry-4",
          "speakerId": "speaker-2",
          "segments": [
            {
              "id": "segment-4-1",
              "text": "Vous voulez autre chose ?"
            }
          ],
          "translationZh": "您还想要别的吗？"
        },
        {
          "id": "entry-5",
          "speakerId": "speaker-1",
          "segments": [
            {
              "id": "segment-5-1",
              "text": "Non, merci. "
            },
            {
              "id": "segment-5-2",
              "text": "C’est combien",
              "vocabularyId": "expr-cest-combien"
            },
            {
              "id": "segment-5-3",
              "text": " ?"
            }
          ],
          "translationZh": "不用了，谢谢。多少钱？"
        },
        {
          "id": "entry-6",
          "speakerId": "speaker-2",
          "segments": [
            {
              "id": "segment-6-1",
              "text": "Cinq "
            },
            {
              "id": "segment-6-2",
              "text": "euros",
              "vocabularyId": "word-euro"
            },
            {
              "id": "segment-6-3",
              "text": "."
            }
          ],
          "translationZh": "五欧元。"
        },
        {
          "id": "entry-7",
          "speakerId": "speaker-1",
          "segments": [
            {
              "id": "segment-7-1",
              "text": "Voilà. Merci."
            }
          ],
          "translationZh": "给您。谢谢。"
        },
        {
          "id": "entry-8",
          "speakerId": "speaker-2",
          "segments": [
            {
              "id": "segment-8-1",
              "text": "Merci, au revoir."
            }
          ],
          "translationZh": "谢谢，再见。"
        }
      ]
    },
