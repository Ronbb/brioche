{
  "schemaVersion": "1.0",
  "id": "a1-food-buy-fruit",
  "revision": 1,
  "levelId": "a1",
  "unitId": "a1-food-shopping",
  "title": {
    "fr": "Un kilo de pommes",
    "zh": "在市场买水果"
  },
  "summaryZh": "选择水果、说明重量和数量，并听懂总价。",
  "estimatedMinutes": 12,
  "objectivesZh": [
    "用重量说明想买的水果",
    "理解商品复数",
    "询问总价"
  ],
  "knowledge": {
    "vocabulary": [
      {
        "id": "word-pomme",
        "lemma": "pomme",
        "partOfSpeech": "noun",
        "meaningZh": "苹果",
        "noteZh": "une pomme；复数 pommes，数量可说 un kilo de pommes。",
        "gender": "feminine"
      },
      {
        "id": "word-banane",
        "lemma": "banane",
        "partOfSpeech": "noun",
        "meaningZh": "香蕉",
        "noteZh": "une banane；复数 bananes。",
        "gender": "feminine"
      },
      {
        "id": "word-kilo",
        "lemma": "kilo",
        "partOfSpeech": "noun",
        "meaningZh": "千克；公斤",
        "noteZh": "kilogramme 的常用简写；un kilo de 后接商品。",
        "gender": "masculine"
      },
      {
        "id": "word-rouge",
        "lemma": "rouge",
        "partOfSpeech": "adjective",
        "meaningZh": "红色的",
        "noteZh": "des pommes rouges 表示红苹果；rouge 的复数加 s。"
      },
      {
        "id": "word-vert",
        "lemma": "vert",
        "partOfSpeech": "adjective",
        "meaningZh": "绿色的",
        "noteZh": "des pommes vertes 中 vert 与阴性复数 pommes 配合，写 vertes。"
      },
      {
        "id": "expr-je-voudrais",
        "lemma": "je voudrais",
        "partOfSpeech": "phrase",
        "meaningZh": "我想要……",
        "noteZh": "礼貌地提出请求。本课先作为常用语块学习。"
      },
      {
        "id": "expr-cest-combien",
        "lemma": "c’est combien",
        "partOfSpeech": "phrase",
        "meaningZh": "多少钱？",
        "noteZh": "询价的常用口语。本例的价格只是教学情景设定。"
      },
      {
        "id": "word-euro",
        "lemma": "euro",
        "partOfSpeech": "noun",
        "meaningZh": "欧元",
        "noteZh": "复数 euros；课程价格均为虚构教学设定。",
        "gender": "masculine"
      }
    ],
    "grammar": [
      {
        "id": "grammar-kilo-de",
        "titleZh": "数量 + de + 商品",
        "bodyZh": "un kilo de pommes 说明苹果的重量。kilo 后的 de 连接商品，后面直接用复数 pommes，不写 de des pommes。",
        "examples": [
          {
            "fr": "Je voudrais un kilo de pommes.",
            "zh": "我想要一公斤苹果。"
          }
        ]
      },
      {
        "id": "grammar-food-plural",
        "titleZh": "pommes / bananes：商品复数",
        "bodyZh": "本课 pomme、banane 的书面复数在词尾加 s。读数量要听前面的数字或重量表达，不能只靠通常不发音的词尾 s。",
        "examples": [
          {
            "fr": "Deux bananes.",
            "zh": "两根香蕉。"
          }
        ]
      }
    ]
  },
  "blocks": [
    {
