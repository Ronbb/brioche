{
  "schemaVersion": "1.0",
  "id": "a1-social-invite-coffee",
  "revision": 1,
  "levelId": "a1",
  "unitId": "a1-social-meetings",
  "title": {
    "fr": "On peut prendre un café ?",
    "zh": "邀请朋友喝咖啡"
  },
  "summaryZh": "询问朋友是否有空，再确定活动、时刻与见面地点。",
  "estimatedMinutes": 12,
  "objectivesZh": [
    "询问对方是否有空",
    "用 on peut 提出邀约",
    "确认见面的时刻"
  ],
  "knowledge": {
    "vocabulary": [
      {
        "id": "word-libre",
        "lemma": "libre",
        "partOfSpeech": "adjective",
        "meaningZh": "有空的",
        "noteZh": "Tu es libre…? 在约见中询问对方是否有空。"
      },
      {
        "id": "word-pouvoir",
        "lemma": "pouvoir",
        "partOfSpeech": "verb",
        "meaningZh": "能；可以",
        "noteZh": "本单元学习 je peux、tu peux、on peut；后接动词原形。"
      },
      {
        "id": "word-prendre",
        "lemma": "prendre",
        "partOfSpeech": "verb",
        "meaningZh": "拿；乘；用餐或饮用",
        "noteZh": "本课 prendre un café 表示喝杯咖啡；prendre le métro 表示乘地铁。"
      },
      {
        "id": "word-ensemble",
        "lemma": "ensemble",
        "partOfSpeech": "adverb",
        "meaningZh": "一起",
        "noteZh": "本课用于朋友一起活动的安排。"
      },
      {
        "id": "word-samedi",
        "lemma": "samedi",
        "partOfSpeech": "noun",
        "meaningZh": "星期六",
        "noteZh": "星期名称作名词时为阳性；描述每周习惯可在前面加 le。",
        "gender": "masculine"
      },
      {
        "id": "word-cafe",
        "lemma": "café",
        "partOfSpeech": "noun",
        "meaningZh": "咖啡",
        "noteZh": "本课指饮品；un café 可以表示一杯咖啡。",
        "gender": "masculine"
      },
      {
        "id": "expr-a-quelle-heure",
        "lemma": "à quelle heure",
        "partOfSpeech": "phrase",
        "meaningZh": "几点？",
        "noteZh": "询问事情发生的时刻。"
      },
      {
        "id": "word-quinze",
        "lemma": "quinze",
        "partOfSpeech": "numeral",
        "meaningZh": "十五",
        "noteZh": "quinze heures 表示十五点，即下午三点。"
      }
    ],
    "grammar": [
      {
        "id": "grammar-pouvoir-invite",
        "titleZh": "pouvoir + 动词原形：提出安排",
        "bodyZh": "本课 je peux、tu peux、on peut 后接动词原形。口语中 on 可表示“我们”，但动词仍用第三人称单数 peut。On peut prendre un café ? 用来提议一起喝咖啡。",
        "examples": [
          {
            "fr": "On peut prendre un café ensemble ?",
            "zh": "我们可以一起喝杯咖啡吗？"
          }
        ]
      },
      {
        "id": "grammar-invite-time-question",
        "titleZh": "À quelle heure ?：询问时刻",
        "bodyZh": "À quelle heure ? 询问某件事在几点。答复用 à + 时刻；quinze heures 是十五点，即下午三点。本课不省略地点确认。",
        "examples": [
          {
            "fr": "À quelle heure ? À quinze heures.",
            "zh": "几点？下午三点。"
          }
        ]
      }
    ]
  },
  "blocks": [
    {
      "id": "scene-main",
      "type": "scene",
      "placeZh": "Camille 与 Léa 商量公园旁的咖啡见面",
      "situationZh": "询问朋友是否有空，再确定活动、时刻与见面地点。",
      "illustrationId": "art-park-meeting"
    },
    {
