        {
          "id": "speaker-2",
          "labelZh": "朋友",
          "characterId": "character-lea",
          "displayName": "Léa",
          "avatarId": "avatar-lea-v1"
        }
      ],
      "turns": [
        {
          "id": "entry-1",
          "speakerId": "speaker-1",
          "segments": [
            {
              "id": "segment-1-1",
              "text": "Tu es "
            },
            {
              "id": "segment-1-2",
              "text": "libre",
              "vocabularyId": "word-libre"
            },
            {
              "id": "segment-1-3",
              "text": " "
            },
            {
              "id": "segment-1-4",
              "text": "samedi",
              "vocabularyId": "word-samedi"
            },
            {
              "id": "segment-1-5",
              "text": " ?"
            }
          ],
          "translationZh": "你星期六有空吗？"
        },
        {
          "id": "entry-2",
          "speakerId": "speaker-2",
          "segments": [
            {
              "id": "segment-2-1",
              "text": "Oui, pourquoi ?"
            }
          ],
          "translationZh": "有，怎么了？"
        },
        {
          "id": "entry-3",
          "speakerId": "speaker-1",
          "segments": [
            {
              "id": "segment-3-1",
              "text": "On "
            },
            {
              "id": "segment-3-2",
              "text": "peut",
              "vocabularyId": "word-pouvoir",
              "grammarId": "grammar-pouvoir-invite"
            },
            {
              "id": "segment-3-3",
              "text": " "
            },
            {
              "id": "segment-3-4",
              "text": "prendre",
              "vocabularyId": "word-prendre"
            },
            {
              "id": "segment-3-5",
              "text": " un "
            },
            {
              "id": "segment-3-6",
              "text": "café",
              "vocabularyId": "word-cafe"
            },
            {
              "id": "segment-3-7",
              "text": " "
            },
            {
              "id": "segment-3-8",
              "text": "ensemble",
              "vocabularyId": "word-ensemble"
            },
            {
              "id": "segment-3-9",
              "text": " ?"
            }
          ],
          "translationZh": "我们可以一起喝杯咖啡吗？"
        },
        {
          "id": "entry-4",
          "speakerId": "speaker-2",
          "segments": [
            {
              "id": "segment-4-1",
              "text": "Oui, bonne idée. "
            },
            {
              "id": "segment-4-2",
              "text": "À quelle heure",
              "vocabularyId": "expr-a-quelle-heure",
              "grammarId": "grammar-invite-time-question"
            },
            {
              "id": "segment-4-3",
              "text": " ?"
            }
          ],
          "translationZh": "可以，好主意。几点？"
        },
        {
          "id": "entry-5",
          "speakerId": "speaker-1",
          "segments": [
            {
              "id": "segment-5-1",
              "text": "À "
            },
            {
              "id": "segment-5-2",
              "text": "quinze",
              "vocabularyId": "word-quinze"
            },
            {
              "id": "segment-5-3",
              "text": " heures."
            }
          ],
          "translationZh": "下午三点。"
        },
        {
          "id": "entry-6",
          "speakerId": "speaker-2",
          "segments": [
            {
              "id": "segment-6-1",
              "text": "D’accord. Au café près du parc ?"
            }
          ],
          "translationZh": "好的。在公园旁的咖啡馆吗？"
        },
        {
          "id": "entry-7",
          "speakerId": "speaker-1",
          "segments": [
            {
              "id": "segment-7-1",
              "text": "Oui, devant le café."
            }
          ],
          "translationZh": "对，在咖啡馆前面。"
        },
        {
          "id": "entry-8",
          "speakerId": "speaker-2",
          "segments": [
            {
              "id": "segment-8-1",
              "text": "Parfait, à "
            },
            {
              "id": "segment-8-2",
              "text": "samedi",
              "vocabularyId": "word-samedi"
            },
            {
              "id": "segment-8-3",
              "text": " !"
            }
          ],
          "translationZh": "太好了，星期六见！"
        }
      ]
    },
    {
      "id": "explanation-main",
      "type": "explanation",
      "titleZh": "这句话如何使用",
      "bodyZh": "这里的 on 表示“我们”，仍与 peut 搭配，后面的 prendre 用原形。À quelle heure ? 询问时刻。un café 在第三句是饮品；au café 和 devant le café 中 café 是地点“咖啡馆”。本课确认星期六下午三点在咖啡馆前见面。",
      "targets": [
        {
          "blockId": "dialogue-main",
          "entryId": "entry-3",
          "segmentId": "segment-3-2"
        },
        {
          "blockId": "dialogue-main",
          "entryId": "entry-4",
          "segmentId": "segment-4-2"
        }
      ]
    },
    {
      "id": "culture-context",
      "type": "culture",
      "titleZh": "场景中的细节",
      "bodyZh": "邀约方式、咖啡馆和见面时间是虚构情境，见面地点需要双方确认；没有要求学习者真实邀约或披露日程。",
      "scopeZh": "本课虚构场景，不概括所有法语地区或个人的行为。"
    },
