  "title": {
    "fr": "La semaine de Léa",
    "zh": "一周的日常习惯"
  },
  "summaryZh": "从一周安排中找出工作地点，并用否定表达休息日。",
  "estimatedMinutes": 12,
  "objectivesZh": [
    "找到星期与对应安排",
    "用 le + 星期说每周习惯",
    "用 ne…pas 否定动作"
  ],
