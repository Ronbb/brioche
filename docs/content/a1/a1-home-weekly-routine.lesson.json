    "grammar": [
      {
        "id": "grammar-negation-ne-pas",
        "titleZh": "ne…pas：否定一个动作",
        "bodyZh": "书面完整否定形式把 ne 放在变位动词前、pas 放在后：elle ne travaille pas。元音或哑音 h 前 ne 省音为 n’。",
        "examples": [
          {
            "fr": "Elle ne travaille pas le dimanche.",
            "zh": "她星期日不工作。"
          }
        ]
      },
      {
        "id": "grammar-le-weekday-habit",
        "titleZh": "le + 星期：每周的习惯",
        "bodyZh": "本课 Le mercredi, elle travaille à la maison 表示每周三的安排。说某一次星期三可直接用 mercredi；本课练习重复的每周习惯。",
        "examples": [
          {
            "fr": "Le mercredi, elle travaille à la maison.",
            "zh": "她每周三在家工作。"
          }
        ]
      }
    ]
  },
  "blocks": [
    {
      "id": "scene-main",
      "type": "scene",
      "placeZh": "Léa 的虚构一周日程",
      "situationZh": "从一周安排中找出工作地点，并用否定表达休息日。",
      "illustrationId": "art-home-morning"
    },
    {
      "id": "article-main",
      "type": "article",
      "titleZh": "一周的日常习惯",
      "narratorId": "character-lea",
      "paragraphs": [
        {
          "id": "entry-1",
          "segments": [
            {
              "id": "segment-1-1",
              "text": "Léa travaille à Lyon."
            }
          ],
          "translationZh": "Léa 在里昂工作。"
        },
        {
          "id": "entry-2",
          "segments": [
            {
              "id": "segment-2-1",
              "text": "Le "
            },
            {
              "id": "segment-2-2",
              "text": "lundi",
              "vocabularyId": "word-lundi",
              "grammarId": "grammar-le-weekday-habit"
            },
            {
              "id": "segment-2-3",
              "text": " et le "
            },
            {
              "id": "segment-2-4",
              "text": "mardi",
              "vocabularyId": "word-mardi"
            },
            {
              "id": "segment-2-5",
              "text": ", elle travaille au bureau."
            }
          ],
          "translationZh": "她每周一和周二在办公室工作。"
        },
        {
          "id": "entry-3",
          "segments": [
            {
              "id": "segment-3-1",
              "text": "Le "
            },
            {
              "id": "segment-3-2",
              "text": "mercredi",
              "vocabularyId": "word-mercredi",
              "grammarId": "grammar-le-weekday-habit"
            },
            {
              "id": "segment-3-3",
              "text": ", elle travaille à la maison."
            }
          ],
          "translationZh": "她每周三在家工作。"
        },
        {
          "id": "entry-4",
          "segments": [
            {
              "id": "segment-4-1",
              "text": "Elle commence à huit heures trente et elle finit à dix-sept heures."
            }
          ],
          "translationZh": "她八点半开始，十七点结束。"
        },
        {
          "id": "entry-5",
          "segments": [
            {
              "id": "segment-5-1",
              "text": "Le "
            },
            {
              "id": "segment-5-2",
              "text": "samedi",
              "vocabularyId": "word-samedi"
            },
            {
              "id": "segment-5-3",
              "text": ", elle fait les courses et elle prépare le repas."
            }
          ],
          "translationZh": "每周六，她采购日用品并准备饭菜。"
        },
        {
          "id": "entry-6",
          "segments": [
            {
              "id": "segment-6-1",
              "text": "Le "
            },
            {
              "id": "segment-6-2",
              "text": "dimanche",
              "vocabularyId": "word-dimanche"
            },
            {
              "id": "segment-6-3",
              "text": ", elle "
            },
            {
              "id": "segment-6-4",
              "text": "ne travaille pas",
              "grammarId": "grammar-negation-ne-pas"
            },
            {
              "id": "segment-6-5",
              "text": " : elle "
            },
            {
              "id": "segment-6-6",
              "text": "lit",
              "vocabularyId": "word-lire"
            },
            {
              "id": "segment-6-7",
              "text": " un "
            },
            {
              "id": "segment-6-8",
              "text": "livre",
              "vocabularyId": "word-livre"
            },
            {
              "id": "segment-6-9",
              "text": " et elle marche dans le "
            },
            {
              "id": "segment-6-10",
              "text": "parc",
              "vocabularyId": "word-parc"
            },
            {
              "id": "segment-6-11",
              "text": "."
            }
          ],
          "translationZh": "每周日，她不工作：她读书，还在公园散步。"
        },
        {
          "id": "entry-7",
          "segments": [
            {
              "id": "segment-7-1",
              "text": "Le soir, elle prépare son sac et regarde son agenda pour le lendemain."
            }
          ],
          "translationZh": "晚上，她收拾包，并查看日程本上第二天的安排。"
        }
      ]
    },
    {
      "id": "explanation-main",
      "type": "explanation",
      "titleZh": "这句话如何使用",
      "bodyZh": "le + 星期在这里表示每周的习惯。ne 和 pas 放在变位动词的两边。au bureau 在这里表示在办公室，区别于前课 un bureau 的书桌。faire les courses 是采购日常用品；le lendemain 是第二天。",
      "targets": [
        {
          "blockId": "article-main",
          "entryId": "entry-6",
          "segmentId": "segment-6-4"
        },
        {
          "blockId": "article-main",
          "entryId": "entry-2",
          "segmentId": "segment-2-2"
        }
      ]
    },
