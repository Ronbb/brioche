        "gender": "masculine"
      },
      {
        "id": "word-mercredi",
        "lemma": "mercredi",
        "partOfSpeech": "noun",
        "meaningZh": "星期三",
        "noteZh": "星期名称作名词时为阳性；描述每周习惯可在前面加 le。",
        "gender": "masculine"
      },
      {
        "id": "word-samedi",
        "lemma": "samedi",
        "partOfSpeech": "noun",
        "meaningZh": "星期六",
        "noteZh": "星期名称作名词时为阳性；描述每周习惯可在前面加 le。",
        "gender": "masculine"
      },
      {
        "id": "word-dimanche",
        "lemma": "dimanche",
        "partOfSpeech": "noun",
        "meaningZh": "星期日",
        "noteZh": "星期名称作名词时为阳性；描述每周习惯可在前面加 le。",
        "gender": "masculine"
      },
      {
        "id": "word-lire",
        "lemma": "lire",
