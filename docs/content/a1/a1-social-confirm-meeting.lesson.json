            },
            {
              "id": "segment-3-3",
              "text": " est "
            },
            {
              "id": "segment-3-4",
              "text": "à quinze heures",
              "grammarId": "grammar-time-a"
            },
            {
              "id": "segment-3-5",
              "text": " devant l’"
            },
            {
              "id": "segment-3-6",
              "text": "entrée",
              "vocabularyId": "word-entree"
            },
            {
              "id": "segment-3-7",
              "text": " du parc."
            }
          ],
          "translationZh": "约见定在下午三点，地点是公园入口前。"
        },
        {
          "id": "entry-4",
          "segments": [
            {
              "id": "segment-4-1",
              "text": "Camille prépare son sac et regarde le plan sur son téléphone."
            }
          ],
          "translationZh": "Camille 收拾包，并在手机上查看地图。"
        },
        {
          "id": "entry-5",
