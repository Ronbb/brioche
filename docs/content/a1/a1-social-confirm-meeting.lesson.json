            {
              "id": "segment-5-4",
              "text": "métro",
              "vocabularyId": "word-metro"
            },
            {
              "id": "segment-5-5",
              "text": " à quatorze heures trente."
            }
          ],
          "translationZh": "她打算下午两点半乘地铁。"
        },
