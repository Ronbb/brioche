{
  "schemaVersion": "1.0",
  "id": "a1-social-confirm-meeting",
  "revision": 1,
  "levelId": "a1",
  "unitId": "a1-social-meetings",
  "title": {
    "fr": "Demain, devant l’entrée du parc",
    "zh": "确认明天的约见"
  },
  "summaryZh": "从短文中找出约见地点、时刻和出门前的计划。",
  "estimatedMinutes": 12,
  "objectivesZh": [
    "读取约见地点与时刻",
    "用 aller + 原形表达计划",
    "区分出发与见面的时间"
  ],
  "knowledge": {
    "vocabulary": [
      {
        "id": "word-demain",
        "lemma": "demain",
        "partOfSpeech": "adverb",
        "meaningZh": "明天",
        "noteZh": "以说话时的当天为参照，具体日期由情境确定。"
      },
      {
        "id": "word-retrouver",
        "lemma": "retrouver",
        "partOfSpeech": "verb",
        "meaningZh": "与……见面；再见到",
        "noteZh": "本课 va retrouver Léa 表示打算与 Léa 碰面。"
      },
      {
        "id": "word-rendez-vous",
        "lemma": "rendez-vous",
        "partOfSpeech": "noun",
        "meaningZh": "约见；预约",
        "noteZh": "le rendez-vous；本课表示朋友约好的见面。",
        "gender": "masculine"
      },
      {
        "id": "word-entree",
        "lemma": "entrée",
        "partOfSpeech": "noun",
        "meaningZh": "入口",
        "noteZh": "l’entrée 是阴性名词，省音形式不表示阳性。",
        "gender": "feminine"
      },
      {
        "id": "word-avant",
        "lemma": "avant",
        "partOfSpeech": "preposition",
        "meaningZh": "在……之前",
        "noteZh": "avant quinze heures 表示十五点之前。"
      },
      {
        "id": "word-apporter",
        "lemma": "apporter",
        "partOfSpeech": "verb",
        "meaningZh": "带来",
        "noteZh": "本课 va apporter 表示打算带来。"
      },
      {
        "id": "word-metro",
        "lemma": "métro",
        "partOfSpeech": "noun",
        "meaningZh": "地铁",
        "noteZh": "le métro；本课线路和城市为虚构。",
        "gender": "masculine"
      },
      {
        "id": "word-message",
        "lemma": "message",
        "partOfSpeech": "noun",
        "meaningZh": "消息",
        "noteZh": "message 的单数形式；搭配冠词学习。",
        "gender": "masculine"
      }
    ],
    "grammar": [
      {
        "id": "grammar-futur-proche-plan",
        "titleZh": "aller + 动词原形：表达接下来的计划",
        "bodyZh": "本课用 aller 的现在时加动词原形表达计划：je vais prendre、elle va retrouver、elles vont marcher。后一个动词保留原形；这里的近期将来是语法名称，不意味着所有用法都有固定的时间上限。",
        "examples": [
          {
            "fr": "Je vais prendre le métro demain.",
            "zh": "我明天打算乘地铁。"
          }
        ]
      },
      {
        "id": "grammar-time-a",
        "titleZh": "à + 时刻：说明发生时间",
        "bodyZh": "Le train part à neuf heures dix 说明列车九点十分发车。à 引出事件发生的时刻。",
        "examples": [
          {
            "fr": "Le train part à neuf heures dix.",
            "zh": "列车九点十分发车。"
          }
        ]
      }
    ]
  },
