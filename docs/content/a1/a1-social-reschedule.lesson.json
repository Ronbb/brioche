    {
      "id": "explanation-main",
      "type": "explanation",
      "titleZh": "这句话如何使用",
      "bodyZh": "je ne peux pas 是完整否定，peux 是 pouvoir 的第一人称形式。对方先接受这个情况，再提出星期一。après dix-huit heures 是十八点之后，最终约定 dix-huit heures trente，即下午六点半。本课 se retrouver 作为“碰面”的常用搭配理解。",
      "targets": [
        {
          "blockId": "dialogue-main",
          "entryId": "entry-2",
          "segmentId": "segment-2-3"
        },
        {
          "blockId": "dialogue-main",
          "entryId": "entry-1",
          "segmentId": "segment-1-2"
        }
      ]
    },
