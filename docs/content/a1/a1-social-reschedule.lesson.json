  "levelId": "a1",
  "unitId": "a1-social-meetings",
  "title": {
    "fr": "Dimanche, je ne peux pas",
    "zh": "拒绝并提出新的时间"
  },
  "summaryZh": "说明当天不能参加，并确认另一个见面时间。",
  "estimatedMinutes": 12,
  "objectivesZh": [
    "用 je ne peux pas 说明不能参加",
    "给出简单原因",
    "确认改期后的时间"
  ],
  "knowledge": {
    "vocabulary": [
      {
        "id": "expr-desolee",
        "lemma": "désolée",
        "partOfSpeech": "phrase",
        "meaningZh": "抱歉",
        "noteZh": "本课 Léa 是女性，说 désolée；男性可写 désolé，读音相同。"
      },
      {
        "id": "word-pouvoir",
        "lemma": "pouvoir",
        "partOfSpeech": "verb",
        "meaningZh": "能；可以",
        "noteZh": "本单元学习 je peux、tu peux、on peut；后接动词原形。"
      },
      {
        "id": "word-dimanche",
        "lemma": "dimanche",
        "partOfSpeech": "noun",
        "meaningZh": "星期日",
        "noteZh": "星期名称作名词时为阳性；描述每周习惯可在前面加 le。",
        "gender": "masculine"
      },
      {
        "id": "word-lundi",
        "lemma": "lundi",
        "partOfSpeech": "noun",
        "meaningZh": "星期一",
        "noteZh": "星期名称作名词时为阳性；描述每周习惯可在前面加 le。",
        "gender": "masculine"
      },
      {
        "id": "word-apres",
        "lemma": "après",
        "partOfSpeech": "preposition",
        "meaningZh": "在……之后",
        "noteZh": "après dix-huit heures 表示十八点之后。"
      },
      {
        "id": "word-dix-huit",
        "lemma": "dix-huit",
        "partOfSpeech": "numeral",
        "meaningZh": "十八",
        "noteZh": "dix-huit heures 是十八点，即下午六点。"
      },
      {
        "id": "expr-pas-de-probleme",
        "lemma": "pas de problème",
        "partOfSpeech": "phrase",
        "meaningZh": "没问题",
        "noteZh": "本课用于接受对方不能参加的情况，再提出另一个日期。"
      },
      {
        "id": "word-libre",
        "lemma": "libre",
        "partOfSpeech": "adjective",
        "meaningZh": "有空的",
        "noteZh": "Tu es libre…? 在约见中询问对方是否有空。"
      }
    ],
    "grammar": [
      {
        "id": "grammar-ne-peux-pas",
        "titleZh": "Je ne peux pas：说明不能参加",
        "bodyZh": "pouvoir 的第一人称现在时是 peux。完整否定把 ne 和 pas 放在它两边：je ne peux pas venir。venir 保留原形；可以再说一个简单原因或提出新的时间。",
        "examples": [
          {
            "fr": "Je ne peux pas venir dimanche.",
            "zh": "我星期日不能来。"
          }
        ]
      },
      {
        "id": "grammar-pouvoir-invite",
        "titleZh": "pouvoir + 动词原形：提出安排",
        "bodyZh": "本课 je peux、tu peux、on peut 后接动词原形。口语中 on 可表示“我们”，但动词仍用第三人称单数 peut。On peut prendre un café ? 用来提议一起喝咖啡。",
        "examples": [
          {
            "fr": "On peut prendre un café ensemble ?",
            "zh": "我们可以一起喝杯咖啡吗？"
          }
        ]
      }
    ]
  },
