{
  "schemaVersion": "1.0",
  "id": "a1-city-find-metro",
  "revision": 1,
  "levelId": "a1",
  "unitId": "a1-city-travel",
  "title": {
    "fr": "Où est l’entrée du métro ?",
    "zh": "找到地铁入口"
  },
  "summaryZh": "问入口在哪里，理解简单的方向说明。",
  "estimatedMinutes": 12,
  "objectivesZh": [
    "礼貌地问路",
    "区分左右和直走",
    "确认入口位置"
  ],
  "knowledge": {
    "vocabulary": [
      {
        "id": "expr-excusez-moi",
        "lemma": "excusez-moi",
        "partOfSpeech": "other",
        "meaningZh": "打扰一下",
        "noteZh": "向尚不熟悉的人问路时，可先礼貌引起注意。"
      },
      {
        "id": "word-metro",
        "lemma": "métro",
        "partOfSpeech": "noun",
        "meaningZh": "地铁",
        "noteZh": "le métro；本课线路和城市为虚构。",
        "gender": "masculine"
      },
      {
        "id": "word-entree",
        "lemma": "entrée",
        "partOfSpeech": "noun",
        "meaningZh": "入口",
        "noteZh": "l’entrée 是阴性名词，省音形式不表示阳性。",
        "gender": "feminine"
      },
      {
        "id": "expr-ou-est",
        "lemma": "où est",
        "partOfSpeech": "phrase",
        "meaningZh": "……在哪里？",
        "noteZh": "où 带重音，表示“在哪里”；ou 不带重音表示“或者”。"
      },
      {
        "id": "expr-tout-droit",
        "lemma": "tout droit",
        "partOfSpeech": "phrase",
        "meaningZh": "直走",
        "noteZh": "在指路场景里表示继续向前。"
      },
      {
        "id": "expr-a-gauche",
        "lemma": "à gauche",
        "partOfSpeech": "phrase",
        "meaningZh": "在左边；向左",
        "noteZh": "根据上下文表示位置或转向。"
      },
      {
        "id": "expr-a-droite",
        "lemma": "à droite",
        "partOfSpeech": "phrase",
        "meaningZh": "在右边；向右",
        "noteZh": "根据上下文表示位置或转向。"
      },
      {
        "id": "expr-en-face",
        "lemma": "en face",
        "partOfSpeech": "phrase",
        "meaningZh": "在对面",
        "noteZh": "本课表示从当前所在位置看去的对面。"
      }
    ],
    "grammar": [
      {
        "id": "grammar-location-ou-est",
        "titleZh": "Où est…?：询问位置",
        "bodyZh": "où est 后面接要找的地方。où 带重音，区别于表示“或者”的 ou。",
        "examples": [
          {
            "fr": "Où est le métro ?",
            "zh": "地铁在哪里？"
          }
        ]
      },
      {
        "id": "grammar-direction-phrases",
        "titleZh": "位置与方向语块",
        "bodyZh": "tout droit 是直走；à gauche / à droite 表示左/右；en face 表示对面。具体移动方向要结合现场位置。",
        "examples": [
          {
            "fr": "Tout droit, puis à gauche.",
            "zh": "直走，然后向左。"
          }
        ]
      }
    ]
  },
