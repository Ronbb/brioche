          "id": "entry-6",
          "speakerId": "speaker-2",
          "segments": [
            {
              "id": "segment-6-1",
              "text": "Oui. L’"
            },
            {
              "id": "segment-6-2",
              "text": "entrée",
              "vocabularyId": "word-entree"
            },
            {
              "id": "segment-6-3",
              "text": " du "
