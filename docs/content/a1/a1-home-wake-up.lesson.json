  "levelId": "a1",
  "unitId": "a1-home-routine",
  "title": {
    "fr": "Le matin de Camille",
    "zh": "说说起床时间"
  },
  "summaryZh": "读懂一段早晨安排，分清起床、早餐和出门的时间。",
  "estimatedMinutes": 12,
  "objectivesZh": [
    "理解早晨安排的顺序",
    "说出起床时间",
    "区分整点和半点"
  ],
  "knowledge": {
    "vocabulary": [
      {
        "id": "word-se-lever",
        "lemma": "se lever",
        "partOfSpeech": "verb",
        "meaningZh": "起床",
        "noteZh": "正文 elle se lève；说自己时用 je me lève。"
      },
      {
        "id": "word-douche",
        "lemma": "douche",
        "partOfSpeech": "noun",
        "meaningZh": "淋浴",
        "noteZh": "prendre une douche 表示洗淋浴。",
        "gender": "feminine"
      },
      {
        "id": "word-sept",
        "lemma": "sept",
        "partOfSpeech": "numeral",
        "meaningZh": "七",
        "noteZh": "sept heures 表示七点。"
      },
      {
        "id": "word-trente",
        "lemma": "trente",
        "partOfSpeech": "numeral",
        "meaningZh": "三十",
        "noteZh": "sept heures trente 表示七点半。"
      },
      {
        "id": "word-huit",
        "lemma": "huit",
        "partOfSpeech": "numeral",
        "meaningZh": "八",
        "noteZh": "huit heures 表示八点。"
      },
      {
        "id": "word-preparer",
        "lemma": "préparer",
        "partOfSpeech": "verb",
        "meaningZh": "准备",
        "noteZh": "elle prépare 是第三人称单数现在时。"
      },
      {
        "id": "word-matin",
        "lemma": "matin",
        "partOfSpeech": "noun",
        "meaningZh": "早晨",
        "noteZh": "le matin 可用于描述早晨的习惯。",
        "gender": "masculine"
      },
      {
        "id": "word-heure",
        "lemma": "heure",
        "partOfSpeech": "noun",
        "meaningZh": "小时；时刻",
        "noteZh": "neuf heures dix 表示九点十分。",
        "gender": "feminine"
      }
    ],
    "grammar": [
      {
        "id": "grammar-se-lever-present",
        "titleZh": "se lever：说起床",
        "bodyZh": "se lever 中的小代词随主语变化：je me lève、elle se lève。本课只练习这两种形式，注意 lève 的重音符号。",
        "examples": [
          {
            "fr": "Je me lève à sept heures.",
            "zh": "我七点起床。"
          }
        ]
      },
      {
        "id": "grammar-time-a",
        "titleZh": "à + 时刻：说明发生时间",
        "bodyZh": "Le train part à neuf heures dix 说明列车九点十分发车。à 引出事件发生的时刻。",
        "examples": [
          {
            "fr": "Le train part à neuf heures dix.",
            "zh": "列车九点十分发车。"
          }
        ]
      }
    ]
  },
