  "unitId": "a1-first-conversations",
  "title": {
    "fr": "J’habite à Lyon",
    "zh": "说说自己"
  },
  "summaryZh": "说明居住城市和当前身份，并把问题转给对方。",
  "estimatedMinutes": 12,
  "objectivesZh": [
    "说出居住城市",
    "用一句话介绍身份",
    "询问对方的情况"
  ],
  "knowledge": {
    "vocabulary": [
      {
        "id": "expr-je-mappelle",
        "lemma": "je m’appelle",
        "partOfSpeech": "phrase",
        "meaningZh": "我叫……",
        "noteZh": "介绍名字的常用语块，后面接名字。"
      },
      {
        "id": "expr-et-vous",
        "lemma": "et vous",
        "partOfSpeech": "phrase",
        "meaningZh": "您呢？",
        "noteZh": "把刚才的问题转问对方。本组对话中双方尚不熟悉。"
      },
      {
        "id": "expr-jhabite",
        "lemma": "j’habite",
        "partOfSpeech": "other",
        "meaningZh": "我住……",
        "noteZh": "habiter 的第一人称单数现在时，后接居住地点。"
      },
      {
        "id": "expr-je-suis",
        "lemma": "je suis",
        "partOfSpeech": "phrase",
        "meaningZh": "我是……",
        "noteZh": "être 的第一人称单数现在时，后面可以接身份。"
      },
      {
        "id": "word-etudiante",
        "lemma": "étudiante",
        "partOfSpeech": "noun",
        "meaningZh": "女学生",
        "noteZh": "本课角色以女学生身份自我介绍；男性形式为 étudiant。",
        "gender": "feminine"
      },
      {
        "id": "word-travailler",
        "lemma": "travailler",
        "partOfSpeech": "verb",
        "meaningZh": "工作",
        "noteZh": "正文的 je travaille 表示“我工作”。"
      },
      {
        "id": "word-oui",
        "lemma": "oui",
        "partOfSpeech": "adverb",
        "meaningZh": "是的",
        "noteZh": "用于肯定回答。"
      }
    ],
    "grammar": [
      {
        "id": "grammar-etre-identity",
        "titleZh": "Je suis：说身份",
        "bodyZh": "suis 是 être 的第一人称单数现在时。Je suis étudiante 中，表示职业或身份的名词前通常不用冠词；本例的女性形式是 étudiante。",
        "examples": [
          {
            "fr": "Je suis étudiante.",
            "zh": "我是女学生。"
          }
        ]
      },
      {
        "id": "grammar-habiter-city",
        "titleZh": "à + 城市名称",
        "bodyZh": "J’habite à Lyon 说明居住在里昂。换成自己的城市时可以说 J’habite à + 城市名；国家名称的介词另行学习。",
        "examples": [
          {
            "fr": "J’habite à Lyon.",
            "zh": "我住在里昂。"
          }
        ]
      }
    ]
  },
