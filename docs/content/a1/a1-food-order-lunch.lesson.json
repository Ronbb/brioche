  "title": {
    "fr": "Une salade, s’il vous plaît",
    "zh": "看菜单并点餐"
  },
  "summaryZh": "说明用餐人数，表达对蔬菜的喜好，并选择餐点和饮品。",
  "estimatedMinutes": 12,
  "objectivesZh": [
    "说明用餐人数",
    "表达食物喜好",
    "从菜单信息选择餐点"
  ],
  "knowledge": {
    "vocabulary": [
      {
        "id": "word-menu-carte",
        "lemma": "carte",
        "partOfSpeech": "noun",
        "meaningZh": "菜单",
        "noteZh": "在餐馆场景中 la carte 指菜单，区别于银行卡。",
