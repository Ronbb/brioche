  "levelId": "a1",
  "unitId": "a1-social-meetings",
  "title": {
    "fr": "Voici mon ami Luc",
    "zh": "介绍一位朋友"
  },
  "summaryZh": "介绍朋友的名字、居住城市和喜好。",
  "estimatedMinutes": 12,
  "objectivesZh": [
    "把朋友介绍给另一人",
    "理解 mon ami 的搭配",
    "从对话找出城市与喜好"
  ],
  "knowledge": {
    "vocabulary": [
      {
        "id": "word-voici",
        "lemma": "voici",
        "partOfSpeech": "other",
        "meaningZh": "这是……；请看……",
        "noteZh": "本课用 voici 介绍眼前的人。"
      },
      {
        "id": "word-ami",
        "lemma": "ami",
        "partOfSpeech": "noun",
        "meaningZh": "朋友（男性）",
        "noteZh": "mon ami Luc 介绍男性朋友 Luc；女性形式为 amie。",
        "gender": "masculine"
      },
      {
        "id": "word-cinema",
        "lemma": "cinéma",
        "partOfSpeech": "noun",
        "meaningZh": "电影；电影院",
        "noteZh": "aimer le cinéma 表示喜欢电影；devant le cinéma 表示在电影院前。",
        "gender": "masculine"
      },
      {
        "id": "word-musique",
        "lemma": "musique",
        "partOfSpeech": "noun",
        "meaningZh": "音乐",
        "noteZh": "musique 的单数形式；搭配冠词学习。",
        "gender": "feminine"
      },
      {
        "id": "word-ensemble",
        "lemma": "ensemble",
        "partOfSpeech": "adverb",
        "meaningZh": "一起",
        "noteZh": "本课用于朋友一起活动的安排。"
      },
      {
        "id": "expr-enchante",
        "lemma": "enchanté",
        "partOfSpeech": "phrase",
        "meaningZh": "很高兴认识你",
        "noteZh": "本课 Luc 是男性，说 enchanté；女性可写 enchantée，读音相同。"
      },
      {
        "id": "word-aimer",
        "lemma": "aimer",
        "partOfSpeech": "verb",
        "meaningZh": "喜欢；爱",
        "noteZh": "aimer 表示喜欢或爱，可用于食物、活动或其他事物。常见的现在时形式有 j’aime、elle aime。"
      },
      {
        "id": "expr-jhabite",
        "lemma": "j’habite",
        "partOfSpeech": "other",
        "meaningZh": "我住……",
        "noteZh": "habiter 的第一人称单数现在时，后接居住地点。"
      }
    ],
    "grammar": [
      {
        "id": "grammar-voici-person",
        "titleZh": "Voici：介绍眼前的人",
        "bodyZh": "Voici 后接名字或身份，本课 Voici mon ami Luc 用于把朋友介绍给另一位朋友，不需要再加 être。",
        "examples": [
          {
            "fr": "Voici mon ami Luc.",
            "zh": "这是我的朋友 Luc。"
          }
        ]
      },
      {
        "id": "grammar-mon-ami",
        "titleZh": "mon / ma：说我的……",
        "bodyZh": "物主限定词与后面的名词配合：本课男性朋友是 mon ami，房屋是 ma maison。阴性名词若以元音或哑音 h 开头，前面也用 mon，例如 mon amie。这些形式不由说话人的性别决定。",
        "examples": [
          {
            "fr": "Mon ami habite à Lyon.",
            "zh": "我的朋友住在里昂。"
          },
          {
            "fr": "Mon amie habite à Lyon.",
            "zh": "我的朋友（女性）住在里昂。"
          }
        ]
      }
    ]
  },
