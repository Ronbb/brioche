  "title": {
    "fr": "Vous pouvez répéter ?",
    "zh": "请对方再说一次"
  },
  "summaryZh": "没听懂时请求重复或放慢语速。",
  "estimatedMinutes": 12,
  "objectivesZh": [
    "表达没有听懂",
    "礼貌地请求重复",
    "请求对方说慢一点"
  ],
  "knowledge": {
    "vocabulary": [
      {
        "id": "word-pardon",
        "lemma": "pardon",
        "partOfSpeech": "interjection",
        "meaningZh": "对不起；请再说一次",
        "noteZh": "没有听清时可先用 Pardon 引起对方注意。"
      },
      {
        "id": "word-repeter",
        "lemma": "répéter",
        "partOfSpeech": "verb",
        "meaningZh": "重复",
        "noteZh": "Vous pouvez répéter ? 请求对方再说一遍。"
      },
      {
        "id": "expr-plus-lentement",
        "lemma": "plus lentement",
        "partOfSpeech": "phrase",
        "meaningZh": "慢一点",
        "noteZh": "在本课中请求对方放慢语速。"
      },
      {
        "id": "word-comprendre",
        "lemma": "comprendre",
        "partOfSpeech": "verb",
        "meaningZh": "理解；听懂",
        "noteZh": "Je comprends 是第一人称单数现在时；加 ne…pas 表示不理解。"
      },
      {
        "id": "word-oui",
        "lemma": "oui",
        "partOfSpeech": "adverb",
        "meaningZh": "是的",
        "noteZh": "用于肯定回答。"
      },
      {
        "id": "expr-sil-vous-plait",
        "lemma": "s’il vous plaît",
        "partOfSpeech": "phrase",
        "meaningZh": "请",
        "noteZh": "这里使用 vous，适用于不熟悉的人和服务场景。"
      }
    ],
    "grammar": [
      {
        "id": "grammar-negation-comprendre",
        "titleZh": "ne…pas：表示否定",
        "bodyZh": "Je ne comprends pas 表示“我没有听懂”。ne 和 pas 放在变位动词两侧；本课保留完整形式，日常口语可能省略 ne。",
        "examples": [
          {
            "fr": "Je ne comprends pas.",
            "zh": "我没有听懂。"
          }
        ]
      },
      {
        "id": "grammar-pouvoir-repeat",
        "titleZh": "Vous pouvez + 动词原形",
        "bodyZh": "pouvez 是 pouvoir 与 vous 搭配的现在时形式。Vous pouvez répéter ? 在本课中用问句请求重复，répéter 保留原形。",
        "examples": [
          {
            "fr": "Vous pouvez répéter, s’il vous plaît ?",
            "zh": "请您再说一遍，好吗？"
          }
        ]
      }
    ]
  },
