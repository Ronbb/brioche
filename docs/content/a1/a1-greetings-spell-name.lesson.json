            },
            {
              "id": "segment-1-3",
              "text": " ?"
            }
          ],
          "translationZh": "您的名字是什么？"
        },
        {
          "id": "entry-2",
          "speakerId": "speaker-2",
          "segments": [
            {
              "id": "segment-2-1",
              "text": "Mon",
              "grammarId": "grammar-mon-name"
            },
            {
              "id": "segment-2-2",
              "text": " "
            },
            {
              "id": "segment-2-3",
              "text": "prénom",
              "vocabularyId": "word-prenom"
            },
            {
              "id": "segment-2-4",
              "text": " est Léa."
            }
          ],
          "translationZh": "我的名字是 Léa。"
        },
        {
          "id": "entry-3",
          "speakerId": "speaker-1",
          "segments": [
            {
              "id": "segment-3-1",
              "text": "Pouvez-vous",
              "grammarId": "grammar-pouvez-vous-spell"
            },
            {
              "id": "segment-3-2",
              "text": " "
            },
            {
              "id": "segment-3-3",
              "text": "épeler",
              "vocabularyId": "word-epeler"
            },
            {
              "id": "segment-3-4",
              "text": " votre "
            },
            {
              "id": "segment-3-5",
              "text": "prénom",
              "vocabularyId": "word-prenom"
            },
            {
              "id": "segment-3-6",
              "text": " ?"
            }
          ],
          "translationZh": "您可以拼写一下您的名字吗？"
        },
        {
          "id": "entry-4",
          "speakerId": "speaker-2",
          "segments": [
            {
              "id": "segment-4-1",
              "text": "L, É, A."
            }
          ],
          "translationZh": "L、带尖音符的 E、A。"
        },
        {
          "id": "entry-5",
          "speakerId": "speaker-1",
          "segments": [
            {
              "id": "segment-5-1",
              "text": "Il y a "
            },
            {
              "id": "segment-5-2",
              "text": "trois",
              "vocabularyId": "word-trois"
            },
            {
              "id": "segment-5-3",
              "text": " "
            },
            {
              "id": "segment-5-4",
              "text": "lettres",
              "vocabularyId": "word-lettre"
            },
            {
              "id": "segment-5-5",
              "text": " ?"
            }
          ],
          "translationZh": "有三个字母吗？"
        },
        {
          "id": "entry-6",
          "speakerId": "speaker-2",
          "segments": [
            {
              "id": "segment-6-1",
              "text": "Oui. Et votre "
            },
            {
              "id": "segment-6-2",
              "text": "nom",
              "vocabularyId": "word-nom"
            },
            {
              "id": "segment-6-3",
              "text": " ?"
            }
          ],
          "translationZh": "是的。您的姓呢？"
        },
        {
          "id": "entry-7",
          "speakerId": "speaker-1",
          "segments": [
            {
              "id": "segment-7-1",
              "text": "Mon",
              "grammarId": "grammar-mon-name"
            },
            {
              "id": "segment-7-2",
              "text": " "
            },
            {
              "id": "segment-7-3",
              "text": "nom",
              "vocabularyId": "word-nom"
            },
            {
              "id": "segment-7-4",
              "text": " est Martin."
            }
          ],
          "translationZh": "我姓 Martin。"
        },
        {
          "id": "entry-8",
          "speakerId": "speaker-2",
          "segments": [
            {
              "id": "segment-8-1",
              "text": "Merci",
              "vocabularyId": "word-merci"
            },
            {
              "id": "segment-8-2",
              "text": "."
            }
          ],
          "translationZh": "谢谢。"
        }
      ]
    },
