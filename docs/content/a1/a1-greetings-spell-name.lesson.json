{
  "schemaVersion": "1.0",
  "id": "a1-greetings-spell-name",
  "revision": 1,
  "levelId": "a1",
  "unitId": "a1-first-conversations",
  "title": {
    "fr": "Pouvez-vous épeler votre prénom ?",
    "zh": "拼写自己的名字"
  },
  "summaryZh": "区分名字和姓氏，听懂逐字母拼写的请求。",
  "estimatedMinutes": 12,
  "objectivesZh": [
    "区分 prénom 与 nom",
    "理解拼写名字的请求",
    "说明名字中的字母"
  ],
  "knowledge": {
    "vocabulary": [
      {
        "id": "word-prenom",
        "lemma": "prénom",
        "partOfSpeech": "noun",
        "meaningZh": "名字（区别于姓氏）",
        "noteZh": "Mon prénom 是“我的名字”。",
        "gender": "masculine"
      },
      {
        "id": "word-nom",
        "lemma": "nom",
        "partOfSpeech": "noun",
        "meaningZh": "姓；名称",
        "noteZh": "这里与 prénom 对照，指姓氏。",
        "gender": "masculine"
      },
      {
        "id": "word-epeler",
        "lemma": "épeler",
        "partOfSpeech": "verb",
        "meaningZh": "逐字母拼写",
        "noteZh": "按字母顺序说出名字；É 的重音符号也需要说明。"
      },
      {
        "id": "word-lettre",
        "lemma": "lettre",
        "partOfSpeech": "noun",
        "meaningZh": "字母",
        "noteZh": "本课指名字中的字母，复数为 lettres。",
        "gender": "feminine"
      },
      {
        "id": "word-trois",
        "lemma": "trois",
        "partOfSpeech": "numeral",
        "meaningZh": "三",
        "noteZh": "本课数名字中的字母。"
      },
      {
        "id": "word-merci",
        "lemma": "merci",
        "partOfSpeech": "interjection",
        "meaningZh": "谢谢",
        "noteZh": "用于表达感谢。"
      }
    ],
    "grammar": [
      {
        "id": "grammar-mon-name",
        "titleZh": "mon：我的名字或姓氏",
        "bodyZh": "prénom 和 nom 都是阳性名词，因此本例用 mon。mon/ma/mes 与后面的名词配合，不由说话者的性别决定。",
        "examples": [
          {
            "fr": "Mon prénom est Léa.",
            "zh": "我的名字是 Léa。"
          }
        ]
      },
      {
        "id": "grammar-pouvez-vous-spell",
        "titleZh": "Pouvez-vous…?：提出请求",
        "bodyZh": "pouvez-vous 是 vous pouvez 的倒装问句，连字符连接动词和主语。后面的 épeler 保留动词原形。",
        "examples": [
          {
            "fr": "Pouvez-vous épeler votre prénom ?",
            "zh": "您可以拼写一下您的名字吗？"
          }
        ]
      }
    ]
  },
  "blocks": [
    {
