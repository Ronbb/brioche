{
  "schemaVersion": "1.0",
  "id": "a1-food-shopping-list",
  "revision": 1,
  "levelId": "a1",
  "unitId": "a1-food-shopping",
  "title": {
    "fr": "Une liste pour le déjeuner",
    "zh": "读懂一张购物清单"
  },
  "summaryZh": "从购物短文中辨认食材、数量表达和个人喜好。",
  "estimatedMinutes": 12,
  "objectivesZh": [
    "读懂购物清单中的食材",
    "区分 du riz 和 des tomates",
    "用 aimer 说食物喜好"
  ],
  "knowledge": {
    "vocabulary": [
      {
        "id": "word-riz",
        "lemma": "riz",
        "partOfSpeech": "noun",
        "meaningZh": "米；米饭",
        "noteZh": "本课 du riz 指购买一些米，数量未具体说明。",
        "gender": "masculine"
      },
      {
        "id": "word-tomate",
        "lemma": "tomate",
        "partOfSpeech": "noun",
        "meaningZh": "西红柿",
        "noteZh": "une tomate；复数 tomates。",
        "gender": "feminine"
      },
      {
        "id": "word-eau",
        "lemma": "eau",
        "partOfSpeech": "noun",
        "meaningZh": "水",
        "noteZh": "l’eau；une bouteille d’eau 表示一瓶水。",
        "gender": "feminine"
      },
      {
        "id": "word-bouteille",
        "lemma": "bouteille",
        "partOfSpeech": "noun",
        "meaningZh": "瓶子",
        "noteZh": "une bouteille d’eau 表示一瓶水。",
        "gender": "feminine"
      },
      {
        "id": "word-fromage",
        "lemma": "fromage",
        "partOfSpeech": "noun",
        "meaningZh": "奶酪",
        "noteZh": "le fromage 可泛指奶酪；sans fromage 表示不加奶酪。",
        "gender": "masculine"
      },
      {
        "id": "word-liste",
        "lemma": "liste",
        "partOfSpeech": "noun",
        "meaningZh": "清单",
        "noteZh": "liste 的单数形式；搭配冠词学习。",
        "gender": "feminine"
      },
      {
        "id": "word-supermarche",
        "lemma": "supermarché",
        "partOfSpeech": "noun",
        "meaningZh": "超市",
        "noteZh": "supermarché 的单数形式；搭配冠词学习。",
        "gender": "masculine"
      },
      {
        "id": "word-aimer",
        "lemma": "aimer",
        "partOfSpeech": "verb",
        "meaningZh": "喜欢；爱",
        "noteZh": "aimer 表示喜欢或爱，可用于食物、活动或其他事物。常见的现在时形式有 j’aime、elle aime。"
      }
    ],
    "grammar": [
      {
        "id": "grammar-food-partitive",
        "titleZh": "du riz / des tomates：不指定精确数量",
        "bodyZh": "du riz 中 du 是部分冠词，表示一些米，不指定精确数量；des tomates 中 des 是复数不定冠词，表示若干西红柿。表达明确数量时用 un kilo de… 或 une bouteille de…。",
        "examples": [
          {
            "fr": "Elle achète du riz et des tomates.",
            "zh": "她买一些米和西红柿。"
          }
        ]
      },
      {
        "id": "grammar-aimer-food",
        "titleZh": "aimer + 定冠词：表达食物喜好",
        "bodyZh": "泛指喜欢某种食物时，本课使用定冠词：J’aime les légumes、elle aime les tomates。je 在元音前省音为 j’，写 j’aime；否定时写 je n’aime pas，保留后面的定冠词。",
        "examples": [
          {
            "fr": "J’aime les légumes.",
            "zh": "我喜欢蔬菜。"
          }
        ]
      }
    ]
  },
  "blocks": [
    {
      "id": "scene-main",
