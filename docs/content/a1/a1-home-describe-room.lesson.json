  "unitId": "a1-home-routine",
  "title": {
    "fr": "Dans mon appartement",
    "zh": "描述我的房间"
  },
  "summaryZh": "向朋友介绍公寓里的房间和书桌位置。",
  "estimatedMinutes": 12,
  "objectivesZh": [
    "说出房间名称",
    "用 il y a 描述某处有什么",
    "用 j’ai 说自己有什么"
  ],
  "knowledge": {
    "vocabulary": [
      {
        "id": "word-appartement",
        "lemma": "appartement",
        "partOfSpeech": "noun",
        "meaningZh": "公寓",
        "noteZh": "appartement 的单数形式；搭配冠词学习。",
        "gender": "masculine"
      },
      {
        "id": "word-chambre",
        "lemma": "chambre",
        "partOfSpeech": "noun",
        "meaningZh": "卧室；房间",
        "noteZh": "chambre 的单数形式；搭配冠词学习。",
        "gender": "feminine"
      },
      {
        "id": "word-cuisine",
        "lemma": "cuisine",
        "partOfSpeech": "noun",
        "meaningZh": "厨房",
        "noteZh": "cuisine 的单数形式；搭配冠词学习。",
        "gender": "feminine"
      },
      {
        "id": "word-bureau",
        "lemma": "bureau",
        "partOfSpeech": "noun",
        "meaningZh": "书桌；办公室",
        "noteZh": "un bureau 可指书桌；au bureau 在本单元的工作场景中表示在办公室。",
        "gender": "masculine"
      },
      {
        "id": "word-salon",
        "lemma": "salon",
        "partOfSpeech": "noun",
        "meaningZh": "客厅",
        "noteZh": "salon 的单数形式；搭配冠词学习。",
        "gender": "masculine"
      },
      {
        "id": "expr-il-y-a",
        "lemma": "il y a",
        "partOfSpeech": "phrase",
        "meaningZh": "有……",
        "noteZh": "用于说明某处存在什么。"
      },
      {
        "id": "word-avoir",
        "lemma": "avoir",
        "partOfSpeech": "verb",
        "meaningZh": "有",
        "noteZh": "本课先学习 j’ai 和 tu as，分别表示“我有”“你有”。"
      },
      {
        "id": "expr-a-cote-de",
        "lemma": "à côté de",
        "partOfSpeech": "phrase",
        "meaningZh": "在……旁边",
        "noteZh": "说明相邻的位置，后接地点。"
      }
    ],
    "grammar": [
      {
        "id": "grammar-avoir-possession",
        "titleZh": "avoir：说自己有什么",
        "bodyZh": "avoir 的现在时随主语变化：je + ai 省音写作 j’ai，tu 搭配 as。J’ai un bureau 表示我有一张书桌。",
        "examples": [
          {
            "fr": "J’ai un bureau.",
            "zh": "我有一张书桌。"
          }
        ]
      },
      {
        "id": "grammar-il-y-a-existence",
        "titleZh": "Il y a：介绍房间里的东西",
        "bodyZh": "Il y a 后接名词，说明某处有某物。本课用 une cuisine、une chambre；提问可保留语序，用问号和上扬语调。",
        "examples": [
          {
            "fr": "Il y a une cuisine.",
            "zh": "有一个厨房。"
          }
        ]
      }
    ]
  },
