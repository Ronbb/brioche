  "id": "a1-bakery-choose-quantity",
  "revision": 1,
  "levelId": "a1",
  "unitId": "a1-breakfast-bakery",
  "title": {
    "fr": "Deux croissants et un pain",
    "zh": "说清想要几个"
  },
  "summaryZh": "用一和二说明面包数量，确认订单。",
  "estimatedMinutes": 12,
  "objectivesZh": [
    "说出想买的商品",
    "用数量说明几个",
    "确认订单结束"
  ],
  "knowledge": {
    "vocabulary": [
      {
        "id": "word-croissant",
        "lemma": "croissant",
        "partOfSpeech": "noun",
        "meaningZh": "可颂",
        "noteZh": "复数 croissants；本课用 deux croissants 点两个。",
        "gender": "masculine"
      },
      {
        "id": "word-pain",
        "lemma": "pain",
        "partOfSpeech": "noun",
        "meaningZh": "面包",
        "noteZh": "un pain 在本课指一个面包；具体品种需结合店内商品。",
        "gender": "masculine"
      },
      {
        "id": "word-deux",
        "lemma": "deux",
        "partOfSpeech": "numeral",
        "meaningZh": "二；两个",
        "noteZh": "接名词时表示数量二。"
      },
      {
        "id": "expr-je-voudrais",
        "lemma": "je voudrais",
        "partOfSpeech": "phrase",
        "meaningZh": "我想要……",
        "noteZh": "礼貌地提出请求。本课先作为常用语块学习。"
      },
      {
        "id": "expr-sil-vous-plait",
        "lemma": "s’il vous plaît",
        "partOfSpeech": "phrase",
        "meaningZh": "请",
        "noteZh": "这里使用 vous，适用于不熟悉的人和服务场景。"
      },
      {
        "id": "word-merci",
        "lemma": "merci",
        "partOfSpeech": "interjection",
        "meaningZh": "谢谢",
        "noteZh": "用于表达感谢。"
      }
    ],
    "grammar": [
      {
        "id": "grammar-bakery-quantity",
        "titleZh": "数字 + 名词：说明数量",
        "bodyZh": "deux croissants 表示两个可颂。数字在名词前，表示数量；一个面包在本例说 un pain。",
        "examples": [
          {
            "fr": "Deux croissants.",
            "zh": "两个可颂。"
          }
        ]
      },
      {
        "id": "grammar-croissant-plural",
        "titleZh": "croissants：书面复数",
        "bodyZh": "本例 croissant 的复数写作 croissants。词尾 s 通常不发音；不能仅靠这个词尾听出数量，需要结合 deux。",
        "examples": [
          {
            "fr": "Je voudrais deux croissants.",
            "zh": "我想要两个可颂。"
          }
        ]
      }
    ]
  },
