  "levelId": "a1",
  "unitId": "a1-first-conversations",
  "title": {
    "fr": "Bonjour, je m’appelle Camille",
    "zh": "第一次打招呼"
  },
  "summaryZh": "用问候和名字开启第一次交谈，再自然地道别。",
  "estimatedMinutes": 12,
  "objectivesZh": [
    "向初次见面的人问好",
    "介绍自己的名字",
    "结束交谈并道别"
  ],
  "knowledge": {
    "vocabulary": [
      {
        "id": "word-bonjour",
        "lemma": "bonjour",
        "partOfSpeech": "interjection",
        "meaningZh": "你好；您好",
        "noteZh": "白天问候。进入店内时可先用它向店员打招呼。"
      },
      {
        "id": "expr-je-mappelle",
        "lemma": "je m’appelle",
        "partOfSpeech": "phrase",
        "meaningZh": "我叫……",
        "noteZh": "介绍名字的常用语块，后面接名字。"
      },
      {
        "id": "expr-et-vous",
        "lemma": "et vous",
        "partOfSpeech": "phrase",
        "meaningZh": "您呢？",
        "noteZh": "把刚才的问题转问对方。本组对话中双方尚不熟悉。"
      },
      {
        "id": "word-enchantee",
        "lemma": "enchantée",
        "partOfSpeech": "interjection",
        "meaningZh": "很高兴认识您",
        "noteZh": "本课女性角色用 enchantée；男性说话者写 enchanté。口头发音相同。"
      },
      {
        "id": "expr-a-bientot",
        "lemma": "à bientôt",
        "partOfSpeech": "phrase",
        "meaningZh": "回头见；再见",
        "noteZh": "表达期待不久后再见，不是具体约定的日期。"
      },
      {
        "id": "expr-au-revoir",
        "lemma": "au revoir",
        "partOfSpeech": "phrase",
        "meaningZh": "再见",
        "noteZh": "结束交谈、离开时使用。"
      }
    ],
    "grammar": [
      {
        "id": "grammar-name-first-person",
        "titleZh": "Je m’appelle：介绍名字",
        "bodyZh": "m’appelle 是 s’appeler 的第一人称单数现在时；先把 Je m’appelle + 名字作为整体使用。",
        "examples": [
          {
            "fr": "Je m’appelle Camille.",
            "zh": "我叫 Camille。"
          }
        ]
      },
      {
        "id": "grammar-address-vous",
        "titleZh": "vous：本课的礼貌称呼",
        "bodyZh": "本课双方刚见面，使用 vous 称呼对方。它也可以表示复数“你们”；何时改用 tu 要结合关系与场合。",
        "examples": [
          {
            "fr": "Et vous ?",
            "zh": "您呢？"
          }
        ]
      }
    ]
  },
