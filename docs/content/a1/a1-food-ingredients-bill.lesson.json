      "turns": [
        {
          "id": "entry-1",
          "speakerId": "speaker-1",
          "segments": [
            {
              "id": "segment-1-1",
              "text": "Excusez-moi, "
            },
            {
              "id": "segment-1-2",
              "text": "il y a de la",
              "grammarId": "grammar-question-ingredients"
            },
            {
              "id": "segment-1-3",
              "text": " "
            },
            {
              "id": "segment-1-4",
              "text": "crème",
              "vocabularyId": "word-creme"
            },
            {
              "id": "segment-1-5",
              "text": " dans cette soupe ?"
            }
          ],
          "translationZh": "不好意思，这份汤里有奶油吗？"
        },
        {
          "id": "entry-2",
          "speakerId": "speaker-2",
          "segments": [
            {
              "id": "segment-2-1",
              "text": "Oui, il y a de la "
            },
            {
              "id": "segment-2-2",
              "text": "crème",
              "vocabularyId": "word-creme"
            },
            {
              "id": "segment-2-3",
              "text": "."
            }
          ],
          "translationZh": "有，里面有奶油。"
        },
        {
          "id": "entry-3",
          "speakerId": "speaker-1",
          "segments": [
            {
              "id": "segment-3-1",
              "text": "Alors, une salade "
            },
            {
              "id": "segment-3-2",
              "text": "sans",
              "vocabularyId": "word-sans",
              "grammarId": "grammar-sans-ingredient"
            },
            {
              "id": "segment-3-3",
              "text": " "
            },
            {
              "id": "segment-3-4",
              "text": "fromage",
              "vocabularyId": "word-fromage"
            },
            {
              "id": "segment-3-5",
              "text": ", s’il vous plaît."
            }
          ],
          "translationZh": "那请给我一份不加奶酪的沙拉。"
        },
        {
          "id": "entry-4",
          "speakerId": "speaker-2",
          "segments": [
            {
              "id": "segment-4-1",
              "text": "D’accord, je vous apporte la salade."
            }
          ],
          "translationZh": "好的，我给您端来沙拉。"
        },
        {
          "id": "entry-5",
          "speakerId": "speaker-1",
          "segments": [
            {
              "id": "segment-5-1",
              "text": "L’addition",
              "vocabularyId": "word-addition"
            },
            {
              "id": "segment-5-2",
              "text": ", s’il vous plaît."
            }
          ],
          "translationZh": "请给我账单。"
        },
        {
          "id": "entry-6",
          "speakerId": "speaker-2",
          "segments": [
            {
              "id": "segment-6-1",
              "text": "Voilà. "
            },
            {
              "id": "segment-6-2",
              "text": "Douze",
              "vocabularyId": "word-douze"
            },
            {
              "id": "segment-6-3",
              "text": " "
            },
            {
              "id": "segment-6-4",
              "text": "euros",
              "vocabularyId": "word-euro"
            },
            {
              "id": "segment-6-5",
              "text": "."
            }
          ],
          "translationZh": "给您。十二欧元。"
        },
        {
          "id": "entry-7",
          "speakerId": "speaker-1",
          "segments": [
            {
              "id": "segment-7-1",
              "text": "Je peux "
            },
            {
              "id": "segment-7-2",
              "text": "payer",
              "vocabularyId": "word-payer"
            },
            {
              "id": "segment-7-3",
              "text": " "
            },
            {
              "id": "segment-7-4",
              "text": "par carte",
              "vocabularyId": "expr-par-carte"
            },
            {
              "id": "segment-7-5",
              "text": " ?"
            }
          ],
          "translationZh": "我可以用银行卡付款吗？"
        },
        {
          "id": "entry-8",
          "speakerId": "speaker-2",
          "segments": [
            {
              "id": "segment-8-1",
              "text": "Oui. Merci, bonne journée."
            }
          ],
          "translationZh": "可以。谢谢，祝您今天愉快。"
        }
      ]
    },
    {
      "id": "explanation-main",
      "type": "explanation",
      "titleZh": "这句话如何使用",
      "bodyZh": "Il y a… ? 可以询问成分；sans fromage 是不加奶酪的请求，仍需对方确认。对话压缩了点餐与用餐后的两个时刻，第五句起是结账。L’addition 指餐馆账单；Je peux payer par carte ? 复用前面学过的付款请求。",
      "targets": [
        {
          "blockId": "dialogue-main",
          "entryId": "entry-1",
          "segmentId": "segment-1-2"
        },
        {
          "blockId": "dialogue-main",
          "entryId": "entry-3",
          "segmentId": "segment-3-2"
        }
      ]
    },
    {
      "id": "culture-context",
      "type": "culture",
      "titleZh": "场景中的细节",
      "bodyZh": "成分、金额及可提供的选择都是虚构服务情境；实际菜品和可调整内容需要向当时的服务人员确认。",
      "scopeZh": "本课虚构场景，不概括所有法语地区或个人的行为。"
    },
