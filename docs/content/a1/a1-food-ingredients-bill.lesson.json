{
  "schemaVersion": "1.0",
  "id": "a1-food-ingredients-bill",
  "revision": 1,
  "levelId": "a1",
  "unitId": "a1-food-shopping",
  "title": {
    "fr": "Sans fromage, puis l’addition",
    "zh": "询问成分与结账"
  },
  "summaryZh": "询问汤里是否有奶油，提出不加奶酪的选择，并在用餐后结账。",
  "estimatedMinutes": 12,
  "objectivesZh": [
    "询问菜品成分",
    "提出不加一种成分的请求",
    "索要账单并询问付款方式"
  ],
  "knowledge": {
    "vocabulary": [
      {
        "id": "word-creme",
        "lemma": "crème",
        "partOfSpeech": "noun",
        "meaningZh": "奶油",
        "noteZh": "de la crème 表示一些奶油；本课用于询问汤的成分。",
        "gender": "feminine"
      },
      {
        "id": "word-fromage",
        "lemma": "fromage",
        "partOfSpeech": "noun",
        "meaningZh": "奶酪",
        "noteZh": "le fromage 可泛指奶酪；sans fromage 表示不加奶酪。",
        "gender": "masculine"
      },
      {
        "id": "word-addition",
        "lemma": "addition",
        "partOfSpeech": "noun",
        "meaningZh": "账单",
        "noteZh": "餐馆场景中 l’addition 指用餐账单。",
        "gender": "feminine"
      },
      {
        "id": "word-douze",
        "lemma": "douze",
        "partOfSpeech": "numeral",
        "meaningZh": "十二",
        "noteZh": "douze euros 表示十二欧元；金额为虚构教学设定。"
      },
      {
        "id": "word-payer",
        "lemma": "payer",
        "partOfSpeech": "verb",
        "meaningZh": "付款",
        "noteZh": "Je peux payer…? 询问能否用某种方式付款。"
      },
      {
        "id": "expr-par-carte",
        "lemma": "par carte",
        "partOfSpeech": "phrase",
        "meaningZh": "用银行卡",
        "noteZh": "payer par carte 表示刷卡或用银行卡支付。"
      },
      {
        "id": "word-sans",
        "lemma": "sans",
        "partOfSpeech": "preposition",
        "meaningZh": "没有；不加",
        "noteZh": "sans lait 表示不加牛奶，sans 后本例不加冠词。"
      },
      {
        "id": "word-euro",
        "lemma": "euro",
        "partOfSpeech": "noun",
        "meaningZh": "欧元",
        "noteZh": "复数 euros；课程价格均为虚构教学设定。",
        "gender": "masculine"
      }
    ],
    "grammar": [
      {
        "id": "grammar-question-ingredients",
        "titleZh": "Il y a… ?：询问菜品成分",
        "bodyZh": "保留 il y a 的语序并用问号提问，询问菜里有什么：Il y a de la crème dans cette soupe ? 这里 cette soupe 表示眼前或菜单中这份汤。",
        "examples": [
          {
            "fr": "Il y a de la crème dans cette soupe ?",
            "zh": "这份汤里有奶油吗？"
          }
        ]
      },
      {
        "id": "grammar-sans-ingredient",
        "titleZh": "sans + 成分：提出简单选择",
        "bodyZh": "sans fromage 表示不加奶酪，本例 fromage 前不用冠词。这里提出一个点餐请求，仍需要服务人员确认是否能提供这种选择。",
        "examples": [
          {
            "fr": "Une salade sans fromage, s’il vous plaît.",
            "zh": "请给我一份不加奶酪的沙拉。"
          }
        ]
      }
    ]
  },
  "blocks": [
    {
      "id": "scene-main",
      "type": "scene",
      "placeZh": "先确认成分，再在用餐后结账",
      "situationZh": "询问汤里是否有奶油，提出不加奶酪的选择，并在用餐后结账。",
      "illustrationId": "art-cafe-lunch"
